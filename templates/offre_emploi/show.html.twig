{% extends 'base.html.twig' %}

{% block title %}OffreEmploi{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Détails OffreEmploi</h1>
        <div class="top-actions">
            <a href="{{ path('app_offre_emploi_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_offre_emploi_edit', {'id_offre': offre_emploi.id_offre}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Éditer
            </a>
            {{ include('offre_emploi/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="detail-card" style="margin: 0 auto;">
        <div class="detail-row">
            <div class="detail-label">ID Offre</div>
            <div class="detail-value text-muted">#{{ offre_emploi.id_offre }}</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Titre du poste</div>
            <div class="detail-value" style="font-size: 1.2rem; font-weight: 700; color: var(--neon-blue);">{{ offre_emploi.titre_poste }}</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Département</div>
            <div class="detail-value">{{ offre_emploi.departement }}</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Statut</div>
            <div class="detail-value">
                <span class="badge {% if offre_emploi.statut_offre == 'Publiée' %}theme-blue{% else %}theme-purple{% endif %}">
                    {{ offre_emploi.statut_offre }}
                </span>
            </div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Salaire Proposé</div>
            <div class="detail-value">{{ offre_emploi.salaire_propose|number_format(0, '.', ' ') }} {{ offre_emploi.devise }}</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Date de Création</div>
            <div class="detail-value"><i class="fas fa-calendar-alt text-muted"></i> {{ offre_emploi.date_creation ? offre_emploi.date_creation|date('d/m/Y') : '' }}</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Description Rapide</div>
            <div class="detail-value" style="white-space: pre-wrap; font-size: 0.9rem; margin-top: 0.5rem; line-height: 1.5;">{{ offre_emploi.description }}</div>
        </div>
    </div>
</div>
{% endblock %}
