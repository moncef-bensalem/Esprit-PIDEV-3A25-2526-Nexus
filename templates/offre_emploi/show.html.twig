{% extends 'base.html.twig' %}

{% block title %}OffreEmploi{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Détails OffreEmploi</h1>
        <div class="top-actions">
            <a href="{{ path('app_offre_emploi_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_offre_emploi_edit', {'id_offre': offre_emploi.id_offre}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Éditer
            </a>
            {{ include('offre_emploi/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="stat-card" style="text-align: left; max-width: 600px; margin: 0 auto;">
        <table class="table" style="width: 100%; border-collapse: collapse;">
            <tbody>
            <tr>
                <th>Id offre</th>
                <td>{{ offre_emploi.id_offre }}</td>
            </tr>
            <tr>
                <th>Titre poste</th>
                <td>{{ offre_emploi.titre_poste }}</td>
            </tr>
            <tr>
                <th>Departement</th>
                <td>{{ offre_emploi.departement }}</td>
            </tr>
            <tr>
                <th>Statut offre</th>
                <td>{{ offre_emploi.statut_offre }}</td>
            </tr>
            <tr>
                <th>Salaire propose</th>
                <td>{{ offre_emploi.salaire_propose }}</td>
            </tr>
            <tr>
                <th>Date creation</th>
                <td>{{ offre_emploi.date_creation ? offre_emploi.date_creation|date('Y-m-d') : '' }}</td>
            </tr>

            </tbody>
        </table>
    </div>
</div>
{% endblock %}
