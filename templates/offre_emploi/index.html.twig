{% extends 'base.html.twig' %}
{% block page_title %}Gestion des Offres d'emploi{% endblock %}

{% block content %}
<style>
    /* ── Base ── */
    .btn-create { background: linear-gradient(135deg, #20b2aa, #0288d1); color: #fff; border: none; padding: 11px 22px; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; transition: all 0.2s; box-shadow: 0 4px 16px rgba(32,178,170,0.25); }
    .btn-create:hover { transform: translateY(-2px); color:#fff; box-shadow: 0 8px 24px rgba(32,178,170,0.35); }

    /* ── KPI Row ── */
    .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 22px; }
    .kpi-card { background: rgba(13,25,42,0.7); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 18px 20px; display: flex; align-items: center; gap: 16px; transition: border-color 0.2s, transform 0.2s; }
    .kpi-card:hover { border-color: rgba(32,178,170,0.25); transform: translateY(-2px); }
    .kpi-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
    .kpi-label { font-size: 0.72rem; color: rgba(255,255,255,0.4); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
    .kpi-value { font-size: 1.8rem; font-weight: 800; color: #fff; line-height: 1; }
    .kpi-trend { font-size: 0.7rem; color: rgba(255,255,255,0.3); margin-top: 3px; }

    /* ── Dashboard Row ── */
    .dash-row { display: grid; grid-template-columns: 1.1fr 1fr; gap: 18px; margin-bottom: 24px; }
    .dash-panel { background: rgba(13,25,42,0.7); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 22px; }
    .panel-title { font-size: 0.75rem; font-weight: 700; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 18px; display: flex; align-items: center; gap: 6px; }

    /* Status bars */
    .status-row { display: flex; flex-direction: column; gap: 14px; }
    .status-item { display: flex; align-items: center; gap: 12px; }
    .status-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .status-name { font-size: 0.82rem; color: rgba(255,255,255,0.6); flex: 1; }
    .status-count { font-size: 0.85rem; font-weight: 700; color: #fff; min-width: 28px; text-align: right; }
    .status-track { flex: 2; height: 6px; border-radius: 10px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .status-fill { height: 100%; border-radius: 10px; transition: width 0.9s ease; }

    /* ── Filters ── */
    .filters-bar { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); padding: 14px 20px; border-radius: 14px; margin-bottom: 22px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .filter-label { font-size: 0.75rem; color: rgba(255,255,255,0.5); font-weight: 600; display: block; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.4px; }
    .filter-input, .filter-select { background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 9px 14px; border-radius: 9px; font-size: 0.83rem; outline: none; transition: border-color 0.2s; }
    .filter-input:focus, .filter-select:focus { border-color: rgba(32,178,170,0.5); }
    .filter-select option { background: #0d1a2a; }
    .results-count { margin-left: auto; font-size: 0.78rem; color: rgba(255,255,255,0.3); }

    /* ── Grid & Cards ── */
    .mc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 16px; }
    .mc-card { background: rgba(13,25,42,0.65); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; padding: 18px 20px; transition: all 0.22s; position: relative; overflow: hidden; display: flex; flex-direction: column; }
    .mc-card::after  { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; border-radius: 14px 14px 0 0; }
    .mc-card.status-publiee::after  { background: linear-gradient(90deg, #20b2aa, #0288d1); }
    .mc-card.status-brouillon::after { background: #555; }
    .mc-card.status-cloturee::after { background: linear-gradient(90deg, #e53935, #c62828); }
    .mc-card:hover { transform: translateY(-4px); box-shadow: 0 14px 40px rgba(0,0,0,0.45); border-color: rgba(32,178,170,0.2); }

    .mc-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
    .mc-card-title { font-size: 1rem; font-weight: 700; color: #fff; line-height: 1.3; margin-bottom: 3px; }
    .mc-card-dept { font-size: 0.75rem; color: rgba(32,178,170,0.8); display: flex; align-items: center; gap: 4px; }
    .mc-status-badge { font-size: 0.65rem; font-weight: 700; padding: 3px 9px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.8px; white-space: nowrap; }
    .status-publiee  .mc-status-badge { background: rgba(32,178,170,0.15); color: #20b2aa; border: 1px solid rgba(32,178,170,0.25); }
    .status-brouillon .mc-status-badge { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.55); border: 1px solid rgba(255,255,255,0.12); }
    .status-cloturee  .mc-status-badge { background: rgba(229,57,53,0.12); color: #ef5350; border: 1px solid rgba(229,57,53,0.2); }

    .mc-divider { height: 1px; background: rgba(255,255,255,0.05); margin: 12px 0; }
    .mc-card-meta { display: flex; flex-direction: column; gap: 7px; font-size: 0.78rem; color: rgba(255,255,255,0.45); flex: 1; }
    .mc-card-meta div { display: flex; align-items: center; gap: 8px; }
    .mc-card-meta i { width: 13px; color: rgba(32,178,170,0.6); font-size: 0.7rem; }
    .mc-card-meta strong { color: rgba(255,255,255,0.7); }

    .mc-card-actions { display: flex; justify-content: flex-end; gap: 6px; margin-top: 14px; }
    .mc-btn-icon { width: 30px; height: 30px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.05); transition: all 0.2s; text-decoration: none; border: none; cursor: pointer; font-size: 0.8rem; }
    .mc-btn-icon:hover { background: rgba(32,178,170,0.18); color: #fff; }

    /* ── Pagination ── */
    .pagination { display: flex; justify-content: center; align-items: center; gap: 7px; margin-top: 10px; padding: 0; list-style: none; }
    .pagination span, .pagination a { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 9px; background: rgba(13,25,42,.6); border: 1px solid rgba(255,255,255,.05); color: rgba(255,255,255,.6); font-size: .82rem; font-weight: 600; text-decoration: none; transition: all .2s; }
    .pagination a:hover { background: rgba(32,178,170,.1); border-color: rgba(32,178,170,.3); color: #20b2aa; }
    .pagination li.active span { background: linear-gradient(135deg, #20b2aa, #0288d1); color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(32,178,170,.2); }
    .pagination li.disabled span { opacity: 0.4; cursor: not-allowed; pointer-events: none; }
</style>

{# ── Header ── #}
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:28px;">
    <div>
        <div style="font-size:1.35rem; font-weight:800; color:#fff; display:flex; align-items:center; gap:10px;">
            <i class="fas fa-briefcase" style="color:#20b2aa;"></i> Gestion des Offres d'Emploi
        </div>
        <div style="font-size:0.82rem; color:rgba(255,255,255,0.35); margin-top:4px;">Publiez, gérez et analysez vos opportunités d'embauche.</div>
    </div>
    <a href="{{ path('app_offre_emploi_new') }}" class="btn-create">
        <i class="fas fa-plus"></i> Nouvelle Offre
    </a>
</div>

{# ── KPI Cards ── #}
<div class="kpi-row">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(32,178,170,0.12); color:#20b2aa;"><i class="fas fa-layer-group"></i></div>
        <div>
            <div class="kpi-label">Total offres</div>
            <div class="kpi-value">{{ statTotal }}</div>
            <div class="kpi-trend">Toutes catégories</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(76,175,80,0.12); color:#4caf50;"><i class="fas fa-check-circle"></i></div>
        <div>
            <div class="kpi-label">Publiées</div>
            <div class="kpi-value" style="color:#4caf50;">{{ countPublished }}</div>
            <div class="kpi-trend">Visibles aux candidats</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(117,117,117,0.15); color:#9e9e9e;"><i class="fas fa-file-alt"></i></div>
        <div>
            <div class="kpi-label">Brouillons</div>
            <div class="kpi-value" style="color:#9e9e9e;">{{ countDraft }}</div>
            <div class="kpi-trend">En cours de rédaction</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(2,136,209,0.12); color:#0288d1;"><i class="fas fa-bolt"></i></div>
        <div>
            <div class="kpi-label">Récentes (7j)</div>
            <div class="kpi-value" style="color:#0288d1;">{{ countRecent }}</div>
            <div class="kpi-trend">Créées cette semaine</div>
        </div>
    </div>
</div>

{# ── Dashboard Panels ── #}
<div class="dash-row">
    {# Chart #}
    <div class="dash-panel">
        <div class="panel-title"><i class="fas fa-chart-donut" style="color:#20b2aa;"></i> Répartition par statut</div>
        {% if statTotal > 0 %}
            <div style="position:relative; height:200px; display:flex; align-items:center; justify-content:center;">
                <canvas id="statusPieChart"></canvas>
            </div>
        {% else %}
            <div style="color:rgba(255,255,255,0.25); text-align:center; padding:60px 0; font-size:0.85rem;">Aucune donnée</div>
        {% endif %}
    </div>

    {# Status breakdown bars #}
    <div class="dash-panel">
        <div class="panel-title"><i class="fas fa-signal" style="color:#20b2aa;"></i> Détail par statut</div>
        <div class="status-row" style="margin-top:8px;">
            <div class="status-item">
                <div class="status-dot" style="background:#4caf50;"></div>
                <div class="status-name">Publiées</div>
                <div class="status-count">{{ countPublished }}</div>
                <div class="status-track">
                    <div class="status-fill" style="width:{{ statTotal > 0 ? ((countPublished / statTotal) * 100)|round : 0 }}%; background:#4caf50;"></div>
                </div>
            </div>
            <div class="status-item">
                <div class="status-dot" style="background:#9e9e9e;"></div>
                <div class="status-name">Brouillons</div>
                <div class="status-count">{{ countDraft }}</div>
                <div class="status-track">
                    <div class="status-fill" style="width:{{ statTotal > 0 ? ((countDraft / statTotal) * 100)|round : 0 }}%; background:#757575;"></div>
                </div>
            </div>
            <div class="status-item">
                <div class="status-dot" style="background:#e53935;"></div>
                <div class="status-name">Clôturées</div>
                <div class="status-count">{{ countClosed }}</div>
                <div class="status-track">
                    <div class="status-fill" style="width:{{ statTotal > 0 ? ((countClosed / statTotal) * 100)|round : 0 }}%; background:#e53935;"></div>
                </div>
            </div>
        </div>

        <div style="margin-top:28px; padding-top:18px; border-top:1px solid rgba(255,255,255,0.06);">
            <div style="font-size:0.72rem; color:rgba(255,255,255,0.35); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:12px;">Taux de publication</div>
            <div style="display:flex; align-items:center; gap:14px;">
                <div style="flex:1; height:10px; border-radius:10px; background:rgba(255,255,255,0.06); overflow:hidden;">
                    <div style="height:100%; width:{{ statTotal > 0 ? ((countPublished / statTotal) * 100)|round : 0 }}%; background:linear-gradient(90deg,#20b2aa,#0288d1); border-radius:10px; transition:width 1s ease;"></div>
                </div>
                <span style="font-size:1rem; font-weight:800; color:#20b2aa; min-width:42px;">{{ statTotal > 0 ? ((countPublished / statTotal) * 100)|round : 0 }}%</span>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (document.getElementById('statusPieChart')) {
        const ctx = document.getElementById('statusPieChart').getContext('2d');
        const labels = {{ chartLabels|raw }};
        const data = {{ chartData|raw }};
        const colorMap = { 'PUBLIEE': '#4caf50', 'PUBLIÉE': '#4caf50', 'BROUILLON': '#757575', 'CLÔTURÉE': '#e53935', 'CLOTUREE': '#e53935' };
        const bg = labels.map(l => colorMap[l] || '#0288d1');
        new Chart(ctx, {
            type: 'doughnut',
            data: { labels, datasets: [{ data, backgroundColor: bg, borderWidth: 0, hoverOffset: 5 }] },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: {
                    legend: { position: 'bottom', labels: { color: 'rgba(255,255,255,0.55)', padding: 16, boxWidth: 10, font: { size: 11 } } }
                }
            }
        });
    }
});
</script>

{# ── Filters ── #}
<form method="GET" action="{{ path('app_offre_emploi_index') }}" class="filters-bar">
    <div>
        <label for="q" class="filter-label">Recherche</label>
        <input type="text" name="q" id="q" value="{{ app.request.query.get('q') }}" class="filter-input" placeholder="Titre, département..." style="width:220px;" />
    </div>
    <div>
        <label for="statut" class="filter-label">Statut</label>
        <select name="statut" id="statut" onchange="this.form.submit()" class="filter-select">
            <option value="">Tous les statuts</option>
            <option value="Brouillon" {% if app.request.query.get('statut') == 'Brouillon' %}selected{% endif %}>Brouillon</option>
            <option value="Publiée"   {% if app.request.query.get('statut') == 'Publiée'   %}selected{% endif %}>Publiée</option>
            <option value="Clôturée"  {% if app.request.query.get('statut') == 'Clôturée'  %}selected{% endif %}>Clôturée</option>
        </select>
    </div>
    {% if app.request.query.get('q') or app.request.query.get('statut') %}
        <a href="{{ path('app_offre_emploi_index') }}" style="color:rgba(255,255,255,0.4); font-size:0.82rem; text-decoration:none; display:inline-flex; align-items:center; gap:5px; margin-top:20px;">
            <i class="fas fa-times"></i> Réinitialiser
        </a>
    {% endif %}
    <div class="results-count">
        <i class="fas fa-list-ul" style="margin-right:4px;"></i> {{ offre_emplois.getNbResults() }} résultat{{ offre_emplois.getNbResults() != 1 ? 's' : '' }}
    </div>
</form>

{# ── Cards Grid ── #}
<div style="font-size:0.78rem; font-weight:700; color:rgba(255,255,255,0.35); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:14px;">
    <i class="fas fa-th-large" style="margin-right:6px; color:#20b2aa;"></i> Liste des offres
</div>

<div class="mc-grid">
{% for offre_emploi in offre_emplois %}
    <div class="mc-card {% if offre_emploi.statut_offre == 'Publiée' %}status-publiee{% elseif offre_emploi.statut_offre == 'Clôturée' %}status-cloturee{% else %}status-brouillon{% endif %}">
        <div class="mc-card-top">
            <div style="flex:1; min-width:0;">
                <div class="mc-card-title" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ offre_emploi.titre_poste }}</div>
                <div class="mc-card-dept"><i class="fas fa-building"></i> {{ offre_emploi.departement ?: 'Non précisé' }}</div>
            </div>
            <div class="mc-status-badge" style="margin-left:10px; flex-shrink:0;">{{ offre_emploi.statut_offre }}</div>
        </div>

        <div class="mc-divider"></div>

        <div class="mc-card-meta">
            <div>
                <i class="fas fa-money-bill-wave"></i>
                <span>{{ offre_emploi.salaire_propose ? '<strong>' ~ offre_emploi.salaire_propose|number_format(0, '.', ' ') ~ ' ' ~ offre_emploi.devise ~ '</strong>' : 'Salaire non spécifié' }}</span>
            </div>
            <div>
                <i class="fas fa-calendar-alt"></i>
                <span>Créée le <strong>{{ offre_emploi.date_creation ? offre_emploi.date_creation|date('d/m/Y') : '-' }}</strong></span>
            </div>
            <div>
                <i class="fas fa-users"></i>
                <span><strong>{{ offre_emploi.candidatures|length }}</strong> candidature{{ offre_emploi.candidatures|length != 1 ? 's' : '' }} reçue{{ offre_emploi.candidatures|length != 1 ? 's' : '' }}</span>
            </div>
        </div>

        <div class="mc-card-actions">
            <a href="{{ path('app_offre_emploi_show', {'id_offre': offre_emploi.id_offre}) }}" class="mc-btn-icon" title="Consulter"><i class="fas fa-eye"></i></a>
            <a href="{{ path('app_offre_emploi_edit', {'id_offre': offre_emploi.id_offre}) }}" class="mc-btn-icon" title="Modifier"><i class="fas fa-edit"></i></a>
            <form method="post" action="{{ path('app_offre_emploi_delete', {'id_offre': offre_emploi.id_offre}) }}" onsubmit="return confirm('Supprimer cette offre ?');" style="display:inline-block; margin:0;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ offre_emploi.id_offre) }}">
                <button class="mc-btn-icon" style="color:#ef5350;"><i class="fas fa-trash"></i></button>
            </form>
        </div>
    </div>
{% else %}
    <div style="grid-column:1/-1; text-align:center; padding:70px 20px; background:rgba(13,25,42,0.4); border:1px dashed rgba(255,255,255,0.08); border-radius:14px;">
        <i class="fas fa-box-open" style="font-size:2.8rem; color:rgba(255,255,255,0.08); margin-bottom:16px; display:block;"></i>
        <div style="color:rgba(255,255,255,0.4); font-size:0.95rem; margin-bottom:16px;">Aucune offre trouvée avec ces critères.</div>
        <a href="{{ path('app_offre_emploi_new') }}" class="btn-create">Créer votre première offre</a>
    </div>
{% endfor %}
</div>

<div style="display:flex; justify-content:center; margin-top:36px; margin-bottom:16px;">
    {{ pagerfanta(offre_emplois, 'twitter_bootstrap3', {'prev_message': '←', 'next_message': '→'}) }}
</div>

{% endblock %}
