{% extends 'base.html.twig' %}

{% block page_title %}Gestion des Offres d'emploi{% endblock %}

{% block content %}
<style>
    .mc-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
    .mc-header-title { font-size: 1.4rem; font-weight: 700; color: #fff; margin-bottom: 4px; display: flex; align-items: center; }
    .mc-header-sub { font-size: .85rem; color: rgba(255,255,255,.4); }
    .mc-header-actions { display: flex; gap: 12px; }
    .btn-create { background: linear-gradient(135deg, #20b2aa, #0288d1); color: #fff; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; transition: transform 0.2s; }
    .btn-create:hover { transform: translateY(-2px); color:#fff; }
    
    .filters-bar { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); padding: 16px 24px; border-radius: 16px; margin-bottom: 24px; display: flex; align-items: flex-end; gap: 16px; }
    .filter-label { font-size: 0.8rem; color: rgba(255,255,255,0.5); font-weight: 600; display: block; margin-bottom: 6px; }
    .filter-input, .filter-select { background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 10px 16px; border-radius: 10px; font-size: 0.85rem; outline: none; }
    
    .mc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
    .mc-card { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 20px; transition: transform 0.2s, box-shadow 0.2s; position: relative; overflow: hidden; }
    .mc-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.4); border-color: rgba(32,178,170,0.2); }
    .mc-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; }
    .mc-card.status-publiee::before { background: #20b2aa; }
    .mc-card.status-brouillon::before { background: #757575; }
    .mc-card.status-cloturee::before { background: #e53935; }
    
    .mc-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
    .mc-card-title { font-size: 1.1rem; font-weight: 700; color: #fff; line-height: 1.3; margin-bottom: 4px; }
    .mc-card-dept { font-size: 0.8rem; color: var(--cyan); }
    .mc-status-badge { font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px; }
    .status-publiee .mc-status-badge { background: rgba(32,178,170,0.15); color: #20b2aa; }
    .status-brouillon .mc-status-badge { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.6); }
    .status-cloturee .mc-status-badge { background: rgba(229,57,53,0.15); color: #e53935; }
    
    .mc-card-meta { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; font-size: 0.85rem; color: rgba(255,255,255,0.5); }
    .mc-card-meta div { display: flex; align-items: center; gap: 8px; }
    .mc-card-meta i { width: 14px; color: rgba(255,255,255,0.3); }
    
    .mc-card-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 16px; }
    .mc-btn-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.05); transition: all 0.2s; text-decoration: none; border: none; cursor: pointer; }
    .mc-btn-icon:hover { background: rgba(32,178,170,0.2); color: #fff; }

    /* ── Pagination Pagerfanta Admin ── */
    .pagination {
        display: flex; justify-content: center; align-items: center; gap: 8px;
        margin-top: 10px; padding: 0; list-style: none;
    }
    .pagination span, .pagination a {
        display: flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 10px;
        background: rgba(13,25,42,.6); border: 1px solid rgba(255,255,255,.05);
        color: rgba(255,255,255,.6); font-size: .85rem; font-weight: 600;
        text-decoration: none; transition: all .2s; cursor: pointer;
    }
    .pagination a:hover {
        background: rgba(32,178,170,.1); border-color: rgba(32,178,170,.3); color: #20b2aa;
    }
    .pagination li.active span {
        background: linear-gradient(135deg, #20b2aa, #0288d1);
        color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(32,178,170,.2);
    }
    .pagination li.disabled span {
        opacity: 0.4; cursor: not-allowed; pointer-events: none;
    }
</style>

<div class="mc-header">
    <div>
        <div class="mc-header-title"><i class="fas fa-briefcase" style="color:var(--cyan); margin-right: 12px;"></i> Gestions des Offres</div>
        <div class="mc-header-sub">Créez et gérez vos offres d'emploi pour attirer les meilleurs talents.</div>
    </div>
    <div class="mc-header-actions">
        <a href="{{ path('app_offre_emploi_new') }}" class="btn-create">
            <i class="fas fa-plus"></i> Nouvelle Offre
        </a>
    </div>
</div>

<!-- STATS DASHBOARD -->
<div class="row" style="margin-bottom: 30px; display: flex; gap: 20px;">
    <!-- Stat Cards -->
    <div style="flex: 1; display: flex; flex-direction: column; gap: 20px;">
        <div style="background: rgba(13,25,42,0.6); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; justify-content: center; height: 100%;">
            <div style="font-size: 0.9rem; color: rgba(255,255,255,0.5);">Total des Offres Enregistrées</div>
            <div style="font-size: 2.5rem; font-weight: 700; color: var(--cyan);">{{ statTotal }}</div>
        </div>
    </div>
    
    <!-- Chart -->
    <div style="flex: 2; background: rgba(13,25,42,0.6); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); min-height: 250px; display: flex; justify-content: center; align-items: center;">
        {% if statTotal > 0 %}
            <canvas id="statusPieChart" style="max-height: 220px;"></canvas>
        {% else %}
            <div style="color: rgba(255,255,255,0.3);">Pas assez de données pour le graphique</div>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (document.getElementById('statusPieChart')) {
        const ctx = document.getElementById('statusPieChart').getContext('2d');
        const labels = {{ chartLabels|raw }};
        const data = {{ chartData|raw }};
        
        const backgroundColors = labels.map(label => {
            if (label.includes('PUBLIEE') || label.includes('PUBLIÉE')) return '#20b2aa'; 
            if (label.includes('BROUILLON')) return '#757575';
            if (label.includes('CLOTUREE') || label.includes('CLÔTURÉE')) return '#e53935'; 
            return '#0288d1'; 
        });

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: backgroundColors,
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { color: 'rgba(255,255,255,0.7)' } }
                }
            }
        });
    }
});
</script>
<!-- END STATS DASHBOARD -->

    <form method="GET" action="{{ path('app_offre_emploi_index') }}" class="filters-bar">
        <div>
            <label for="q" class="filter-label">Recherche</label>
            <input type="text" name="q" id="q" value="{{ app.request.query.get('q') }}" class="filter-input" placeholder="Titre, département..." style="width: 250px;" />
        </div>
        <div>
            <label for="statut" class="filter-label">Statut</label>
            <select name="statut" id="statut" onchange="this.form.submit()" class="filter-select">
                <option value="">Tous les statuts</option>
                <option value="Brouillon" {% if app.request.query.get('statut') == 'Brouillon' %}selected{% endif %}>Brouillon</option>
                <option value="Publiée" {% if app.request.query.get('statut') == 'Publiée' %}selected{% endif %}>Publiée</option>
                <option value="Clôturée" {% if app.request.query.get('statut') == 'Clôturée' %}selected{% endif %}>Clôturée</option>
            </select>
        </div>

        {% if app.request.query.get('q') or app.request.query.get('statut') %}
            <a href="{{ path('app_offre_emploi_index') }}" style="color:rgba(255,255,255,0.4); font-size:0.85rem; text-decoration:none; margin-bottom: 12px; margin-left: 8px;">Réinitialiser</a>
        {% endif %}
    </form>

    <div class="mc-grid">
    {% for offre_emploi in offre_emplois %}
        <div class="mc-card {% if offre_emploi.statut_offre == 'Publiée' %}status-publiee{% elseif offre_emploi.statut_offre == 'Clôturée' %}status-cloturee{% else %}status-brouillon{% endif %}">
            <div class="mc-card-top">
                <div>
                    <div class="mc-card-title">{{ offre_emploi.titre_poste }}</div>
                    <div class="mc-card-dept"><i class="fas fa-building" style="font-size:0.8rem; margin-right:4px;"></i> {{ offre_emploi.departement }}</div>
                </div>
                <div class="mc-status-badge">{{ offre_emploi.statut_offre }}</div>
            </div>
            
            <div class="mc-card-meta">
                <div><i class="fas fa-money-bill-wave"></i> {{ offre_emploi.salaire_propose ? offre_emploi.salaire_propose|number_format(0, '.', ' ') ~ ' ' ~ offre_emploi.devise : 'Non spécifié' }}</div>
                <div><i class="fas fa-calendar-alt"></i> Ajoutée le {{ offre_emploi.date_creation ? offre_emploi.date_creation|date('d/m/Y') : '-' }}</div>
                <div><i class="fas fa-users"></i> {{ offre_emploi.candidatures|length }} Candidature(s) reçue(s)</div>
            </div>
            
            <div class="mc-card-actions">
                <a href="{{ path('app_offre_emploi_show', {'id_offre': offre_emploi.id_offre}) }}" class="mc-btn-icon" title="Consulter"><i class="fas fa-eye"></i></a>
                <a href="{{ path('app_offre_emploi_edit', {'id_offre': offre_emploi.id_offre}) }}" class="mc-btn-icon" title="Modifier"><i class="fas fa-edit"></i></a>
                <form method="post" action="{{ path('app_offre_emploi_delete', {'id_offre': offre_emploi.id_offre}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette offre ?');" style="display:inline-block; margin:0;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ offre_emploi.id_offre) }}">
                    <button class="mc-btn-icon" style="color: #ef5350;"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>
    {% else %}
        <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: rgba(13,25,42,0.4); border: 1px dashed rgba(255,255,255,0.1); border-radius: 16px;">
            <i class="fas fa-box-open" style="font-size: 3rem; color: rgba(255,255,255,0.1); margin-bottom: 16px;"></i>
            <h3 style="color: rgba(255,255,255,0.5); font-weight: 500;">Aucune offre trouvée.</h3>
            <a href="{{ path('app_offre_emploi_new') }}" class="btn-create" style="margin-top: 16px;">Créer votre première offre</a>
        </div>
    {% endfor %}
    </div>

    <!-- PAGINATION PAGERFANTA -->
    <div style="display: flex; justify-content: center; margin-top: 40px; margin-bottom: 20px;">
        {{ pagerfanta(offre_emplois, 'twitter_bootstrap3', {'prev_message': '← Précédent', 'next_message': 'Suivant →'}) }}
    </div>

{% endblock %}
