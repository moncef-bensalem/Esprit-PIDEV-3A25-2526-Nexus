{% extends 'base.html.twig' %}

{% block title %}Liste des OffreEmplois{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Liste des OffreEmplois</h1>
        <div class="top-actions">
            <a href="{{ path('app_offre_emploi_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Créer Nouveau
            </a>
        </div>
    </div>

    <form method="GET" action="{{ path('app_offre_emploi_index') }}" class="filters-bar" style="margin-bottom: 2rem; display: flex; align-items: flex-end; gap: 1rem;">
        <div>
            <label for="q">Recherche:</label>
            <input type="text" name="q" id="q" value="{{ app.request.query.get('q') }}" placeholder="Titre, département..." style="border-radius:2rem; width: 250px; padding: 0.5rem 1rem;" />
        </div>
        <div>
            <label for="statut">Statut:</label>
            <select name="statut" id="statut" onchange="this.form.submit()" style="border-radius:2rem; padding: 0.5rem 1rem;">
                <option value="">Tous les statuts</option>
                <option value="Brouillon" {% if app.request.query.get('statut') == 'Brouillon' %}selected{% endif %}>Brouillon</option>
                <option value="Publiée" {% if app.request.query.get('statut') == 'Publiée' %}selected{% endif %}>Publiée</option>
                <option value="Clôturée" {% if app.request.query.get('statut') == 'Clôturée' %}selected{% endif %}>Clôturée</option>
            </select>
        </div>

        {% if app.request.query.get('q') or app.request.query.get('statut') %}
            <a href="{{ path('app_offre_emploi_index') }}" class="btn" style="padding: 0.55rem 1rem; border-radius:2rem;">Réinitialiser</a>
        {% endif %}
    </form>

    <div class="talents-grid">
    {% for offre_emploi in offre_emplois %}
        <div class="talent-card">
            <div class="avatar-circle {% if offre_emploi.statut_offre == 'Publiée' %}theme-blue{% else %}theme-purple{% endif %}" style="width: 50px; height: 50px; font-size: 1rem; margin-bottom: 0.8rem;">
                <i class="fas fa-briefcase"></i>
            </div>
            
            <h3 class="talent-name">{{ offre_emploi.titre_poste }}</h3>
            <div class="talent-poste">{{ offre_emploi.departement }}</div>
            
            <div class="badge {% if offre_emploi.statut_offre == 'Publiée' %}theme-blue{% else %}theme-purple{% endif %}">
                {{ offre_emploi.statut_offre }}
            </div>
            
            <div class="talent-info">
                <div><i class="fas fa-money-bill-wave"></i> {{ offre_emploi.salaire_propose|number_format(0, '.', ' ') }} {{ offre_emploi.devise }}</div>
                <div><i class="fas fa-calendar-alt"></i> {{ offre_emploi.date_creation ? offre_emploi.date_creation|date('Y-m-d') : '' }}</div>
                <div><i class="fas fa-users"></i> {{ offre_emploi.candidatures|length }} Candidat(s)</div>
            </div>
            
            <div class="talent-actions" style="margin-top: 1.5rem;">
                <a href="{{ path('app_offre_emploi_show', {'id_offre': offre_emploi.id_offre}) }}" class="btn-icon" title="Voir"><i class="fas fa-eye"></i></a>
                <a href="{{ path('app_offre_emploi_edit', {'id_offre': offre_emploi.id_offre}) }}" class="btn-icon" title="Modifier"><i class="fas fa-edit"></i></a>
                {{ include('offre_emploi/_delete_form.html.twig') }}
            </div>
        </div>
    {% else %}
        <div class="stat-card" style="grid-column: 1 / -1; text-align: center;">
            <p style="font-size: 1.2rem; margin-bottom: 1rem;">Aucune offre trouvée.</p>
            <a href="{{ path('app_offre_emploi_new') }}" class="btn btn-primary">Créer votre première offre</a>
        </div>
    {% endfor %}
    </div>
</div>
{% endblock %}
