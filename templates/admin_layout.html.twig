<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Nexus Admin{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>
    <div class="app-wrapper">
        <aside class="sidebar">
            <div class="sidebar-logo">
                <i class="fas fa-cubes" style="color: var(--neon-blue);"></i> Nexus Admin
            </div>
            <ul class="sidebar-menu">
                <li><a href="{{ path('app_dashboard') }}" class="sidebar-link {% if app.request.get('_route') == 'app_dashboard' %}active{% endif %}"><i class="fas fa-home"></i> Vue d'ensemble</a></li>
                <li><a href="{{ path('app_kanban_index') }}" class="sidebar-link {% if app.request.get('_route') == 'app_kanban_index' %}active{% endif %}"><i class="fas fa-columns"></i> Pipeline</a></li>
                <li><a href="{{ path('app_offre_emploi_index') }}" class="sidebar-link {% if 'offre_emploi' in app.request.get('_route') %}active{% endif %}"><i class="fas fa-briefcase"></i> Offres d'emploi</a></li>
                <li><a href="{{ path('app_candidature_index') }}" class="sidebar-link {% if 'candidature' in app.request.get('_route') %}active{% endif %}"><i class="fas fa-inbox"></i> Candidatures</a></li>

                <li><a href="{{ path('app_departement_index') }}" class="sidebar-link {% if 'departement' in app.request.get('_route') %}active{% endif %}"><i class="fas fa-building"></i> Départements</a></li>
            </ul>
            <div style="margin-top:auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                <a href="{{ path('app_public_offres') }}" class="sidebar-link"><i class="fas fa-external-link-alt"></i> Portail Public</a>
            </div>
        </aside>

        <main class="main-content">
            <div class="top-navbar">
                <div class="breadcrumb">Admin / {% block breadcrumb %}{{ block('title') }}{% endblock %}</div>
                <div style="font-weight: 500;"><i class="fas fa-user-circle" style="font-size:1.2rem; margin-right:0.5rem; color: var(--text-muted);"></i> Recruteur</div>
            </div>
            
            {% block body %}{% endblock %}
        </main>
    </div>
</body>
</html>
