<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Nexus Carrières{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <style>
        :root {
            --nx-teal:   #20b2aa;
            --nx-blue:   #0288d1;
            --nx-purple: #7b1fa2;
            --nx-dark:   #060d17;
            --nx-card:   rgba(13,25,42,.75);
            --nx-border: rgba(32,178,170,.14);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--nx-dark);
            color: #e2e8f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Navbar ── */
        .pub-nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(6,13,23,.92);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--nx-border);
            padding: 0 3rem;
            height: 66px;
            display: flex; align-items: center; justify-content: space-between;
            gap: 24px;
        }
        .pub-nav-brand {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none; color: #fff;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700; font-size: 1.1rem; letter-spacing: .3px;
        }
        .pub-nav-brand img {
            width: 32px; height: 32px; border-radius: 8px; object-fit: cover;
        }
        .pub-nav-brand-sub { font-size: .68rem; color: var(--nx-teal); font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; display: block; line-height: 1; }

        .pub-nav-links { display: flex; align-items: center; gap: 4px; }
        .pub-nav-link {
            display: flex; align-items: center; gap: 6px;
            padding: 7px 16px; border-radius: 8px;
            font-size: .85rem; font-weight: 600; color: rgba(255,255,255,.55);
            text-decoration: none;
            transition: color .18s, background .18s;
        }
        .pub-nav-link:hover { color: #fff; background: rgba(255,255,255,.06); }
        .pub-nav-link.active { color: var(--nx-teal); background: rgba(32,178,170,.1); }
        .pub-nav-link i { font-size: .8rem; }

        .pub-nav-cta {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 20px; border-radius: 10px;
            background: linear-gradient(135deg, var(--nx-teal), var(--nx-blue));
            color: #fff; font-size: .83rem; font-weight: 700;
            text-decoration: none; letter-spacing: .3px;
            transition: opacity .18s, transform .18s;
            flex-shrink: 0;
        }
        .pub-nav-cta:hover { opacity: .88; transform: translateY(-1px); color: #fff; }

        /* ── Main ── */
        .pub-main {
            flex: 1;
            padding: 48px 3rem 64px;
            max-width: 1320px;
            width: 100%;
            margin: 0 auto;
        }

        /* ── Footer ── */
        .pub-footer {
            border-top: 1px solid var(--nx-border);
            text-align: center;
            padding: 24px;
            font-size: .78rem;
            color: rgba(255,255,255,.25);
        }

        /* ── Flash messages ── */
        .flash-error, .flash-success {
            padding: 12px 18px; border-radius: 10px; margin-bottom: 20px;
            font-size: .84rem; font-weight: 600; display: flex; align-items: center; gap: 8px;
        }
        .flash-error   { background: rgba(239,83,80,.12); border: 1px solid rgba(239,83,80,.3); color: #ef9a9a; }
        .flash-success { background: rgba(76,175,80,.12);  border: 1px solid rgba(76,175,80,.3);  color: #a5d6a7; }

        {% block extra_styles %}{% endblock %}
    </style>
</head>
<body>

<nav class="pub-nav">
    <a href="{{ path('app_public_offres') }}" class="pub-nav-brand">
        <img src="{{ asset('nexus.jpg') }}" alt="Nexus">
        <div>
            Nexus
            <span class="pub-nav-brand-sub">Carrières</span>
        </div>
    </a>

    <div class="pub-nav-links">
        <a href="{{ path('app_public_offres') }}" class="pub-nav-link {% if app.request.attributes.get('_route') == 'app_public_offres' %}active{% endif %}">
            <i class="fa fa-briefcase"></i> Offres d'emploi
        </a>
        <a href="{{ path('app_public_suivi') }}" class="pub-nav-link {% if app.request.attributes.get('_route') == 'app_public_suivi' %}active{% endif %}">
            <i class="fa fa-search"></i> Suivi candidature
        </a>
        {% if app.user %}
            <a href="{{ path('candidate_mes_candidatures') }}" class="pub-nav-link {% if app.request.attributes.get('_route') == 'candidate_mes_candidatures' %}active{% endif %}">
                <i class="fa fa-file-alt"></i> Mes candidatures
            </a>
        {% endif %}
    </div>

    {% if app.user %}
        <a href="{{ path('candidate_dashboard') }}" class="pub-nav-cta">
            <i class="fa fa-th-large"></i> Mon espace
        </a>
    {% else %}
        <a href="{{ path('app_login') }}" class="pub-nav-cta">
            <i class="fa fa-sign-in-alt"></i> Connexion
        </a>
    {% endif %}
</nav>

<main class="pub-main">
    {% for msg in app.flashes('error') %}
        <div class="flash-error"><i class="fa fa-exclamation-circle"></i> {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('success') %}
        <div class="flash-success"><i class="fa fa-check-circle"></i> {{ msg }}</div>
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="pub-footer">
    &copy; {{ 'now'|date('Y') }} Nexus Platform — Tous droits réservés.
</footer>

</body>
</html>
