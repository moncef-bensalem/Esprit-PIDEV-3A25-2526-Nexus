<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Nexus Carrières{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>
    <div class="public-wrapper">
        <header class="public-navbar">
            <div class="sidebar-logo" style="margin:0;">
                <i class="fas fa-cubes" style="color: var(--neon-blue);"></i> Nexus Carrières
            </div>
            <div class="public-nav-links">
                <a href="{{ path('app_public_offres') }}" class="{% if 'offres' in app.request.get('_route') %}active{% endif %}" style="font-weight:600;">Nos Offres</a>
                <a href="{{ path('app_public_suivi') }}" class="{% if 'suivi' in app.request.get('_route') %}active{% endif %}" style="font-weight:600;">Suivi Candidature</a>
                <a href="{{ path('app_dashboard') }}" class="btn" style="font-size: 0.85rem;"><i class="fas fa-lock"></i> RH Login</a>
            </div>
        </header>

        <main style="flex-grow:1;">
            {% block body %}{% endblock %}
        </main>
        
        <footer style="text-align: center; padding: 2rem; border-top: 1px solid var(--border-color); margin-top: 4rem; color: var(--text-muted); font-size: 0.9rem;">
            &copy; {{ 'now'|date('Y') }} Nexus CRM. Tous droits réservés.
        </footer>
    </div>
</body>
</html>
