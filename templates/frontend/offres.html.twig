{% extends 'public_layout.html.twig' %}
{% block title %}Portail de Recrutement{% endblock %}
{% block body %}
<div class="dashboard-container">
    <div class="stat-card" style="text-align: center; padding: 4rem 2rem; margin-bottom: 3rem; background: linear-gradient(135deg, rgba(0, 240, 255, 0.05) 0%, transparent 100%), var(--card-bg); border-top: 4px solid var(--neon-blue);">
        <h1 style="font-size: 2.5rem; color: var(--text-main); margin-bottom: 1rem;">Trouvez votre <span style="color: var(--neon-blue);">prochain défi</span></h1>
        <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 2rem auto;">Parcourez nos offres d'emploi, trouvez le poste qui vous correspond et rejoignez une équipe d'innovateurs.</p>
        <a href="{{ path('app_public_suivi') }}" class="btn btn-primary" style="padding: 0.8rem 1.5rem; font-size: 1rem; justify-content:center; display:inline-flex;"><i class="fas fa-search"></i> Suivre ma candidature existante</a>
    </div>
    {% for message in app.flashes('error') %}
        <div class="badge badge-danger" style="margin-bottom: 2rem; display: inline-block;">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="badge badge-success" style="margin-bottom: 2rem; display: inline-block;">{{ message }}</div>
    {% endfor %}

    <div class="talents-grid">
        {% for offre in offres %}
            <div class="talent-card" style="display:flex; flex-direction:column; position:relative; overflow:hidden; transition: transform 0.3s, box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0, 240, 255, 0.1)'" onmouseout="this.style.transform='none'; this.style.boxShadow='none'">
                <div style="position: absolute; top:0; left:0; width:100%; height:4px; background: linear-gradient(90deg, var(--neon-blue), var(--neon-purple));"></div>
                
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 1.5rem;">
                    <div class="avatar-circle theme-blue"><i class="fas fa-laptop-code"></i></div>
                    <span class="badge theme-purple" style="font-size: 0.75rem;"><i class="fas fa-star"></i> Featured</span>
                </div>
                
                <h3 class="talent-name" style="font-size: 1.3rem; margin-bottom: 0.5rem;">{{ offre.titre_poste }}</h3>
                <p class="talent-poste" style="margin-bottom: 1.5rem; opacity: 0.8;"><i class="fas fa-building" style="margin-right:0.5rem;"></i>{{ offre.departement }}</p>
                
                <div class="talent-info" style="margin-bottom: 2rem; display: flex; flex-direction:column; gap:0.8rem; text-align:left; width:100%; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1.5rem;">
                    <div style="display:flex; align-items:center;"><i class="fas fa-money-bill-wave" style="color:var(--neon-blue); width:30px; font-size:1.1rem;"></i> <span style="font-weight:600;">{{ offre.salaire_propose ? offre.salaire_propose|number_format(0, '.', ' ') ~ ' ' ~ offre.devise : 'Non spécifié' }}</span></div>
                    <div style="display:flex; align-items:center;"><i class="fas fa-calendar-alt" style="color:var(--neon-purple); width:30px; font-size:1.1rem;"></i> <span>Date: {{ offre.date_creation ? offre.date_creation|date('d/m/Y') : 'Récent' }}</span></div>
                </div>
                
                <div class="talent-actions" style="margin-top:auto; width: 100%; padding-top:0; border:none;">
                    <a href="{{ path('app_public_postuler', {'id_offre': offre.id_offre}) }}" class="btn btn-primary" style="width: 100%; justify-content:center; padding: 1rem;"><i class="fas fa-paper-plane"></i> Postuler avec CV</a>
                </div>
            </div>
        {% else %}
            <div class="stat-card" style="grid-column: 1 / -1;">
                <h3>Aucune offre disponible actuellement.</h3>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
