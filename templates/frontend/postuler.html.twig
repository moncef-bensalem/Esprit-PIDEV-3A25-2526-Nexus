{% extends 'base.html.twig' %}
{% block title %}Postuler — {{ offre.titre_poste }} — Nexus{% endblock %}
{% block page_title %}Postuler à l'offre{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
.apply-layout {
    display: grid;
    grid-template-columns: 1fr 500px;
    gap: 28px;
    align-items: start;
    max-width: 1060px;
    margin: 0 auto;
}
@media (max-width: 900px) { .apply-layout { grid-template-columns: 1fr; } }

/* ── Back link ── */
.back-link {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 16px; border-radius: 9px; margin-bottom: 22px;
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.5); font-size: .81rem; font-weight: 600;
    text-decoration: none; transition: all .18s;
}
.back-link:hover { background: rgba(255,255,255,.08); color: #fff; }

/* ── Offer info card ── */
.offer-info-card {
    background: rgba(13,25,42,.8);
    border: 1px solid rgba(32,178,170,.15);
    border-radius: 18px; overflow: hidden;
    position: sticky; top: 82px;
    backdrop-filter: blur(10px);
}
.offer-banner {
    padding: 36px 28px 28px; text-align: center;
    background: linear-gradient(135deg, rgba(32,178,170,.1) 0%, rgba(2,136,209,.05) 100%);
    border-bottom: 1px solid rgba(32,178,170,.12);
}
.offer-banner-icon {
    width: 68px; height: 68px; border-radius: 16px; margin: 0 auto 18px;
    background: rgba(32,178,170,.12); border: 1px solid rgba(32,178,170,.22);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; color: #20b2aa;
}
.offer-banner-title { font-size: 1.3rem; font-weight: 700; color: #fff; line-height: 1.25; margin-bottom: 8px; }
.offer-banner-dept  { font-size: .83rem; color: #20b2aa; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 5px; }
.offer-banner-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 7px; margin-top: 16px; }
.offer-chip {
    padding: 4px 12px; border-radius: 20px; font-size: .73rem; font-weight: 600;
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.5); display: flex; align-items: center; gap: 4px;
}
.offer-chip i { color: #20b2aa; font-size: .65rem; }

.offer-info-body { padding: 20px 24px; }
.offer-info-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.05);
}
.offer-info-row:last-child { border-bottom: none; }
.offer-row-icon {
    width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
    background: rgba(32,178,170,.1); border: 1px solid rgba(32,178,170,.15);
    display: flex; align-items: center; justify-content: center;
    font-size: .78rem; color: #20b2aa;
}
.offer-row-label { font-size: .68rem; color: rgba(255,255,255,.28); font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
.offer-row-value { font-size: .84rem; color: rgba(255,255,255,.72); font-weight: 600; }

/* ── Form card ── */
.apply-form-card {
    background: rgba(13,25,42,.8);
    border: 1px solid rgba(32,178,170,.15);
    border-radius: 18px; overflow: hidden;
    backdrop-filter: blur(10px);
}
.form-card-header {
    padding: 22px 26px; border-bottom: 1px solid rgba(32,178,170,.12);
    display: flex; align-items: center; gap: 12px;
}
.form-header-icon {
    width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0;
    background: linear-gradient(135deg, #20b2aa, #0288d1);
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; color: #fff;
}
.form-header-title    { font-size: .92rem; font-weight: 700; color: #fff; }
.form-header-subtitle { font-size: .74rem; color: rgba(255,255,255,.35); margin-top: 2px; }
.form-body { padding: 26px; }

/* ── Fields ── */
.field-group { margin-bottom: 20px; }
.field-label {
    display: block; font-size: .75rem; font-weight: 700;
    color: rgba(255,255,255,.5); text-transform: uppercase;
    letter-spacing: .6px; margin-bottom: 7px;
    display: flex; align-items: center; gap: 5px;
}
.field-label i { color: #20b2aa; font-size: .7rem; }
.field-input {
    width: 100%; padding: 11px 14px; border-radius: 10px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1);
    color: #e2e8f0; font-size: .88rem; font-family: inherit;
    transition: border-color .18s, background .18s; outline: none;
}
.field-input:focus {
    border-color: rgba(32,178,170,.5);
    background: rgba(32,178,170,.04);
    box-shadow: 0 0 0 3px rgba(32,178,170,.1);
}
.field-input::placeholder { color: rgba(255,255,255,.18); }
.field-error {
    margin-top: 5px; font-size: .74rem; color: #ef9a9a;
    display: flex; align-items: center; gap: 4px;
}

.cv-zone {
    border: 2px dashed rgba(32,178,170,.22);
    border-radius: 12px; padding: 26px 20px;
    text-align: center; background: rgba(32,178,170,.03);
    transition: border-color .18s, background .18s;
    cursor: pointer; position: relative; overflow: hidden;
}
.cv-zone:hover { border-color: rgba(32,178,170,.42); background: rgba(32,178,170,.06); }
.cv-zone-icon { font-size: 1.8rem; color: rgba(32,178,170,.38); margin-bottom: 9px; }
.cv-zone-text { font-size: .82rem; color: rgba(255,255,255,.42); line-height: 1.55; }
.cv-zone-text strong { color: #20b2aa; }
.cv-zone-hint { font-size: .7rem; color: rgba(255,255,255,.22); margin-top: 7px; }
.cv-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }

.section-divider { border: none; border-top: 1px solid rgba(255,255,255,.06); margin: 22px 0; }

.submit-btn {
    width: 100%; padding: 13px 20px; border-radius: 11px; border: none;
    background: linear-gradient(135deg, #20b2aa, #0288d1);
    color: #fff; font-size: .9rem; font-weight: 700; font-family: inherit;
    display: flex; align-items: center; justify-content: center; gap: 9px;
    cursor: pointer; transition: opacity .18s, transform .18s;
}
.submit-btn:hover { opacity: .88; transform: translateY(-2px); }

.privacy-note {
    display: flex; align-items: flex-start; gap: 7px; margin-top: 14px;
    font-size: .72rem; color: rgba(255,255,255,.25); line-height: 1.55;
}
.privacy-note i { color: rgba(32,178,170,.4); margin-top: 2px; flex-shrink: 0; }
</style>
{% endblock %}

{% block content %}

<a href="{{ path('app_public_offres') }}" class="back-link">
    <i class="fa fa-arrow-left"></i> Retour aux offres
</a>

<div class="apply-layout">

    {# ── Offer info ── #}
    <div class="offer-info-card">
        <div class="offer-banner">
            <div class="offer-banner-icon"><i class="fa fa-laptop-code"></i></div>
            <div class="offer-banner-title">{{ offre.titre_poste }}</div>
            <div class="offer-banner-dept"><i class="fa fa-building"></i> {{ offre.departement ?? 'Non précisé' }}</div>
            <div class="offer-banner-chips">
                {% if offre.type_contrat is defined and offre.type_contrat %}
                    <span class="offer-chip"><i class="fa fa-file-contract"></i> {{ offre.type_contrat }}</span>
                {% endif %}
                <span class="offer-chip"><i class="fa fa-circle" style="color:#4caf50;font-size:.5rem;"></i> Ouvert</span>
            </div>
        </div>
        <div class="offer-info-body">
            <div class="offer-info-row">
                <div class="offer-row-icon"><i class="fa fa-money-bill-wave"></i></div>
                <div>
                    <div class="offer-row-label">Rémunération</div>
                    <div class="offer-row-value">
                        {% if offre.salaire_propose %}{{ offre.salaire_propose|number_format(0, '.', ' ') }} {{ offre.devise }}
                        {% else %}À négocier{% endif %}
                    </div>
                </div>
            </div>
            <div class="offer-info-row">
                <div class="offer-row-icon"><i class="fa fa-calendar-alt"></i></div>
                <div>
                    <div class="offer-row-label">Publication</div>
                    <div class="offer-row-value">{{ offre.date_creation ? offre.date_creation|date('d/m/Y') : 'Récemment' }}</div>
                </div>
            </div>
            
            <hr class="section-divider" style="margin: 15px 0;">
            
            <div class="offer-info-row" style="align-items: flex-start;">
                <div class="offer-row-icon" style="margin-top: 2px;"><i class="fa fa-align-left"></i></div>
                <div>
                    <div class="offer-row-label">Description du Poste</div>
                    <div class="offer-row-value" style="font-weight: normal; font-size: 0.80rem; margin-top: 6px; line-height: 1.55; color: rgba(255,255,255,0.75);">
                        {{ offre.description|nl2br }}
                    </div>
                </div>
            </div>

            <hr class="section-divider" style="margin: 15px 0;">
            <div class="offer-info-row" style="flex-direction: column; align-items: stretch; gap: 10px;">
                <div class="offer-row-label" style="display:flex; align-items:center; gap:6px;"><i class="fa fa-map-marker-alt" style="color: #20b2aa;"></i> Localisation</div>
                <div id="job-map" style="height: 180px; width: 100%; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);"></div>
            </div>
        </div>
    </div>

    {# ── Application form ── #}
    <div class="apply-form-card">
        <div class="form-card-header">
            <div class="form-header-icon"><i class="fa fa-paper-plane"></i></div>
            <div>
                <div class="form-header-title">Soumettre ma candidature</div>
                <div class="form-header-subtitle">Remplissez le formulaire ci-dessous</div>
            </div>
        </div>

        <div class="form-body">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

            <div class="field-group">
                <label class="field-label"><i class="fa fa-user"></i> Nom complet</label>
                {{ form_widget(form.nom_complet, {'attr': {'class': 'field-input', 'placeholder': 'Ex : Jean Dupont'}}) }}
                {% if form.nom_complet.vars.errors|length > 0 %}
                    <div class="field-error"><i class="fa fa-exclamation-circle"></i> {{ form.nom_complet.vars.errors[0].message }}</div>
                {% endif %}
            </div>

            <div class="field-group">
                <label class="field-label"><i class="fa fa-envelope"></i> Adresse email</label>
                {{ form_widget(form.email, {'attr': {'class': 'field-input', 'placeholder': 'Ex : jean.dupont@email.com'}}) }}
                {% if form.email.vars.errors|length > 0 %}
                    <div class="field-error"><i class="fa fa-exclamation-circle"></i> {{ form.email.vars.errors[0].message }}</div>
                {% endif %}
            </div>

            <hr class="section-divider">

            <div class="field-group">
                <label class="field-label"><i class="fa fa-file-pdf"></i> Votre CV</label>
                <div class="cv-zone" id="cvZone">
                    {{ form_widget(form.cv) }}
                    <div class="cv-zone-icon"><i class="fa fa-cloud-upload-alt"></i></div>
                    <div class="cv-zone-text"><strong>Cliquez ou glissez</strong> votre CV ici<br>Format PDF ou Word accepté</div>
                    <div class="cv-zone-hint" id="cvHint">Taille maximum : 5 Mo</div>
                </div>
                {% if form.cv.vars.errors|length > 0 %}
                    <div class="field-error"><i class="fa fa-exclamation-circle"></i> {{ form.cv.vars.errors[0].message }}</div>
                {% endif %}
            </div>

            {{ form_rest(form) }}

            <button type="submit" class="submit-btn">
                <i class="fa fa-paper-plane"></i> Envoyer ma candidature
            </button>

            <div class="privacy-note">
                <i class="fa fa-shield-alt"></i>
                Vos données sont traitées en toute confidentialité et uniquement à des fins de recrutement.
            </div>

            {{ form_end(form) }}
        </div>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const input = document.querySelector('#cvZone input[type="file"]');
    const textZone = document.querySelector('.cv-zone-text');
    const hint = document.getElementById('cvHint');
    if (input && textZone) {
        input.addEventListener('change', function() {
            if (this.files.length > 0) {
                textZone.innerHTML = '<strong style="color: #00ffcc;">Fichier sélectionné :</strong><br>' + this.files[0].name;
            } else {
                textZone.innerHTML = '<strong>Cliquez ou glissez</strong> votre CV ici<br>Format PDF ou Word accepté';
            }
        });
    }
});
</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (document.getElementById('job-map')) {
        // --- Region Mapping Logic ---
        const currency = "{{ offre.devise|default('TND')|upper }}";
        let baseLat, baseLng, zoomLevel, regionName;

        if (currency === 'EUR') {
            // Europe Bounds (Approx: Paris/Berlin/Rome focus)
            baseLat = 48.8566 + (Math.random() * 8 - 4);
            baseLng = 2.3522 + (Math.random() * 15 - 7.5);
            zoomLevel = 4;
            regionName = "Europe";
        } else if (currency === 'USD') {
            // USA Bounds (Approx: East Coast to Mid-West focus)
            baseLat = 39.8283 + (Math.random() * 10 - 5);
            baseLng = -98.5795 + (Math.random() * 30 - 15);
            zoomLevel = 4;
            regionName = "États-Unis";
        } else {
            // Tunisia Bounds (Default: TND)
            baseLat = 36.8065 + (Math.random() * 2 - 1);
            baseLng = 10.1815 + (Math.random() * 1 - 0.5);
            zoomLevel = 7;
            regionName = "Tunisie";
        }
        
        try {
            const map = L.map('job-map').setView([baseLat, baseLng], zoomLevel);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            let markerUrl = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png';
            let customIcon = L.icon({
                iconUrl: markerUrl,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });

            L.marker([baseLat, baseLng], {icon: customIcon}).addTo(map)
                .bindPopup('<b style="color:#000;">{{ offre.titre_poste|escape('js') }}</b><br><span style="color:#666;">Département: {{ offre.departement|default('Recrutement')|escape('js') }} (' + regionName + ')</span>')
                .openPopup();
        } catch (e) {
            console.log("Map initialization skipped.", e);
        }
    }
});
</script>
{% endblock %}
