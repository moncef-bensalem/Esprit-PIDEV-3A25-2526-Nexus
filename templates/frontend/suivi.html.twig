{% extends 'base.html.twig' %}
{% block title %}Suivi de Candidature — Nexus{% endblock %}
{% block page_title %}Suivi de Candidature{% endblock %}

{% block stylesheets %}
<style>
.suivi-layout { max-width: 820px; margin: 0 auto; }

.suivi-card {
    background: rgba(13,25,42,.8);
    border: 1px solid rgba(32,178,170,.15);
    border-radius: 18px; padding: 44px 40px;
    text-align: center; margin-bottom: 32px;
    backdrop-filter: blur(10px); position: relative; overflow: hidden;
}
.suivi-card::before {
    content: ''; position: absolute; top: -80px; right: -80px;
    width: 280px; height: 280px; border-radius: 50%;
    background: radial-gradient(circle, rgba(32,178,170,.07) 0%, transparent 70%);
    pointer-events: none;
}
.suivi-icon {
    width: 62px; height: 62px; border-radius: 16px; margin: 0 auto 20px;
    background: rgba(32,178,170,.12); border: 1px solid rgba(32,178,170,.22);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: #20b2aa;
}
.suivi-title { font-size: 1.45rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
.suivi-sub { font-size: .86rem; color: rgba(255,255,255,.36); margin-bottom: 28px; }

.suivi-form { display: flex; flex-direction: column; gap: 10px; max-width: 420px; margin: 0 auto; }
.suivi-input {
    width: 100%; padding: 12px 18px; border-radius: 10px;
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    color: #e2e8f0; font-size: .9rem; font-family: inherit; outline: none; text-align: center;
    transition: border-color .18s, background .18s;
}
.suivi-input:focus {
    border-color: rgba(32,178,170,.5); background: rgba(32,178,170,.04);
    box-shadow: 0 0 0 3px rgba(32,178,170,.1);
}
.suivi-input::placeholder { color: rgba(255,255,255,.2); }
.suivi-btn {
    width: 100%; padding: 12px; border-radius: 10px; border: none;
    background: linear-gradient(135deg, #20b2aa, #0288d1);
    color: #fff; font-size: .88rem; font-weight: 700; font-family: inherit;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: opacity .18s, transform .18s;
}
.suivi-btn:hover { opacity: .88; transform: translateY(-1px); }

/* ── Results ── */
.results-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.results-name { font-size: 1rem; font-weight: 700; color: #fff; }
.results-count {
    padding: 3px 11px; border-radius: 11px;
    background: rgba(32,178,170,.12); border: 1px solid rgba(32,178,170,.25);
    font-size: .73rem; font-weight: 700; color: #20b2aa;
}

.cand-row {
    background: rgba(13,25,42,.75);
    border: 1px solid rgba(32,178,170,.13);
    border-radius: 14px; padding: 20px 22px; margin-bottom: 12px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; flex-wrap: wrap;
    backdrop-filter: blur(8px); position: relative; overflow: hidden;
    transition: border-color .18s;
}
.cand-row:hover { border-color: rgba(32,178,170,.25); }
.cand-accent {
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px; border-radius: 14px 0 0 14px;
}
.a-recu         { background: linear-gradient(180deg,#0288d1,#20b2aa); }
.a-en_entretien { background: linear-gradient(180deg,#ab47bc,#7b1fa2); }
.a-offre_faite  { background: linear-gradient(180deg,#4caf50,#2e7d32); }
.a-rejete       { background: linear-gradient(180deg,#ef5350,#b71c1c); }

.cand-title { font-size: .96rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
.cand-dept  { font-size: .77rem; color: rgba(255,255,255,.36); display: flex; align-items: center; gap: 5px; }
.cand-date  { font-size: .74rem; color: rgba(255,255,255,.3); margin-top: 7px; display: flex; align-items: center; gap: 4px; }
.cand-date i { color: rgba(32,178,170,.5); font-size: .68rem; }

.status-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 13px; border-radius: 20px;
    font-size: .72rem; font-weight: 700; white-space: nowrap;
}
.s-recu         { background: rgba(2,136,209,.12); border: 1px solid rgba(2,136,209,.3); color: #29b6f6; }
.s-en_entretien { background: rgba(171,71,188,.12); border: 1px solid rgba(171,71,188,.3); color: #ce93d8; }
.s-offre_faite  { background: rgba(76,175,80,.12);  border: 1px solid rgba(76,175,80,.3);  color: #81c784; }
.s-rejete       { background: rgba(239,83,80,.12);  border: 1px solid rgba(239,83,80,.3);  color: #ef9a9a; }

.pipeline { display: flex; align-items: center; gap: 3px; margin-top: 8px; }
.pip { display: flex; align-items: center; gap: 4px; font-size: .68rem; font-weight: 600; color: rgba(255,255,255,.18); }
.pip.done   { color: rgba(255,255,255,.5); }
.pip.active { color: #20b2aa; }
.pip.fail   { color: #ef5350; }
.pip-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.12); flex-shrink: 0; }
.pip.done  .pip-dot   { background: rgba(255,255,255,.4); }
.pip.active .pip-dot  { background: #20b2aa; box-shadow: 0 0 6px rgba(32,178,170,.6); }
.pip.fail  .pip-dot   { background: #ef5350; }
.pip-arrow { color: rgba(255,255,255,.1); font-size: .58rem; margin: 0 3px; }

.no-results {
    text-align: center; padding: 56px 28px;
    background: rgba(13,25,42,.6);
    border: 1px dashed rgba(32,178,170,.18); border-radius: 14px;
}
.no-results-icon  { font-size: 2.4rem; color: rgba(32,178,170,.2); margin-bottom: 14px; }
.no-results-title { font-size: .98rem; font-weight: 700; color: rgba(255,255,255,.48); margin-bottom: 6px; }
.no-results-sub   { font-size: .8rem; color: rgba(255,255,255,.24); }
</style>
{% endblock %}

{% block content %}
<div class="suivi-layout">

    <div class="suivi-card">
        <div class="suivi-icon"><i class="fa fa-search-location"></i></div>
        <div class="suivi-title">Suivre ma candidature</div>
        <div class="suivi-sub">Entrez votre adresse email pour consulter l'état de vos candidatures</div>

        <form method="POST" action="{{ path('app_public_suivi') }}" class="suivi-form">
            <input type="email" name="email"
                   value="{{ searchedEmail ?? '' }}"
                   placeholder="votre@email.com"
                   required class="suivi-input">
            <button type="submit" class="suivi-btn">
                <i class="fa fa-search"></i> Vérifier mon statut
            </button>
        </form>
    </div>

    {% if candidat %}
        <div class="results-header">
            <div class="results-name">{{ candidat.nom_complet }}</div>
            <div class="results-count">{{ candidatures|length }} candidature{{ candidatures|length != 1 ? 's' : '' }}</div>
        </div>

        {% for cand in candidatures %}
            {% set etat = cand.etat_avancement %}
            {% set el = etat|lower %}
            <div class="cand-row">
                <div class="cand-accent a-{{ el }}"></div>
                <div style="flex:1;min-width:180px;">
                    <div class="cand-title">{{ cand.offreEmploi.titre_poste }}</div>
                    <div class="cand-dept"><i class="fa fa-building"></i> {{ cand.offreEmploi.departement ?? '—' }}</div>
                    <div class="cand-date"><i class="fa fa-calendar-alt"></i> {{ cand.date_postulation|date('d/m/Y') }}</div>
                    <div class="pipeline">
                        <div class="pip {{ etat in ['EN_ENTRETIEN','OFFRE_FAITE','REJETE'] ? 'done' : '' }} {{ etat == 'RECU' ? 'active' : '' }}">
                            <div class="pip-dot"></div> Reçue
                        </div>
                        <div class="pip-arrow"><i class="fa fa-chevron-right"></i></div>
                        <div class="pip {{ etat == 'OFFRE_FAITE' ? 'done' : '' }} {{ etat == 'EN_ENTRETIEN' ? 'active' : '' }}">
                            <div class="pip-dot"></div> Entretien
                        </div>
                        <div class="pip-arrow"><i class="fa fa-chevron-right"></i></div>
                        <div class="pip {{ etat == 'OFFRE_FAITE' ? 'active done' : '' }} {{ etat == 'REJETE' ? 'fail' : '' }}">
                            <div class="pip-dot"></div> {% if etat == 'REJETE' %}Rejetée{% else %}Offre faite{% endif %}
                        </div>
                    </div>
                </div>
                <span class="status-badge s-{{ el }}">
                    {% if etat == 'RECU' %}<i class="fa fa-inbox"></i> Reçue
                    {% elseif etat == 'EN_ENTRETIEN' %}<i class="fa fa-comments"></i> En Entretien
                    {% elseif etat == 'OFFRE_FAITE' %}<i class="fa fa-check-circle"></i> Offre Faite !
                    {% elseif etat == 'REJETE' %}<i class="fa fa-times-circle"></i> Rejetée
                    {% else %}{{ etat }}{% endif %}
                </span>
            </div>
        {% else %}
            <div class="no-results">
                <div class="no-results-icon"><i class="fa fa-inbox"></i></div>
                <div class="no-results-title">Aucune candidature trouvée</div>
                <div class="no-results-sub">Aucune candidature n'est associée à cet email.</div>
            </div>
        {% endfor %}

    {% elseif searchedEmail %}
        <div class="no-results">
            <div class="no-results-icon"><i class="fa fa-user-slash"></i></div>
            <div class="no-results-title">Aucun compte trouvé</div>
            <div class="no-results-sub">Aucun candidat associé à <strong style="color:rgba(255,255,255,.45);">{{ searchedEmail }}</strong>.</div>
        </div>
    {% endif %}

</div>
{% endblock %}
