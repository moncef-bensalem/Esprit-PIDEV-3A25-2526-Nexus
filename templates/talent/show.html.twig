{% extends 'base.html.twig' %}

{% block title %}{{ talent.prenom }} {{ talent.nom }} - NEXUS{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <div style="display:flex; align-items:center; gap:1rem;">
            <a href="{{ path('app_talent_index') }}" class="btn"><i class="fa-solid fa-arrow-left"></i></a>
            <h1><i class="fa-solid fa-user" style="color:var(--neon-blue);margin-right:.5rem;"></i>{{ talent.prenom }} {{ talent.nom }}</h1>
        </div>
        <div class="top-actions">
            <a href="{{ path('app_talent_edit', {'id': talent.id}) }}" class="btn"><i class="fa-solid fa-pen"></i> Modifier</a>
            <a href="{{ path('app_talent_index') }}" class="btn"><i class="fa-solid fa-list"></i> Liste</a>
        </div>
    </div>

    <div class="detail-card">
        <div class="rank-header">
            <div class="avatar-circle {{ talent.id % 2 == 0 ? 'theme-purple' : 'theme-blue' }}" style="width:60px;height:60px;font-size:1.2rem;">
                {{ talent.prenom|slice(0,1)|upper }}{{ talent.nom|slice(0,1)|upper }}
            </div>
            <div>
                <h2 style="margin:0;">{{ talent.prenom }} {{ talent.nom }}</h2>
                <span style="color:var(--text-muted);font-size:0.85rem;">{{ talent.poste }} · {{ talent.departement }}</span>
            </div>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="fa-solid fa-envelope" style="margin-right:0.5rem;color:var(--neon-blue);"></i>Email</span>
            <span class="detail-value">{{ talent.email }}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label"><i class="fa-solid fa-phone" style="margin-right:0.5rem;color:var(--neon-purple);"></i>Téléphone</span>
            <span class="detail-value">{{ talent.telephone }}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label"><i class="fa-solid fa-briefcase" style="margin-right:0.5rem;color:var(--neon-blue);"></i>Poste</span>
            <span class="detail-value">{{ talent.poste }}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label"><i class="fa-solid fa-building" style="margin-right:0.5rem;color:var(--neon-purple);"></i>Département</span>
            <span class="detail-value">{{ talent.departement }}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label"><i class="fa-solid fa-calendar" style="margin-right:0.5rem;color:#f59e0b;"></i>Date d'embauche</span>
            <span class="detail-value">{{ talent.dateEmbauche ? talent.dateEmbauche|date('d/m/Y') : 'Non renseignée' }}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label"><i class="fa-solid fa-clock" style="margin-right:0.5rem;color:var(--neon-blue);"></i>Expérience</span>
            <span class="detail-value">{{ talent.anneesExperience }} ans</span>
        </div>
        <div class="detail-row">
            <span class="detail-label"><i class="fa-solid fa-graduation-cap" style="margin-right:0.5rem;color:#f59e0b;"></i>Niveau d'études</span>
            <span class="detail-value">{{ talent.niveauEtudes }}</span>
        </div>

        <div style="margin-top:1.5rem; display:flex; gap:0.8rem;">
            <a href="{{ path('app_talent_edit', {'id': talent.id}) }}" class="btn btn-primary"><i class="fa-solid fa-pen"></i> Modifier</a>
            {{ include('talent/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
