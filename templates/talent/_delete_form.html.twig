<form method="post" action="{{ path('app_talent_delete', {'id': talent.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce talent ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ talent.id) }}">
    <button class="btn" style="border-color: rgba(236,72,153,0.4); color: var(--neon-pink);">
        <i class="fa-solid fa-trash"></i> Supprimer ce talent
    </button>
</form>
