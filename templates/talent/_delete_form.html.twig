<form method="post" action="{{ path('app_talent_delete', {'id': talent.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce talent ?');" style="margin: 0; padding: 0; display: inline-flex;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ talent.id) }}">
    <button class="btn" style="background: rgba(220, 38, 38, 0.05); border: 1px solid rgba(220, 38, 38, 0.2); color: #ef4444; padding: 12px 24px; border-radius: 10px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 8px; font-weight: 500;" onmouseover="this.style.background='rgba(220,38,38,0.15)'" onmouseout="this.style.background='rgba(220,38,38,0.05)'"><i class="fa-solid fa-trash"></i> Supprimer</button>
</form>
