{% extends 'base.html.twig' %}

{% block title %}Details evaluation{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    body { background: #0d1b2a; color: #d6e6f5; font-family: 'Segoe UI', sans-serif; }
    .wrapper { max-width: 860px; margin: 28px auto; }
    .card-dark { background: #102235; border: 1px solid #1f3c57; border-radius: 12px; }
    .label { color: #9fb4c8; font-size: .9rem; }
    .value { color: #fff; font-size: 1rem; font-weight: 600; }
    .scores-title { color: #fff; font-size: 1.1rem; font-weight: 700; margin: 24px 0 10px; }
    .scores-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 14px;
    }
    .score-card {
        border-radius: 12px;
        min-height: 160px;
        border: 1px solid rgba(255,255,255,0.18);
        padding: 14px;
        color: #fff;
        cursor: pointer;
        transition: transform .12s ease-in-out, box-shadow .12s ease-in-out;
        display: flex;
        flex-direction: column;
    }
    .score-card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,.25); }
    .score-name { font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
    .score-note { font-size: .9rem; opacity: .95; }
    .score-actions { margin-top: auto; display: flex; gap: 8px; padding-top: 12px; }
    .btn-mini {
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,.4);
        font-size: .78rem;
        padding: 4px 10px;
        text-decoration: none;
        color: #fff;
        background: rgba(15,23,42,.42);
    }
    .btn-mini:hover { color: #fff; background: rgba(15,23,42,.65); }
    .btn-delete-mini {
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,.4);
        font-size: .78rem;
        padding: 4px 10px;
        color: #fff;
        background: rgba(127,29,29,.65);
    }
    .btn-delete-mini:hover { background: rgba(127,29,29,.85); }
    .empty-state { color: #9fb4c8; font-size: .95rem; margin-bottom: 14px; }
    .flash-wrap { margin-bottom: 12px; }
</style>
{% endblock %}

{% block body %}
<div class="wrapper">
    <div class="flash-wrap">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show py-2" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <div class="card card-dark">
        <div class="card-header text-white d-flex justify-content-between align-items-center">
            <span>Details de l'evaluation #{{ evaluation.idEvaluation }}</span>
            <a href="{{ path('evaluation_index') }}" class="btn btn-sm btn-outline-light">Retour</a>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="label">Numero</div>
                    <div class="value">{{ evaluation.idEvaluation }}</div>
                </div>
                <div class="col-md-6">
                    <div class="label">Date creation</div>
                    <div class="value">{{ evaluation.dateCreation|date('Y-m-d H:i') }}</div>
                </div>
                <div class="col-md-6">
                    <div class="label">Decision preliminaire</div>
                    <div class="value">{{ evaluation.decisionPreliminaire }}</div>
                </div>
                {% if evaluation.decisionPreliminaire == 'A_REVOIR' and evaluation.reviewDeadline %}
                    <div class="col-md-6">
                        <div class="label">Review deadline</div>
                        <div class="value">{{ evaluation.reviewDeadline|date('Y-m-d') }}</div>
                    </div>
                {% endif %}
                <div class="col-md-6">
                    <div class="label">Candidat</div>
                    <div class="value">{{ evaluation.candidat ? (evaluation.candidat.firstName ~ ' ' ~ evaluation.candidat.lastName) : 'Non assigne' }}</div>
                </div>
                <div class="col-md-6">
                    <div class="label">Recruteur</div>
                    <div class="value">{{ evaluation.recruteur ? (evaluation.recruteur.firstName ~ ' ' ~ evaluation.recruteur.lastName) : 'Non assigne' }}</div>
                </div>
                <div class="col-12">
                    <div class="label">Commentaire global</div>
                    <div class="value" style="font-weight: 500;">{{ evaluation.commentaireGlobal }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="scores-title">Score competences de cette evaluation</div>
    {% if scoreCompetences is empty %}
        <div class="empty-state">Aucun score competence pour cette evaluation.</div>
    {% else %}
        <div class="scores-grid">
            {% for score in scoreCompetences %}
                {% set normalized = score.noteAttribuee|replace({',': '.'}) %}
                {% set noteValue = normalized matches '/^-?\d+(\.\d+)?$/' ? normalized + 0 : 0 %}
                {% set clampedNote = noteValue < 0 ? 0 : (noteValue > 20 ? 20 : noteValue) %}
                {% set hue = (clampedNote / 20) * 270 %}

                <div class="score-card"
                     style="background: hsl({{ hue }}, 70%, 35%);"
                     ondblclick="window.location.href='{{ path('score_competence_show', {idEvaluation: evaluation.idEvaluation, idDetail: score.idDetail}) }}'">
                    <div class="score-name">{{ score.nomCritere }}</div>
                    <div class="score-note">Note attribuee: {{ score.noteAttribuee }}/20</div>
                    <div class="score-actions">
                        <a href="{{ path('score_competence_edit', {idEvaluation: evaluation.idEvaluation, idDetail: score.idDetail}) }}"
                           class="btn-mini"
                           onclick="event.stopPropagation();">Modifier</a>
                        <form method="post"
                              action="{{ path('score_competence_delete', {idEvaluation: evaluation.idEvaluation, idDetail: score.idDetail}) }}"
                              onsubmit="event.stopPropagation(); return confirm('Supprimer ce score competence ?');"
                              style="margin:0;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_score_competence_' ~ score.idDetail) }}">
                            <button type="submit" class="btn-delete-mini">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="mt-3">
        <a href="{{ path('score_competence_new', {idEvaluation: evaluation.idEvaluation}) }}" class="btn btn-primary">+ Creer un score competence</a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
