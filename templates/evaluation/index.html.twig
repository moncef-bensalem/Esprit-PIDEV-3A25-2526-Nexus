{% extends 'base.html.twig' %}

{% block title %}Evaluations{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    body { background: #0d1b2a; color: #d6e6f5; font-family: 'Segoe UI', sans-serif; }
    .dash-grid {
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 18px;
        padding: 10px 24px 0;
    }
    @media (max-width: 1100px) { .dash-grid { grid-template-columns: 1fr; } }
    .panel {
        border: 1px solid rgba(255,255,255,0.15);
        background: rgba(15,23,42,.25);
        border-radius: 14px;
        padding: 14px;
    }
    .panel-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }
    .panel-title h2 {
        font-size: 1rem;
        font-weight: 800;
        margin: 0;
        color: #fff;
    }
    .month-nav {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .month-label {
        font-weight: 800;
        color: #e2e8f0;
        letter-spacing: .2px;
        min-width: 180px;
        text-align: center;
    }
    .btn-nav {
        background: rgba(15,23,42,.55);
        border: 1px solid rgba(255,255,255,.25);
        color: #fff;
        border-radius: 10px;
        padding: 6px 10px;
        font-weight: 700;
        line-height: 1;
    }
    .btn-nav:hover { background: rgba(15,23,42,.8); }
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }
    .dow {
        font-size: .78rem;
        color: rgba(226,232,240,.9);
        text-transform: uppercase;
        letter-spacing: .08em;
        text-align: center;
        padding: 6px 0 2px;
    }
    .day {
        min-height: 92px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(2,6,23,.32);
        padding: 8px;
        position: relative;
        overflow: hidden;
    }
    .day.muted {
        opacity: .45;
        background: rgba(2,6,23,.18);
    }
    .day.today {
        border-color: rgba(37, 99, 235, .65);
        box-shadow: 0 0 0 2px rgba(37, 99, 235, .18) inset;
    }
    .day-num {
        font-weight: 800;
        color: #fff;
        font-size: .9rem;
    }
    .deadlines {
        margin-top: 6px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .deadline-pill {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .78rem;
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(15,23,42,.55);
        color: #e2e8f0;
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }
    .deadline-pill:hover { background: rgba(15,23,42,.8); color: #fff; }
    .deadline-pill .tag {
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
        color: #fff;
        flex: 0 0 auto;
    }
    .tag.favorable { background: rgba(20,83,45,.55); }
    .tag.defavorable { background: rgba(127,29,29,.55); }
    .tag.arevoir { background: rgba(154,52,18,.6); }
    .chart-wrap {
        position: relative;
        height: 280px;
    }
    .topbar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin: 22px 24px 8px;
    }
    .topbar-title { font-size: 1.2rem; font-weight: 700; color: #fff; }
    .btn-create {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 8px 16px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .btn-create:hover { color: #fff; opacity: .95; }
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 18px;
        padding: 16px 24px 24px;
    }
    .evaluation-card {
        border-radius: 14px;
        padding: 16px;
        min-height: 190px;
        border: 1px solid rgba(255,255,255,0.15);
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: transform .12s ease-in-out, box-shadow .12s ease-in-out;
    }
    .evaluation-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.25); }
    .decision-favorable { background: #14532d; }
    .decision-defavorable { background: #7f1d1d; }
    .decision-arevoir { background: #9a3412; }
    .card-title { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
    .card-meta { font-size: 0.85rem; color: #e2e8f0; line-height: 1.5; }
    .card-actions {
        margin-top: auto;
        display: flex;
        gap: 8px;
        padding-top: 12px;
    }
    .btn-edit {
        background: rgba(15,23,42,.45);
        border: 1px solid rgba(255,255,255,.35);
        color: #fff;
        border-radius: 8px;
        padding: 5px 12px;
        text-decoration: none;
        font-size: .8rem;
    }
    .btn-edit:hover { color: #fff; background: rgba(15,23,42,.7); }
    .btn-delete {
        background: rgba(127,29,29,.55);
        border: 1px solid rgba(255,255,255,.35);
        color: #fff;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: .8rem;
    }
    .btn-delete:hover { background: rgba(127,29,29,.8); }
    .flash-wrap { margin: 12px 24px 0; }
    .empty-state { margin: 36px 24px; color: #9fb4c8; font-size: .95rem; }
    .evaluation-card.best-score {
        border: 2px solid rgba(34, 197, 94, .95);
        box-shadow: 0 0 0 2px rgba(34, 197, 94, .22) inset, 0 10px 26px rgba(0,0,0,.28);
        position: relative;
    }
    .best-score-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-left: 8px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .2px;
        color: #052e16;
        background: rgba(34, 197, 94, .92);
        border: 1px solid rgba(187, 247, 208, .65);
        vertical-align: middle;
        white-space: nowrap;
    }
    .deadline-reminder-strong { color: #fff; font-weight: 800; }
</style>
{% endblock %}

{% block content %}
<div class="topbar">
    <div class="topbar-title">{% if is_candidate_only|default(false) %}Votre decision preliminaire{% else %}Liste des evaluations{% endif %}</div>
    {% if not is_candidate_only|default(false) %}
    <a href="{{ path('evaluation_new') }}" class="btn-create">+ Creer une evaluation</a>
    <a href="{{ path('evaluation_export_pdf') }}"
        class="btn-create"
        style="background: linear-gradient(135deg, #7c3aed, #5b21b6);">
        ⬇ Exporter PDF
    </a>
    {% endif %}
</div>

<div class="dash-grid">
    <div class="panel">
        <div class="panel-title">
            <h2>Les dates de revoir</h2>
            <div class="month-nav">
                <button class="btn-nav" type="button" id="calPrev" aria-label="Mois precedent">&lt;</button>
                <div class="month-label" id="calLabel">—</div>
                <button class="btn-nav" type="button" id="calNext" aria-label="Mois suivant">&gt;</button>
            </div>
        </div>

        <div class="calendar-grid" id="calendar">
            <div class="dow">Lun</div><div class="dow">Mar</div><div class="dow">Mer</div><div class="dow">Jeu</div><div class="dow">Ven</div><div class="dow">Sam</div><div class="dow">Dim</div>
            {# Les jours seront generes en JS #}
        </div>
    </div>

    <div class="panel">
        <div class="panel-title">
            <h2>Decisions preliminaires</h2>
        </div>
        <div class="chart-wrap">
            <canvas id="decisionPie" aria-label="Pie chart decisions preliminaires"></canvas>
        </div>
    </div>
</div>

{% if not is_candidate_only|default(false) %}
<div class="flash-wrap">
    <form id="evaluationFiltersForm" method="get" action="{{ path('evaluation_index') }}" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label text-white-50 mb-1">Recherche</label>
            <input type="text" name="q" class="form-control" placeholder="Candidat, recruteur, decision, commentaire..." value="{{ q }}">
        </div>

        <div class="col-md-2">
            <label class="form-label text-white-50 mb-1">Tri</label>
            <select name="orderBy" class="form-select">
                <option value="score" {{ sort == 'score' ? 'selected' : '' }}>Trier par score</option>
                <option value="dateCreation" {{ sort == 'dateCreation' ? 'selected' : '' }}>Trier par date</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label text-white-50 mb-1">Filtres</label>
            <div class="row g-2">
                <div class="col-md-4">
                    <select name="decision" class="form-select">
                        <option value="">Toutes decisions</option>
                        {% for d in decisionOptions %}
                            <option value="{{ d }}" {{ d == decision ? 'selected' : '' }}>{{ d }}</option>
                        {% endfor %}
                    </select>
                </div>

                {% if is_granted('ROLE_ADMIN') %}
                <div class="col-md-4">
                    <select name="recruteur" class="form-select">
                        <option value="">Tous recruteurs</option>
                        {% for id, label in recruteurOptions %}
                            <option value="{{ id }}" {{ id == recruteur ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}

                <div class="col-md-4">
                    <select name="candidat" class="form-select">
                        <option value="">Tous candidats</option>
                        {% for id, label in candidatOptions %}
                            <option value="{{ id }}" {{ id == candidat ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="button" class="btn btn-outline-light w-100" id="resetFiltersBtn">Reinitialiser</button>
        </div>
    </form>
</div>
{% endif %}

<div class="flash-wrap">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show py-2" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{% if is_candidate_only|default(false) %}
    {% if evaluations is empty %}
        <div class="empty-state">Aucune decision preliminaire enregistree pour votre compte.</div>
    {% else %}
    <div class="cards-grid">
        {% for evaluation in evaluations %}
            {% set decisionClass = evaluation.decisionPreliminaire == 'FAVORABLE' ? 'decision-favorable' : (evaluation.decisionPreliminaire == 'DEFAVORABLE' ? 'decision-defavorable' : 'decision-arevoir') %}
            <div class="evaluation-card {{ decisionClass }}" ondblclick="window.location.href='{{ path('evaluation_show', {idEvaluation: evaluation.idEvaluation}) }}'">
                <div class="card-title">Decision preliminaire</div>
                <div class="card-meta">
                    <div>📌 {{ evaluation.decisionPreliminaire }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
    {% endif %}
{% else %}
    <div id="evaluationsCards">
        {% include 'evaluation/_cards.html.twig' with { evaluations: evaluations, averageScoresById: averageScoresById } %}
    </div>
    <div id="paginationBar">
        {% include 'evaluation/_pagination.html.twig' with { pagination: pagination } %}
    </div>
{% endif %}

{# Reminder modal (closest reviewDeadline) #}
<div class="modal fade" id="deadlineReminderModal" tabindex="-1" aria-labelledby="deadlineReminderTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: rgba(2,6,23,.96); border: 1px solid rgba(255,255,255,.18); color: #e2e8f0;">
            <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,.12);">
                <h5 class="modal-title" id="deadlineReminderTitle" style="color:#fff; font-weight: 800;">Rappel : deadline de review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div>
                    La date limite la plus proche est le
                    <span class="deadline-reminder-strong" id="deadlineReminderDate">—</span>
                    (<span id="deadlineReminderDays">—</span>).
                </div>
                <div class="mt-2">
                    Evaluation concerne : <span class="deadline-reminder-strong" id="deadlineReminderEval">—</span>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,.12);">
                <a href="#" class="btn btn-success" id="deadlineReminderLink">Ouvrir l evaluation</a>
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Plus tard</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
window.addEventListener('DOMContentLoaded', () => {
    const dataUrl = {{ path('evaluation_index_data')|json_encode|raw }};
    const cardsEl = document.getElementById('evaluationsCards');
    const paginationBarEl = document.getElementById('paginationBar');
    const formEl = document.getElementById('evaluationFiltersForm');
    const resetBtn = document.getElementById('resetFiltersBtn');

    let evaluations = {{ evaluationsJson|raw }};
    let allEvaluations = {{ allEvaluationsJson|raw }};
    let deadlinesByDate = new Map();
    let pieChart = null;
    let hasShownDeadlineReminder = false;


    let currentPage = {{ pagination is defined ? pagination.currentPageNumber : 1 }};

    function rebuildDeadlinesMap() {
        const map = new Map();
        for (const e of allEvaluations) {
            if (e.decision !== 'A_REVOIR' || !e.reviewDeadline) continue;
            if (!map.has(e.reviewDeadline)) map.set(e.reviewDeadline, []);
            map.get(e.reviewDeadline).push(e);
        }
        deadlinesByDate = map;
    }

    const monthNames = ['Janvier','Fevrier','Mars','Avril','Mai','Juin','Juillet','Aout','Septembre','Octobre','Novembre','Decembre'];
    const labelEl = document.getElementById('calLabel');
    const calEl = document.getElementById('calendar');
    const btnPrev = document.getElementById('calPrev');
    const btnNext = document.getElementById('calNext');

    if (!labelEl || !calEl) {
        return;
    }

    const today = new Date();
    today.setHours(0,0,0,0);
    let cursor = new Date(today.getFullYear(), today.getMonth(), 1);

    function isoDate(d) {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }

    function mondayIndex(d) {
        const js = d.getDay();
        return (js + 6) % 7;
    }

    function decisionTagClass(decision) {
        if (decision === 'FAVORABLE') return 'favorable';
        if (decision === 'DEFAVORABLE') return 'defavorable';
        return 'arevoir';
    }

    function clearDays() {
        const nodes = Array.from(calEl.querySelectorAll('.day'));
        for (const n of nodes) n.remove();
    }

    function renderMonth() {
        labelEl.textContent = `${monthNames[cursor.getMonth()]} ${cursor.getFullYear()}`;
        clearDays();

        const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
        const last = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0);
        const startOffset = mondayIndex(first);

        const start = new Date(first);
        start.setDate(first.getDate() - startOffset);

        for (let i = 0; i < 42; i++) {
            const d = new Date(start);
            d.setDate(start.getDate() + i);

            const isMuted = d.getMonth() !== cursor.getMonth();
            const isToday = d.getTime() === today.getTime();
            const key = isoDate(d);
            const items = deadlinesByDate.get(key) ?? [];

            const dayEl = document.createElement('div');
            dayEl.className = `day${isMuted ? ' muted' : ''}${isToday ? ' today' : ''}`;

            const numEl = document.createElement('div');
            numEl.className = 'day-num';
            numEl.textContent = String(d.getDate());
            dayEl.appendChild(numEl);

            if (items.length > 0) {
                const list = document.createElement('div');
                list.className = 'deadlines';
                for (const it of items) {
                    const a = document.createElement('a');
                    a.href = it.url;
                    a.className = 'deadline-pill';
                    a.title = `Evaluation #${it.id} — ${it.decision}`;

                    const left = document.createElement('span');
                    left.textContent = `#${it.id}`;
                    left.style.fontWeight = '800';

                    const tag = document.createElement('span');
                    tag.className = `tag ${decisionTagClass(it.decision)}`;
                    tag.textContent = it.decision === 'A_REVOIR' ? 'A revoir' : it.decision;

                    a.appendChild(left);
                    a.appendChild(tag);
                    list.appendChild(a);
                }
                dayEl.appendChild(list);
            }

            calEl.appendChild(dayEl);
        }

        void last;
    }

    btnPrev?.addEventListener('click', () => {
        cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
        renderMonth();
    });
    btnNext?.addEventListener('click', () => {
        cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
        renderMonth();
    });

    renderMonth();

    const ctx = document.getElementById('decisionPie');
    function getCountsFromEvaluations(list) {
        const c = { FAVORABLE: 0, DEFAVORABLE: 0, A_REVOIR: 0 };
        for (const e of list) {
            if (e.decision in c) c[e.decision]++;
        }
        return c;
    }

    function renderOrUpdatePie(counts) {
        const total = counts.FAVORABLE + counts.DEFAVORABLE + counts.A_REVOIR;
        if (!ctx || !window.Chart) return;

        const data = [counts.FAVORABLE, counts.DEFAVORABLE, counts.A_REVOIR];

        if (!pieChart) {
            if (total <= 0) return;
            pieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['FAVORABLE', 'DEFAVORABLE', 'A_REVOIR'],
                    datasets: [{
                        data,
                        backgroundColor: [
                            'rgba(20, 83, 45, 0.85)',
                            'rgba(127, 29, 29, 0.85)',
                            'rgba(154, 52, 18, 0.85)'
                        ],
                        borderColor: 'rgba(255,255,255,0.18)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#e2e8f0', boxWidth: 14, boxHeight: 14 }
                        },
                        tooltip: {
                            callbacks: {
                                label: (tip) => {
                                    const val = tip.raw ?? 0;
                                    const pct = total ? Math.round((val / total) * 100) : 0;
                                    return ` ${tip.label}: ${val} (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        } else {
            pieChart.data.datasets[0].data = data;
            pieChart.update();
        }
    }

    function setDashboardData(nextEvaluations, nextAllEvaluations, nextCounts) {
        evaluations = Array.isArray(nextEvaluations) ? nextEvaluations : [];
        allEvaluations = Array.isArray(nextAllEvaluations) ? nextAllEvaluations : [];
        rebuildDeadlinesMap();
        renderMonth();
        renderOrUpdatePie(nextCounts ?? getCountsFromEvaluations(allEvaluations));
    }

    rebuildDeadlinesMap();
    setDashboardData(evaluations, allEvaluations, getCountsFromEvaluations(allEvaluations));

    function formatFrDate(iso) {
        const parts = String(iso ?? '').split('-');
        if (parts.length !== 3) return String(iso ?? '');
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function showClosestReviewDeadlineReminder(list) {
        if (hasShownDeadlineReminder) return;
        hasShownDeadlineReminder = true;
        if (!Array.isArray(list) || !window.bootstrap) return;

        const todayLocal = new Date();
        todayLocal.setHours(0,0,0,0);

        const candidates = list
            .filter(e => e && e.decision === 'A_REVOIR' && e.reviewDeadline)
            .map(e => {
                const d = new Date(`${e.reviewDeadline}T00:00:00`);
                return { ...e, _d: d };
            })
            .filter(e => e._d instanceof Date && !Number.isNaN(e._d.getTime()) && e._d.getTime() >= todayLocal.getTime())
            .sort((a, b) => a._d.getTime() - b._d.getTime());

        if (candidates.length === 0) return;
        const next = candidates[0];

        const daysLeft = Math.round((next._d.getTime() - todayLocal.getTime()) / (24 * 60 * 60 * 1000));
        const daysLabel = daysLeft === 0 ? "aujourd'hui" : (daysLeft === 1 ? 'dans 1 jour' : `dans ${daysLeft} jours`);

        const dateEl = document.getElementById('deadlineReminderDate');
        const daysEl = document.getElementById('deadlineReminderDays');
        const evalEl = document.getElementById('deadlineReminderEval');
        const linkEl = document.getElementById('deadlineReminderLink');
        const modalEl = document.getElementById('deadlineReminderModal');

        if (!modalEl || !dateEl || !daysEl || !evalEl || !linkEl) return;

        dateEl.textContent = formatFrDate(next.reviewDeadline);
        daysEl.textContent = daysLabel;
        evalEl.textContent = next.candidatName ? `${next.candidatName} (#${next.id})` : `#${next.id}`;
        linkEl.href = next.url || '#';

        const modal = new bootstrap.Modal(modalEl, { backdrop: true, focus: true });
        modal.show();
    }

    showClosestReviewDeadlineReminder(allEvaluations);

    let abortController = null;
    let debounceTimer = null;

    // Bind pagination button clicks inside a container (works after innerHTML replacement)
    function bindPaginationButtons(container) {
        if (!container) return;
        container.querySelectorAll('.js-page-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const page = parseInt(btn.dataset.page, 10);
                if (!Number.isNaN(page)) {
                    currentPage = page;
                    refreshWithAjax();
                    // Scroll cards into view smoothly
                    cardsEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    }

    async function refreshWithAjax() {
        if (!formEl) return;

        const params = new URLSearchParams(new FormData(formEl));
        params.set('page', String(currentPage));

        if (abortController) abortController.abort();
        abortController = new AbortController();

        try {
            if (cardsEl) cardsEl.style.opacity = '0.6';
            if (paginationBarEl) paginationBarEl.style.opacity = '0.6';

            const res = await fetch(`${dataUrl}?${params.toString()}`, {
                headers: { 'Accept': 'application/json' },
                signal: abortController.signal
            });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const payload = await res.json();

            if (cardsEl && typeof payload.cardsHtml === 'string') {
                cardsEl.innerHTML = payload.cardsHtml;
            }
            if (paginationBarEl && typeof payload.paginationHtml === 'string') {
                paginationBarEl.innerHTML = payload.paginationHtml;
                bindPaginationButtons(paginationBarEl);
            }

            // Keep currentPage in sync with what the server actually returned
            if (typeof payload.currentPage === 'number') {
                currentPage = payload.currentPage;
            }

            setDashboardData(
                payload.evaluations,
                payload.allEvaluations ?? payload.evaluations,
                payload.counts
            );

            // Update the browser URL without a reload so back/refresh works
            try {
                const urlParams = new URLSearchParams(params);
                window.history.replaceState({}, '', `${formEl.action}?${urlParams.toString()}`);
            } catch (_) { /* ignore */ }

        } catch (e) {
            if (e && e.name === 'AbortError') return;
            console.error('AJAX refresh error:', e);
        } finally {
            if (cardsEl) cardsEl.style.opacity = '1';
            if (paginationBarEl) paginationBarEl.style.opacity = '1';
        }
    }

    function scheduleRefresh() {
        window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(refreshWithAjax, 250);
    }

    function resetFiltersToDefault() {
        if (!formEl) return;
        const q = formEl.querySelector('input[name="q"]');
        const sort = formEl.querySelector('select[name="orderBy"]');
        const decision = formEl.querySelector('select[name="decision"]');
        const recruteur = formEl.querySelector('select[name="recruteur"]');
        const candidat = formEl.querySelector('select[name="candidat"]');

        if (q) q.value = '';
        if (sort) sort.value = 'dateCreation';
        if (decision) decision.value = '';
        if (recruteur) recruteur.value = '';
        if (candidat) candidat.value = '';

        currentPage = 1;

        try {
            window.history.replaceState({}, '', formEl.action);
        } catch (_) { /* ignore */ }

        scheduleRefresh();
    }

    if (formEl) {
        formEl.addEventListener('submit', (ev) => {
            ev.preventDefault();
            currentPage = 1; // filter change always goes back to page 1
            scheduleRefresh();
        });
        formEl.addEventListener('input', () => { currentPage = 1; scheduleRefresh(); });
        formEl.addEventListener('change', () => { currentPage = 1; scheduleRefresh(); });
    }

    resetBtn?.addEventListener('click', resetFiltersToDefault);

    // Wire up the server-rendered pagination buttons on initial load
    bindPaginationButtons(paginationBarEl);
});
</script>
{% endblock %}
