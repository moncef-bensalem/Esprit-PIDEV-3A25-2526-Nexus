<form method="post" action="{{ path('app_departement_delete', {'id_departement': departement.id_departement}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');" style="display:inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ departement.id_departement) }}">
    <button class="btn-icon btn-delete" title="Supprimer"><i class="fas fa-trash"></i></button>
</form>
