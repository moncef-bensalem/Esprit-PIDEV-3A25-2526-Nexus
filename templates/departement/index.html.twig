{% extends 'base.html.twig' %}

{% block title %}Liste des Departements{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Liste des Departements</h1>
        <div class="top-actions">
            <a href="{{ path('app_departement_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Créer Nouveau
            </a>
        </div>
    </div>

    <div class="stat-card" style="text-align: left; overflow-x: auto;">
        <table class="table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); text-align: left;">
                    <th>Id departement</th>
                    <th>Libelle</th>

                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for departement in departements %}
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <td>{{ departement.id_departement }}</td>
                    <td>{{ departement.libelle }}</td>

                    <td class="talent-actions" style="margin-top:0;">
                        <a href="{{ path('app_departement_show', {'id_departement': departement.id_departement}) }}" class="btn-icon"><i class="fas fa-eye"></i></a>
                        <a href="{{ path('app_departement_edit', {'id_departement': departement.id_departement}) }}" class="btn-icon"><i class="fas fa-edit"></i></a>
                        {{ include('departement/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10" style="text-align: center; padding: 2rem;">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}