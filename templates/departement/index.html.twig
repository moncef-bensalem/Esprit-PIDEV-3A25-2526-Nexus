{% extends 'base.html.twig' %}

{% block title %}Liste des Departements{% endblock %}

{% block page_title %}Gestion des Départements{% endblock %}

{% block content %}
<style>
    .mc-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
    .mc-header-title { font-size: 1.4rem; font-weight: 700; color: #fff; margin-bottom: 4px; display: flex; align-items: center; }
    .mc-header-sub { font-size: .85rem; color: rgba(255,255,255,.4); }
    .mc-header-actions { display: flex; gap: 12px; }
    .btn-create { background: linear-gradient(135deg, #20b2aa, #0288d1); color: #fff; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; transition: transform 0.2s; }
    .btn-create:hover { transform: translateY(-2px); color:#fff; }
    
    .mc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .mc-card-dept { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 24px; transition: transform 0.2s, box-shadow 0.2s; display: flex; justify-content: space-between; align-items: center; }
    .mc-card-dept:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.4); border-color: rgba(32,178,170,0.2); }
    
    .mc-card-icon { width: 48px; height: 48px; border-radius: 12px; background: rgba(32,178,170,0.1); color: var(--cyan); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    
    .mc-btn-icon { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.05); transition: all 0.2s; text-decoration: none; border: none; cursor: pointer; margin-left: 6px; }
    .mc-btn-icon:hover { background: rgba(32,178,170,0.2); color: #fff; }
</style>

<div class="mc-header">
    <div>
        <div class="mc-header-title"><i class="fas fa-sitemap" style="color:var(--cyan); margin-right: 12px;"></i> Départements de l'entreprise</div>
        <div class="mc-header-sub">Structurez l'organisation interne pour le recrutement.</div>
    </div>
    <div class="mc-header-actions">
        <a href="{{ path('app_departement_new') }}" class="btn-create">
            <i class="fas fa-plus"></i> Nouveau Département
        </a>
    </div>
</div>

<!-- STATS DASHBOARD -->
<div class="row" style="margin-bottom: 30px; display: flex; gap: 20px;">
    <!-- Stat Cards -->
    <div style="flex: 1; display: flex; flex-direction: column; gap: 20px;">
        <div style="background: rgba(13,25,42,0.6); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; justify-content: center; height: 100%;">
            <div style="font-size: 0.9rem; color: rgba(255,255,255,0.5);">Total Offres d'Emploi</div>
            <div style="font-size: 2.5rem; font-weight: 700; color: var(--cyan);">{{ statGlobal.total }}</div>
        </div>
        <div style="background: rgba(13,25,42,0.6); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; justify-content: center; height: 100%;">
            <div style="font-size: 0.9rem; color: rgba(255,255,255,0.5);">Offres Actives (Publiées)</div>
            <div style="font-size: 2.5rem; font-weight: 700; color: #4CAF50;">{{ statGlobal.actives }}</div>
        </div>
    </div>
    
    <!-- Chart -->
    <div style="flex: 2; background: rgba(13,25,42,0.6); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); min-height: 250px; display: flex; justify-content: center; align-items: center;">
        {% if statGlobal.total > 0 %}
            <canvas id="deptPieChart" style="max-height: 220px;"></canvas>
        {% else %}
            <div style="color: rgba(255,255,255,0.3);">Pas assez de données pour le graphique</div>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (document.getElementById('deptPieChart')) {
        const ctx = document.getElementById('deptPieChart').getContext('2d');
        const labels = {{ chartLabels|raw }};
        const data = {{ chartData|raw }};
        
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: [
                        '#20b2aa', '#0288d1', '#7b1fa2', '#c2185b', '#fbc02d', '#00796b'
                    ],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { color: 'rgba(255,255,255,0.7)' } }
                }
            }
        });
    }
});
</script>
<!-- END STATS DASHBOARD -->

<h3 style="color: #fff; margin-bottom: 20px;">Liste des départements</h3>
<div class="mc-grid">
{% for departement in departements %}
    {% set deptStats = null %}
    {% for s in stats %}
        {% if s.libelle == departement.libelle %}
            {% set deptStats = s %}
        {% endif %}
    {% endfor %}

    <div class="mc-card-dept">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div class="mc-card-icon">
                <i class="fas fa-building"></i>
            </div>
            <div>
                <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #fff;">{{ departement.libelle }}</h3>
                <div style="font-size: 0.8rem; color: rgba(255,255,255,0.4); margin-top: 4px;">Code Dept: #{{ departement.id_departement }} &nbsp;&bull;&nbsp; {{ deptStats.total_offres ?? 0 }} Offres</div>
            </div>
        </div>

        <div style="display:flex; align-items:center;">
            <a href="{{ path('app_departement_show', {'id_departement': departement.id_departement}) }}" class="mc-btn-icon" title="Voir"><i class="fas fa-eye"></i></a>
            <a href="{{ path('app_departement_edit', {'id_departement': departement.id_departement}) }}" class="mc-btn-icon" title="Modifier"><i class="fas fa-edit"></i></a>
            <form method="post" action="{{ path('app_departement_delete', {'id_departement': departement.id_departement}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce département ?');" style="display:inline-block; margin:0; margin-left:6px;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ departement.id_departement) }}">
                <button class="mc-btn-icon" style="color: #ef5350;"><i class="fas fa-trash"></i></button>
            </form>
        </div>
    </div>
{% else %}
    <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: rgba(13,25,42,0.4); border: 1px dashed rgba(255,255,255,0.1); border-radius: 16px;">
        <i class="fas fa-sitemap" style="font-size: 3rem; color: rgba(255,255,255,0.1); margin-bottom: 16px;"></i>
        <h3 style="color: rgba(255,255,255,0.5); font-weight: 500;">Aucun département configuré.</h3>
        <a href="{{ path('app_departement_new') }}" class="btn-create" style="margin-top: 16px;">Créer le premier</a>
    </div>
{% endfor %}
</div>
{% endblock %}
