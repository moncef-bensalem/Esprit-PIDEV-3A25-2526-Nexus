{% extends 'base.html.twig' %}

{% block title %}Liste des Departements{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Liste des Departements</h1>
        <div class="top-actions">
            <a href="{{ path('app_departement_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Créer Nouveau
            </a>
        </div>
    </div>

    <div class="talents-grid">
    {% for departement in departements %}
        <div class="talent-card" style="display: flex; align-items: center; justify-content: space-between; padding: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div class="avatar-circle theme-blue" style="width: 40px; height: 40px; font-size: 1rem; flex-shrink: 0;">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h3 class="talent-name" style="margin-bottom: 0.2rem; font-size: 1.1rem;">{{ departement.libelle }}</h3>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">ID: #{{ departement.id_departement }}</div>
                </div>
            </div>

            <div class="talent-actions" style="border-top: none; padding-top: 0; margin-top: 0;">
                <a href="{{ path('app_departement_show', {'id_departement': departement.id_departement}) }}" class="btn-icon"><i class="fas fa-eye"></i></a>
                <a href="{{ path('app_departement_edit', {'id_departement': departement.id_departement}) }}" class="btn-icon"><i class="fas fa-edit"></i></a>
                {{ include('departement/_delete_form.html.twig') }}
            </div>
        </div>
    {% else %}
        <div class="stat-card" style="grid-column: 1 / -1; text-align: center;">
            <p style="font-size: 1.2rem; margin-bottom: 1rem;">Aucun département trouvé.</p>
            <a href="{{ path('app_departement_new') }}" class="btn btn-primary">Créer le premier</a>
        </div>
    {% endfor %}
    </div>
</div>
{% endblock %}
