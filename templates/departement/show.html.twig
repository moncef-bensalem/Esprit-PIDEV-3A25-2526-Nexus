{% extends 'base.html.twig' %}

{% block title %}Departement{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Détails Departement</h1>
        <div class="top-actions">
            <a href="{{ path('app_departement_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_departement_edit', {'id_departement': departement.id_departement}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Éditer
            </a>
            {{ include('departement/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="detail-card" style="margin: 0 auto; max-width: 600px;">
        <div class="detail-row">
            <div class="detail-label">ID Département</div>
            <div class="detail-value text-muted">#{{ departement.id_departement }}</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Nom du Département</div>
            <div class="detail-value" style="font-size: 1.2rem; font-weight: 700; color: var(--neon-blue);">
                <i class="fas fa-building" style="margin-right: 0.5rem; opacity: 0.7;"></i>{{ departement.libelle }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
