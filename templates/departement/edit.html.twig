{% extends 'base.html.twig' %}

{% block title %}Éditer Departement{% endblock %}

{% block page_title %}Mettre à jour le Département{% endblock %}

{% block content %}
<div class="mc-header">
    <div>
        <div class="mc-header-title"><i class="fas fa-edit" style="color:var(--cyan); margin-right: 12px;"></i> Modifier le département</div>
        <div class="mc-header-sub">Mettez à jour le nom ou les spécificités de cette entité.</div>
    </div>
    <div class="mc-header-actions" style="display:flex; align-items:center; gap: 16px;">
        <a href="{{ path('app_departement_index') }}" style="color:rgba(255,255,255,0.6); text-decoration:none; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <div style="background:rgba(239,83,80,.1); border-radius:10px; padding: 6px 12px;">
            {{ include('departement/_delete_form.html.twig') }}
        </div>
    </div>
</div>

<div style="max-width: 800px; margin: 0 auto;">
    {{ include('departement/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
</div>
{% endblock %}
