{% extends 'base.html.twig' %}

{% block title %}Assistant IA Talent{% endblock %}
{% block page_title %}🤖 Assistant IA Talent{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --cyan: #20b2aa;
        --cyan-glow: rgba(32,178,170,.35);
        --bg-deep: #070e17;
        --bg-card: rgba(13,25,42,.9);
        --border: rgba(32,178,170,.2);
    }

    .chatbot-wrapper {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 130px);
        max-width: 860px;
        margin: 0 auto;
    }

    /* ── Header ── */
    .chat-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 24px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-bottom: none;
        border-radius: 18px 18px 0 0;
        backdrop-filter: blur(20px);
    }
    .chat-avatar-bot {
        width: 46px; height: 46px; border-radius: 14px;
        background: linear-gradient(135deg, #20b2aa, #0288d1);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem;
        box-shadow: 0 0 20px var(--cyan-glow);
        flex-shrink: 0;
    }
    .chat-header-info h2 { font-size: 1rem; font-weight: 700; margin: 0; color: #fff; }
    .chat-header-info p  { font-size: .75rem; color: var(--cyan); margin: 0; }
    .chat-status {
        margin-left: auto;
        display: flex; align-items: center; gap: 6px;
        font-size: .72rem; color: var(--cyan);
        background: rgba(32,178,170,.1);
        border: 1px solid rgba(32,178,170,.25);
        padding: 4px 12px; border-radius: 20px;
    }
    .status-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #4caf50;
        animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

    /* ── Messages area ── */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px 24px;
        background: rgba(7,14,23,.7);
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 14px;
        scrollbar-width: thin;
        scrollbar-color: rgba(32,178,170,.3) transparent;
    }
    .chat-messages::-webkit-scrollbar { width: 4px; }
    .chat-messages::-webkit-scrollbar-thumb { background: rgba(32,178,170,.3); border-radius: 4px; }

    /* ── Bubbles ── */
    .msg {
        display: flex;
        gap: 10px;
        animation: fadeInUp .3s ease;
        max-width: 80%;
    }
    @keyframes fadeInUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

    .msg.user  { align-self: flex-end; flex-direction: row-reverse; }
    .msg.bot   { align-self: flex-start; }

    .msg-avatar {
        width: 34px; height: 34px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: .85rem; flex-shrink: 0;
    }
    .msg.bot  .msg-avatar { background: linear-gradient(135deg, #20b2aa, #0288d1); box-shadow: 0 0 12px var(--cyan-glow); }
    .msg.user .msg-avatar { background: linear-gradient(135deg, #7c4dff, #448aff); }

    .msg-bubble {
        padding: 12px 16px;
        border-radius: 16px;
        font-size: .87rem;
        line-height: 1.6;
        max-width: 100%;
        word-break: break-word;
    }
    .msg.bot  .msg-bubble {
        background: rgba(32,178,170,.08);
        border: 1px solid rgba(32,178,170,.2);
        color: rgba(255,255,255,.9);
        border-radius: 4px 16px 16px 16px;
    }
    .msg.user .msg-bubble {
        background: linear-gradient(135deg, rgba(124,77,255,.25), rgba(68,138,255,.2));
        border: 1px solid rgba(124,77,255,.3);
        color: rgba(255,255,255,.95);
        border-radius: 16px 4px 16px 16px;
    }
    .msg-bubble pre {
        margin: 0;
        white-space: pre-wrap;
        font-family: inherit;
    }

    /* Typing indicator */
    .typing-indicator {
        display: flex;
        gap: 5px;
        align-items: center;
        padding: 10px 14px;
    }
    .typing-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--cyan);
        animation: pulse 1.4s ease-in-out infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: .2s; }
    .typing-dot:nth-child(3) { animation-delay: .4s; }
    @keyframes pulse { 0%,100%{transform:scale(.7);opacity:.5} 50%{transform:scale(1);opacity:1} }

    /* ── Suggestions rapides ── */
    .suggestions {
        padding: 14px 24px;
        background: rgba(7,14,23,.7);
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .suggestion-chip {
        padding: 7px 14px;
        border-radius: 20px;
        border: 1px solid rgba(32,178,170,.3);
        background: rgba(32,178,170,.06);
        color: var(--cyan);
        font-size: .78rem;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }
    .suggestion-chip:hover {
        background: rgba(32,178,170,.15);
        border-color: var(--cyan);
        transform: translateY(-1px);
    }

    /* ── Input area ── */
    .chat-input-area {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px 20px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-top: 1px solid rgba(32,178,170,.3);
        border-radius: 0 0 18px 18px;
    }
    #chatInput {
        flex: 1;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(32,178,170,.2);
        border-radius: 12px;
        color: #fff;
        padding: 12px 16px;
        font-size: .88rem;
        outline: none;
        transition: border-color .2s;
        resize: none;
        font-family: inherit;
        max-height: 100px;
    }
    #chatInput:focus { border-color: var(--cyan); background: rgba(32,178,170,.05); }
    #chatInput::placeholder { color: rgba(255,255,255,.3); }

    #sendBtn {
        width: 46px; height: 46px;
        border: none; border-radius: 12px;
        background: linear-gradient(135deg, #20b2aa, #0288d1);
        color: #fff;
        font-size: 1rem;
        cursor: pointer;
        transition: all .2s;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 15px var(--cyan-glow);
    }
    #sendBtn:hover { transform: scale(1.05); box-shadow: 0 6px 20px var(--cyan-glow); }
    #sendBtn:active { transform: scale(.96); }
    #sendBtn:disabled { opacity: .5; cursor: not-allowed; transform: none; }

    /* ── Welcome message ── */
    .welcome-msg {
        text-align: center;
        padding: 32px 20px;
        color: rgba(255,255,255,.4);
    }
    .welcome-msg .welcome-icon {
        font-size: 3rem;
        margin-bottom: 12px;
        display: block;
        animation: float 3s ease-in-out infinite;
    }
    @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
    .welcome-msg h3 { color: rgba(255,255,255,.8); font-size: 1.1rem; margin-bottom: 8px; }
    .welcome-msg p  { font-size: .83rem; line-height: 1.7; }
    .btn-mic {
        width: 46px; height: 46px;
        border: 1px solid rgba(32,178,170,.3); border-radius: 12px;
        background: transparent;
        color: var(--cyan);
        font-size: 1.1rem;
        cursor: pointer;
        transition: all .2s;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .btn-mic:hover { background: rgba(32,178,170,.1); }
    .btn-mic.recording {
        background: rgba(220, 38, 38, 0.15);
        color: #ef4444; border-color: #ef4444;
        animation: pulseRecord 1.5s infinite;
    }
    @keyframes pulseRecord { 0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); } 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); } }

    .btn-speaker {
        background: none; border: none;
        color: rgba(255,255,255,0.4);
        cursor: pointer; font-size: 1rem;
        padding: 6px;
        transition: all 0.2s;
        align-self: flex-end;
    }
    .btn-speaker:hover { color: var(--cyan); transform: scale(1.1); }
</style>
{% endblock %}

{% block content %}
<div class="chatbot-wrapper">

    {# ── Header ── #}
    <div class="chat-header">
        <div class="chat-avatar-bot">🤖</div>
        <div class="chat-header-info">
            <h2>Assistant IA Talent — Nexus</h2>
            <p>Propulsé par Groq · Llama 3</p>
        </div>
        <div class="chat-status">
            <div class="status-dot"></div>
            En ligne
        </div>
    </div>

    {# ── Messages ── #}
    <div class="chat-messages" id="chatMessages">
        <div class="welcome-msg" id="welcomeMsg">
            <span class="welcome-icon">🧠</span>
            <h3>Bonjour, je suis votre assistant RH intelligent !</h3>
            <p>
                Je peux vous renseigner sur les <strong style="color:var(--cyan)">postes disponibles</strong>,
                décrire un <strong style="color:var(--cyan)">poste</strong>,
                vous donner des informations sur les <strong style="color:var(--cyan)">salaires en Tunisie</strong>
                et les <strong style="color:var(--cyan)">compétences requises</strong> pour un métier.
            </p>
        </div>
    </div>

    {# ── Suggestions rapides ── #}
    <div class="suggestions" id="suggestionsBar">
        <button class="suggestion-chip" onclick="sendSuggestion('Quels sont les postes disponibles ?')">
            📋 Postes disponibles
        </button>
        <button class="suggestion-chip" onclick="sendSuggestion('C\'est quoi le poste de Développeur ?')">
            💼 Décrire un poste
        </button>
        <button class="suggestion-chip" onclick="sendSuggestion('Quel salaire pour un Développeur en Tunisie ?')">
            💰 Salaire en Tunisie
        </button>
        <button class="suggestion-chip" onclick="sendSuggestion('Quelles sont les compétences d\'un Développeur ?')">
            🛠️ Compétences requises
        </button>
    </div>

    {# ── Saisie ── #}
    <div class="chat-input-area">
        <button id="micBtn" aria-label="Microphone" class="btn-mic" title="Parler">
            <i class="fa-solid fa-microphone"></i>
        </button>
        <textarea
            id="chatInput"
            placeholder="Posez votre question (ex: Quels sont les postes disponibles ?)"
            rows="1"
            aria-label="Message chatbot"
        ></textarea>
        <button id="sendBtn" aria-label="Envoyer">
            <i class="fa fa-paper-plane"></i>
        </button>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    const input    = document.getElementById('chatInput');
    const sendBtn  = document.getElementById('sendBtn');
    const messages = document.getElementById('chatMessages');
    const micBtn   = document.getElementById('micBtn');
    const askUrl   = '{{ path("chatbot_ask") }}';

    // Auto-resize textarea
    input.addEventListener('input', () => {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 100) + 'px';
    });

    // Send on Enter (Shift+Enter = newline)
    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    sendBtn.addEventListener('click', sendMessage);

    function sendMessage() {
        const text = input.value.trim();
        if (!text) return;

        // Masquer welcome + suggestions après 1er message
        const welcome = document.getElementById('welcomeMsg');
        if (welcome) welcome.remove();

        // Afficher message utilisateur
        appendMessage('user', text);
        input.value = '';
        input.style.height = 'auto';
        sendBtn.disabled = true;

        // Afficher "typing"
        const typingId = appendTyping();

        fetch(askUrl, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ message: text }),
        })
        .then(r => r.json())
        .then(data => {
            removeTyping(typingId);
            if (data.error) {
                appendMessage('bot', '⚠️ ' + data.error);
            } else {
                appendMessage('bot', data.response);
                speakText(data.response); // Auto-read the response
            }
        })
        .catch(() => {
            removeTyping(typingId);
            appendMessage('bot', '⚠️ Une erreur réseau est survenue. Veuillez réessayer.');
        })
        .finally(() => {
            sendBtn.disabled = false;
            input.focus();
        });
    }

    function appendMessage(role, text) {
        const msgDiv = document.createElement('div');
        msgDiv.className = 'msg ' + role;

        const avatarDiv = document.createElement('div');
        avatarDiv.className = 'msg-avatar';
        avatarDiv.textContent = role === 'bot' ? '🤖' : '👤';

        const bubbleDiv = document.createElement('div');
        bubbleDiv.className = 'msg-bubble';

        // Format: convert newlines to <br>
        const pre = document.createElement('pre');
        pre.textContent = text;
        bubbleDiv.appendChild(pre);

        msgDiv.appendChild(avatarDiv);

        // Si c'est le bot, on ajoute le bouton Haut-Parleur à côté de la bulle
        if (role === 'bot' && !text.startsWith('⚠️')) {
            const contentWrapper = document.createElement('div');
            contentWrapper.style.display = 'flex';
            contentWrapper.style.gap = '8px';
            contentWrapper.style.alignItems = 'flex-start';

            const speakerBtn = document.createElement('button');
            speakerBtn.className = 'btn-speaker';
            speakerBtn.title = 'Lire le message à voix haute';
            speakerBtn.innerHTML = '<i class="fa-solid fa-volume-high"></i>';
            speakerBtn.onclick = () => speakText(text);

            contentWrapper.appendChild(bubbleDiv);
            contentWrapper.appendChild(speakerBtn);
            msgDiv.appendChild(contentWrapper);
        } else {
            msgDiv.appendChild(bubbleDiv);
        }

        messages.appendChild(msgDiv);
        scrollToBottom();
    }

    function appendTyping() {
        const id = 'typing-' + Date.now();
        const msgDiv = document.createElement('div');
        msgDiv.className = 'msg bot';
        msgDiv.id = id;

        const avatarDiv = document.createElement('div');
        avatarDiv.className = 'msg-avatar';
        avatarDiv.textContent = '🤖';

        const bubbleDiv = document.createElement('div');
        bubbleDiv.className = 'msg-bubble';

        const indicator = document.createElement('div');
        indicator.className = 'typing-indicator';
        indicator.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';

        bubbleDiv.appendChild(indicator);
        msgDiv.appendChild(avatarDiv);
        msgDiv.appendChild(bubbleDiv);
        messages.appendChild(msgDiv);
        scrollToBottom();
        return id;
    }

    function removeTyping(id) {
        const el = document.getElementById(id);
        if (el) el.remove();
    }

    function scrollToBottom() {
        messages.scrollTop = messages.scrollHeight;
    }

    // Suggestions rapides
    window.sendSuggestion = function(text) {
        input.value = text;
        sendMessage();
    };

    // ==========================================
    // 🎤 SPEECH TO TEXT (Microphone)
    // ==========================================
    let recognition = null;
    let isRecording = false;

    // Check compatibility
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.interimResults = false; // We only want final results for simplicity
        
        recognition.onstart = () => {
            isRecording = true;
            micBtn.classList.add('recording');
            input.placeholder = "Écoute en cours...";
        };
        
        recognition.onresult = (event) => {
            const transcript = event.results[0][0].transcript;
            
            // Append with a space if there's already text
            input.value += (input.value.length > 0 ? ' ' : '') + transcript;
            input.dispatchEvent(new Event('input')); // trigger resize
        };
        
        recognition.onerror = (event) => {
            console.error('Erreur micro :', event.error);
            stopRecording();
        };
        
        recognition.onend = () => {
            stopRecording();
        };
    } else {
        micBtn.style.display = 'none'; // Unsupported browser
    }

    function stopRecording() {
        if (recognition && isRecording) {
            recognition.stop();
            isRecording = false;
            micBtn.classList.remove('recording');
            input.placeholder = "Posez votre question (ex: Quels sont les postes disponibles ?)";
        }
    }

    // Toggle button
    micBtn.addEventListener('click', () => {
        if (!recognition) return;
        if (isRecording) {
            stopRecording();
        } else {
            recognition.start();
        }
    });

    // ==========================================
    // 🔊 TEXT TO SPEECH (Speaker)
    // ==========================================
    function speakText(text) {
        if (!('speechSynthesis' in window)) {
            console.error("Text-to-Speech non supporté.");
            return;
        }
        
        // Stop any current reading to prevent overlap
        window.speechSynthesis.cancel();
        
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR'; // Langue du chatbot
        utterance.rate = 1.0;     // Vitesse de lecture (1 = normal)
        utterance.pitch = 1.0;    // Tonalité
        
        window.speechSynthesis.speak(utterance);
    }
})();
</script>
{% endblock %}
