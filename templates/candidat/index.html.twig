{% extends 'admin_layout.html.twig' %}

{% block title %}Liste des Candidats{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Liste des Candidats</h1>
        <div class="top-actions">
            <a href="{{ path('app_candidat_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Créer Nouveau
            </a>
        </div>
    </div>

    <div class="stat-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Id candidat</th>
                    <th>Nom complet</th>
                    <th>Email contact</th>
                    <th>Chemin cv</th>
                    <th>Date ajout</th>

                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for candidat in candidats %}
                <tr>
                    <td>{{ candidat.id_candidat }}</td>
                    <td>{{ candidat.nom_complet }}</td>
                    <td>{{ candidat.email_contact }}</td>
                    <td>{{ candidat.chemin_cv }}</td>
                    <td>{{ candidat.date_ajout ? candidat.date_ajout|date('Y-m-d') : '' }}</td>

                    <td class="talent-actions">
                        <a href="{{ path('app_candidat_show', {'id_candidat': candidat.id_candidat}) }}" class="btn-icon"><i class="fas fa-eye"></i></a>
                        <a href="{{ path('app_candidat_edit', {'id_candidat': candidat.id_candidat}) }}" class="btn-icon"><i class="fas fa-edit"></i></a>
                        {{ include('candidat/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
