{% extends 'base.html.twig' %}

{% block title %}Email envoyé — Nexus{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: 'Inter', sans-serif;
        background: #070e17; min-height: 100vh;
        display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .bg-scene { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
    .bg-scene::before {
        content: ''; position: absolute; width: 700px; height: 700px; border-radius: 50%;
        background: radial-gradient(circle, rgba(32,178,170,.15) 0%, transparent 70%);
        top: -200px; left: -200px; animation: pulse1 9s ease-in-out infinite;
    }
    .bg-scene::after {
        content: ''; position: absolute; width: 600px; height: 600px; border-radius: 50%;
        background: radial-gradient(circle, rgba(2,100,180,.13) 0%, transparent 70%);
        bottom: -150px; right: -100px; animation: pulse2 11s ease-in-out infinite;
    }
    @keyframes pulse1 { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15) translate(30px,20px)} }
    @keyframes pulse2 { 0%,100%{transform:scale(1)} 50%{transform:scale(1.2) translate(-20px,-30px)} }
    .grid-bg {
        position: fixed; inset: 0; z-index: 0;
        background-image: linear-gradient(rgba(32,178,170,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(32,178,170,.04) 1px, transparent 1px);
        background-size: 50px 50px;
    }
    .particles { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .particle {
        position: absolute; width: 3px; height: 3px; border-radius: 50%;
        background: rgba(32,178,170,.6); animation: float linear infinite;
    }
    @keyframes float {
        0%{transform:translateY(100vh);opacity:0} 10%{opacity:1} 90%{opacity:1} 100%{transform:translateY(-100px) translateX(60px);opacity:0}
    }

    .check-wrapper {
        position: relative; z-index: 10;
        width: 100%; max-width: 420px; padding: 20px;
        animation: slideUp .6s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes slideUp { from{opacity:0;transform:translateY(40px)} to{opacity:1;transform:translateY(0)} }

    .check-card {
        background: rgba(13,25,42,.85);
        backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(32,178,170,.2); border-radius: 24px;
        padding: 44px 36px 36px; text-align: center;
        box-shadow: 0 0 0 1px rgba(32,178,170,.08), 0 25px 60px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.05);
    }

    .logo-wrapper { margin-bottom: 28px; }
    .logo-ring {
        display: inline-flex; align-items: center; justify-content: center;
        width: 80px; height: 80px; border-radius: 50%;
        border: 1.5px solid rgba(32,178,170,.35);
        box-shadow: 0 0 24px rgba(32,178,170,.18), inset 0 0 24px rgba(32,178,170,.06);
        margin-bottom: 12px; animation: glow 3s ease-in-out infinite; overflow: hidden;
    }
    .logo-ring img { width: 64px; height: 64px; object-fit: contain; border-radius: 50%; }
    @keyframes glow {
        0%,100%{box-shadow:0 0 20px rgba(32,178,170,.2),inset 0 0 20px rgba(32,178,170,.05)}
        50%{box-shadow:0 0 40px rgba(32,178,170,.35),inset 0 0 30px rgba(32,178,170,.1)}
    }
    .logo-title { font-size: 1.3rem; font-weight: 700; color: #fff; }

    /* Success animation */
    .success-icon {
        width: 72px; height: 72px; border-radius: 50%; margin: 0 auto 20px;
        background: rgba(32,178,170,.12); border: 1.5px solid rgba(32,178,170,.35);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; color: #20b2aa;
        animation: successPop .5s .2s cubic-bezier(.34,1.56,.64,1) both;
    }
    @keyframes successPop { from{opacity:0;transform:scale(.5)} to{opacity:1;transform:scale(1)} }

    h1 { font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: 12px; }
    .desc { font-size: .87rem; color: rgba(255,255,255,.45); line-height: 1.7; margin-bottom: 28px; }
    .desc strong { color: rgba(32,178,170,.85); }

    .expiry-badge {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(32,178,170,.08); border: 1px solid rgba(32,178,170,.2);
        border-radius: 20px; padding: 8px 16px; margin-bottom: 28px;
        font-size: .8rem; color: rgba(32,178,170,.8);
    }
    .expiry-badge i { font-size: .85rem; }

    .btn-back {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 12px 24px; border-radius: 12px; text-decoration: none;
        background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12);
        color: rgba(255,255,255,.8); font-size: .88rem; font-weight: 500;
        transition: all .25s; font-family: 'Inter', sans-serif;
    }
    .btn-back:hover {
        background: rgba(32,178,170,.1); border-color: rgba(32,178,170,.3);
        color: #fff; transform: translateY(-1px);
    }

    @media(max-width:500px){ .check-card{ padding:32px 20px 28px; } }
</style>
{% endblock %}

{% block body %}
<div class="bg-scene"></div>
<div class="grid-bg"></div>
<div class="particles" id="particles"></div>

<main class="check-wrapper">
    <div class="check-card">

        <div class="logo-wrapper">
            <div class="logo-ring">
                <img src="{{ asset('nexus.jpg') }}" alt="Logo Nexus">
            </div>
            <div class="logo-title">Nexus</div>
        </div>

        <div class="success-icon">
            <i class="fa fa-envelope-open-text"></i>
        </div>

        <h1>Email envoyé !</h1>

        <p class="desc">
            Un lien de réinitialisation a été envoyé à votre adresse email.<br>
            Vérifiez votre boîte de réception et vos <strong>spams</strong> si vous ne le trouvez pas.
        </p>

        <div class="expiry-badge">
            <i class="fa fa-clock"></i>
            Lien valide pendant {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}
        </div>

        <br>
        <a href="{{ path('app_login') }}" class="btn-back">
            <i class="fa fa-arrow-left"></i> Retour à la connexion
        </a>

    </div>
</main>

<script>
(function(){
    const c = document.getElementById('particles');
    for(let i=0;i<14;i++){
        const p=document.createElement('div'); p.className='particle';
        p.style.cssText=`left:${Math.random()*100}%;width:${Math.random()*3+1}px;height:${Math.random()*3+1}px;opacity:${Math.random()*.5+.2};animation-duration:${Math.random()*12+8}s;animation-delay:${Math.random()*10}s`;
        c.appendChild(p);
    }
})();
</script>
{% endblock %}
