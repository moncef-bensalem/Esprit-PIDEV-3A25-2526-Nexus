{% extends 'base.html.twig' %}

{% block title %}Reset password{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Choose a new password</div>
                <div class="card-body">
                    {{ form_start(resetForm) }}
                        <div class="mb-3">{{ form_row(resetForm.plainPassword.first) }}</div>
                        <div class="mb-3">{{ form_row(resetForm.plainPassword.second) }}</div>
                        <button class="btn btn-success">Update password</button>
                    {{ form_end(resetForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
