<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #fff; padding: 20px; }
        label { font-weight: 500; font-size: 0.85rem; color: #444; margin-bottom: 4px; }
        .form-control, .form-select { font-size: 0.88rem; }
        .invalid-feedback { display: block; }

        /* Erreurs globales bien visibles */
        .form-global-error {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-left: 4px solid #e67e00;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: .86rem;
            color: #664d03;
            font-weight: 500;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    {% include 'planification/_form.html.twig' %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Scroller en haut si erreur de validation
        if (document.querySelector('.form-global-error, .invalid-feedback')) {
            window.scrollTo(0, 0);
        }
    </script>
</body>
</html>
