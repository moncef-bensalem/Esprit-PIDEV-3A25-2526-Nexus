<style>
.form-global-error {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-left: 4px solid #f59e0b;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: .86rem;
    color: #fcd34d;
    margin-bottom: 8px;
}
.form-global-error svg { flex-shrink: 0; color: #f59e0b; }

/* Premium Form Elements */
.form-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted, #6b8ba4);
    margin-bottom: 6px;
    letter-spacing: 0.02em;
}

.form-control, .form-select {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: var(--text, #e2eaf4) !important;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 0.88rem;
    box-shadow: none !important;
    transition: all 0.25s ease;
}

.form-control:focus, .form-select:focus {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(79, 195, 247, 0.5) !important;
    box-shadow: 0 0 0 4px rgba(79, 195, 247, 0.1) !important;
}

.form-select option {
    background: var(--surface, #0d1d30);
    color: var(--text, #e2eaf4);
}

.form-control::placeholder {
    color: rgba(255, 255, 255, 0.3);
}

.btn-primary {
    background: linear-gradient(135deg, #4fc3f7, #0288d1);
    border: none;
    color: #fff;
    font-weight: 600;
    padding: 10px 24px;
    border-radius: 9px;
    box-shadow: 0 4px 14px rgba(79, 195, 247, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
}
.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(79, 195, 247, 0.4);
}

.btn-outline-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2eaf4;
    font-weight: 500;
    padding: 10px 20px;
    border-radius: 9px;
    transition: all 0.2s;
}
.btn-outline-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
}

.btn-map-loc {
    background: rgba(79, 195, 247, 0.12);
    border: 1px solid rgba(79, 195, 247, 0.35);
    border-left: none;
    color: #4fc3f7;
    border-radius: 0 10px 10px 0;
    padding: 0 13px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
}
.btn-map-loc:hover {
    background: rgba(79, 195, 247, 0.25);
    color: #fff;
}
.input-group .form-control {
    border-radius: 10px 0 0 10px !important;
}
</style>

{{ form_start(form) }}

{# Erreurs globales (Expression, etc.) #}
{% set globalErrors = form.vars.errors %}
{% if form.vars.submitted and globalErrors|length > 0 %}
<div class="mb-3">
    {% for error in globalErrors %}
    <div class="form-global-error">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
        {{ error.message }}
    </div>
    {% endfor %}
</div>
{% endif %}

<div class="row g-3">
    <div class="col-md-6">
        {{ form_label(form.typeEvent) }}
        {{ form_widget(form.typeEvent) }}
        {{ form_errors(form.typeEvent) }}
    </div>
    <div class="col-md-6">
        {{ form_label(form.statut) }}
        {{ form_widget(form.statut) }}
        {{ form_errors(form.statut) }}
    </div>
    <div class="col-md-4">
        {{ form_label(form.date) }}
        {{ form_widget(form.date) }}
        {{ form_errors(form.date) }}
    </div>
    <div class="col-md-4">
        {{ form_label(form.heureDebut) }}
        {{ form_widget(form.heureDebut) }}
        {{ form_errors(form.heureDebut) }}
    </div>
    <div class="col-md-4">
        {{ form_label(form.heureFin) }}
        {{ form_widget(form.heureFin) }}
        {{ form_errors(form.heureFin) }}
    </div>
    <div class="col-md-6">
        {{ form_label(form.mode) }}
        {{ form_widget(form.mode) }}
        {{ form_errors(form.mode) }}
    </div>
    <div class="col-md-6">
        {{ form_label(form.localisation) }}
        <div class="input-group">
            {{ form_widget(form.localisation, {'attr': {'id': 'planification_localisation', 'class': 'form-control'}}) }}
            <button type="button" id="open-map-btn" class="btn btn-map-loc" title="Voir sur Mapbox">
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                </svg>
            </button>
        </div>
        {{ form_errors(form.localisation) }}
    </div>
    <div class="col-12">
        {{ form_label(form.lienMeeting) }}
        {{ form_widget(form.lienMeeting) }}
        {{ form_errors(form.lienMeeting) }}
    </div>
    <div class="col-12">
        {{ form_label(form.description) }}
        {{ form_widget(form.description) }}
        {{ form_errors(form.description) }}
    </div>
    <div class="col-md-6">
        {{ form_label(form.candidature) }}
        {{ form_widget(form.candidature) }}
        {{ form_errors(form.candidature) }}
    </div>
    <div class="col-md-6">
        {{ form_label(form.user) }}
        {{ form_widget(form.user) }}
        {{ form_errors(form.user) }}
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a href="{{ path('planification_index') }}" class="btn btn-outline-secondary">Annuler</a>
    <button type="submit" class="btn btn-primary px-4">Enregistrer</button>
</div>

{{ form_end(form) }}
