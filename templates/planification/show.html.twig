{% extends 'base.html.twig' %}

{% block title %}Planification #{{ planification.idEvent }}{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ── Reset & base ───────────────────────── */
:root {
    --bg:       #07111f;
    --surface:  #0d1d30;
    --surface2: #102136;
    --border:   rgba(79,195,247,.15);
    --accent:   #4fc3f7;
    --accent-hover: #0288d1;
    --accent2:  #6c63ff;
    --text:     #e2eaf4;
    --muted:    #6b8ba4;
    --radius:   18px;
    --shadow:   0 8px 32px rgba(0,0,0,.45);
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', 'Segoe UI', sans-serif;
    min-height: 100vh;
}

body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
        radial-gradient(ellipse 80% 60% at 15% 10%, rgba(79,195,247,.07) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 80%, rgba(108,99,255,.07) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
}

.page-wrapper {
    position: relative;
    z-index: 1;
    padding: 40px 20px;
    animation: fadeUp .5s cubic-bezier(.22,1,.36,1) both;
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}

.detail-card {
    background: rgba(13, 29, 48, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 40px 45px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
}

.detail-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
}

.header-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.badge-statut {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 20px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.badge-statut.bg-success { background: rgba(34, 197, 94, 0.15) !important; color: #4ade80 !important; border: 1px solid rgba(34, 197, 94, 0.3); }
.badge-statut.bg-danger { background: rgba(239, 68, 68, 0.15) !important; color: #f87171 !important; border: 1px solid rgba(239, 68, 68, 0.3); }
.badge-statut.bg-secondary { background: rgba(148, 163, 184, 0.15) !important; color: #cbd5e1 !important; border: 1px solid rgba(148, 163, 184, 0.3); }
.badge-statut.bg-warning { background: rgba(245, 158, 11, 0.15) !important; color: #fbbf24 !important; border: 1px solid rgba(245, 158, 11, 0.3); }

.info-row {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: background 0.2s;
    border-radius: 8px;
}
.info-row:hover {
    background: rgba(255, 255, 255, 0.02);
}

.info-row:last-child {
    border-bottom: none;
}

.info-label {
    width: 170px;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 500;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
}
.info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(79, 195, 247, 0.1);
    color: var(--accent);
    border-radius: 8px;
    font-size: 1rem;
}

.info-value {
    font-weight: 500;
    color: var(--text);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
}

.info-value a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
}
.info-value a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
}

.btn-edit {
    background: linear-gradient(135deg, #4fc3f7, #0288d1);
    color: #fff;
    border: none;
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(79, 195, 247, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
}
.btn-edit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(79, 195, 247, 0.4);
    color: #fff;
}
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">
    <div class="container" style="max-width: 800px;">
        <div class="mb-4 d-flex justify-content-between align-items-center">
            <a href="{{ path('planification_index') }}" style="color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 500; font-size: 0.9rem;">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Retour au calendrier
            </a>
            
            <div class="d-flex gap-2">
                <a href="{{ path('planification_edit', {id: planification.idEvent}) }}" class="btn btn-sm btn-edit px-3" style="border-radius: 8px;">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    Modifier
                </a>
                <form method="post" action="{{ path('planification_delete', {id: planification.idEvent}) }}" onsubmit="return confirm('Souhaitez-vous vraiment supprimer cet événement ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ planification.idEvent) }}">
                    <button type="submit" class="btn btn-sm btn-outline-danger px-3" style="border-radius: 8px; background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3);">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        Supprimer
                    </button>
                </form>
            </div>
        </div>

        <div class="detail-card">
            <div class="d-flex align-items-center justify-content-between mb-4 border-bottom border-secondary pb-4" style="border-color: rgba(255,255,255,0.1) !important;">
                <h2 class="header-title">{{ planification.typeEvent|capitalize }}</h2>
                {% if planification.statut %}
                    <span class="badge-statut badge
                        {% if planification.statut == 'confirmé' %}bg-success
                        {% elseif planification.statut == 'annulé' %}bg-danger
                        {% elseif planification.statut == 'terminé' %}bg-secondary
                        {% else %}bg-warning{% endif %}">
                        {{ planification.statut }}
                    </span>
                {% endif %}
            </div>

            <div class="info-row">
                <div class="info-label">
                    <div class="info-icon">📅</div>
                    Date
                </div>
                <div class="info-value">{{ planification.date ? planification.date|date('d/m/Y') : '-' }}</div>
            </div>
            
            <div class="info-row">
                <div class="info-label">
                    <div class="info-icon">🕒</div>
                    Horaire
                </div>
                <div class="info-value">
                    <span style="color: var(--accent); font-weight: 700; margin-right: 8px;">De</span>
                    {{ planification.heureDebut ? planification.heureDebut|date('H:i') : '-' }} 
                    <span style="color: var(--accent); font-weight: 700; margin: 0 8px;">à</span> 
                    {{ planification.heureFin ? planification.heureFin|date('H:i') : '-' }}
                </div>
            </div>

            {% if planification.mode %}
            <div class="info-row">
                <div class="info-label">
                    <div class="info-icon">📡</div>
                    Mode
                </div>
                <div class="info-value">{{ planification.mode|capitalize|replace({'_': ' '}) }}</div>
            </div>
            {% endif %}

            {% if planification.localisation %}
            <div class="info-row">
                <div class="info-label">
                    <div class="info-icon">📍</div>
                    Localisation
                </div>
                <div class="info-value">{{ planification.localisation }}</div>
            </div>
            {% endif %}

            {% if planification.lienMeeting %}
            <div class="info-row">
                <div class="info-label">
                    <div class="info-icon">🔗</div>
                    Lien Meeting
                </div>
                <div class="info-value"><a href="{{ planification.lienMeeting }}" target="_blank">{{ planification.lienMeeting }}</a></div>
            </div>
            {% endif %}

            {% if planification.description %}
            <div class="info-row flex-column align-items-start gap-2">
                <div class="info-label w-100">
                    <div class="info-icon">📝</div>
                    Description
                </div>
                <div class="info-value w-100" style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-weight: 400; line-height: 1.6;">
                    {{ planification.description|nl2br }}
                </div>
            </div>
            {% endif %}

            {% if planification.candidature %}
            <div class="info-row mt-2">
                <div class="info-label">
                    <div class="info-icon">👤</div>
                    Candidature
                </div>
                <div class="info-value" style="background: rgba(79, 195, 247, 0.1); padding: 4px 12px; border-radius: 6px; color: var(--accent);">
                    #{{ planification.candidature.idCandidature }}
                </div>
            </div>
            {% endif %}

            {% if planification.user %}
            <div class="info-row">
                <div class="info-label">
                    <div class="info-icon">👥</div>
                    Responsable
                </div>
                <div class="info-value">{{ planification.user.email }}</div>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
