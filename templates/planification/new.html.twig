{% extends 'base.html.twig' %}

{% block title %}Nouvelle planification{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    body { background-color: #f5f7fa; }
    .form-card { background: #fff; border-radius: 14px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .page-header { font-size: 1.4rem; font-weight: 700; color: #1e2d3d; margin-bottom: 6px; }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-3">
        <a href="{{ path('planification_index') }}" class="text-decoration-none text-secondary">← Retour au calendrier</a>
    </div>
    <div class="form-card">
        <div class="page-header">Nouvelle planification</div>
        <p class="text-muted mb-4">Remplissez les informations de l'événement.</p>
        {% include 'planification/_form.html.twig' %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
