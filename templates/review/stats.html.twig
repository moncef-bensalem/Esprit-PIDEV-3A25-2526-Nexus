{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        body { background: #0d1b2a; color: #c8d8e8; font-family: 'Segoe UI', sans-serif; }
        .stat-card { background: #0f2337; border: 1.5px solid #1e3d58; border-radius: 14px; padding: 24px; text-align: center; }
        .stat-num  { font-size: 2.5rem; font-weight: 800; color: #4fc3f7; }
        .stat-lbl  { font-size: 0.82rem; color: #7a9ab8; text-transform: uppercase; letter-spacing: .05em; margin-top: 4px; }
        .chart-box { background: #0f2337; border: 1.5px solid #1e3d58; border-radius: 14px; padding: 24px; }
        h1 { font-size: 1.4rem; font-weight: 700; }
    </style>
{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="mb-3">
        <a href="{{ path('review_index') }}" style="color:#4fc3f7;text-decoration:none;">← Retour aux planifications</a>
    </div>
    <h1 class="mb-4 text-white">📊 Statistiques des avis</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-num">{{ total_reviews }}</div>
                <div class="stat-lbl">Avis total</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-num" style="color:#f59e0b;">{{ avg_rating }}</div>
                <div class="stat-lbl">Note moyenne ★</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-num" style="color:#f87171;">{{ low_rating_count }}</div>
                <div class="stat-lbl">Avis ≤ 2 ★</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-num" style="color:#34d399;">{{ total_planifs }}</div>
                <div class="stat-lbl">Planifications</div>
            </div>
        </div>
    </div>

    <div class="chart-box">
        <h6 class="text-white mb-3">Distribution des notes</h6>
        <canvas id="ratingChart" height="100"></canvas>
    </div>
</div>

<script>
new Chart(document.getElementById('ratingChart'), {
    type: 'bar',
    data: {
        labels: ['1 ★', '2 ★', '3 ★', '4 ★', '5 ★'],
        datasets: [{
            label: 'Nombre d\'avis',
            data: [
                {{ rating_dist[1] ?? 0 }},
                {{ rating_dist[2] ?? 0 }},
                {{ rating_dist[3] ?? 0 }},
                {{ rating_dist[4] ?? 0 }},
                {{ rating_dist[5] ?? 0 }}
            ],
            backgroundColor: ['#ef4444','#f97316','#eab308','#84cc16','#10b981'],
            borderRadius: 6,
        }]
    },
    options: {
        plugins: { legend: { display: false } },
        scales: {
            x: { ticks: { color: '#7a9ab8' }, grid: { color: '#1e3d58' } },
            y: { ticks: { color: '#7a9ab8', stepSize: 1 }, grid: { color: '#1e3d58' }, beginAtZero: true }
        }
    }
});
</script>
{% endblock %}
