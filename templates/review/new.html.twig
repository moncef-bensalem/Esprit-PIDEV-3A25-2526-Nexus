{% extends 'base.html.twig' %}

{% block title %}Ajouter un avis{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #0d1b2a; color: #c8d8e8; }
        .form-card { background: #0f2337; border: 1.5px solid #1e3d58; border-radius: 14px; padding: 30px; }
        .form-label { color: #8cc8e8; font-size: 0.88rem; }
        .form-control, .form-select { background: #0d1b2a; border: 1px solid #1e3d58; color: #c8d8e8; }
        .form-control:focus, .form-select:focus { background: #0d1b2a; border-color: #4fc3f7; color: #fff; box-shadow: none; }
        .form-select option { background: #0d1b2a; }
        .page-title { font-size: 1.3rem; font-weight: 700; color: #fff; margin-bottom: 6px; }
        .plan-info { background: #091624; border: 1px solid #1a3248; border-radius: 10px; padding: 12px 16px; font-size: 0.82rem; color: #7aa8c8; margin-bottom: 20px; }
    </style>
{% endblock %}

{% block content %}
<div class="container py-5" style="max-width: 560px;">
    <div class="mb-3">
        <a href="{{ path('review_index') }}" style="color:#4fc3f7; text-decoration:none;">← Retour</a>
    </div>
    <div class="form-card">
        <div class="page-title">★ Ajouter un avis</div>

        <div class="plan-info">
            📅 <strong style="color:#c8d8e8;">{{ planification.typeEvent|capitalize }}</strong>
            — {{ planification.date ? planification.date|date('d/m/Y') : '—' }}
            {% if planification.heureDebut %}à {{ planification.heureDebut|date('H:i') }}{% endif %}
        </div>

        {% for type, messages in app.flashes %}
            {% for msg in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : 'success' }} py-2 mb-3" style="border-radius:8px; font-size:.85rem;">
                {{ msg }}
            </div>
            {% endfor %}
        {% endfor %}

        {% include 'review/_form.html.twig' %}
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
