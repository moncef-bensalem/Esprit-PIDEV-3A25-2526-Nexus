{% extends 'base.html.twig' %}

{% block title %}Candidature{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Détails Candidature</h1>
        <div class="top-actions">
            <a href="{{ path('app_candidature_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_candidature_edit', {'id_candidature': candidature.id_candidature}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Éditer
            </a>
            {{ include('candidature/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="stat-card" style="text-align: left; max-width: 600px; margin: 0 auto;">
        <table class="table" style="width: 100%; border-collapse: collapse;">
            <tbody>
            <tr>
                <th>Id candidature</th>
                <td>{{ candidature.id_candidature }}</td>
            </tr>
            <tr>
                <th>Etat avancement</th>
                <td>{{ candidature.etat_avancement }}</td>
            </tr>
            <tr>
                <th>Score matching</th>
                <td>{{ candidature.score_matching }}</td>
            </tr>
            <tr>
                <th>Date postulation</th>
                <td>{{ candidature.date_postulation ? candidature.date_postulation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Notes</th>
                <td>{{ candidature.notes }}</td>
            </tr>

            </tbody>
        </table>
    </div>
</div>
{% endblock %}