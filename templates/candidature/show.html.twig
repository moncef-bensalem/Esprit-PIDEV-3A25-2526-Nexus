{% extends 'base.html.twig' %}

{% block title %}Candidature{% endblock %}

{% block page_title %}Dossier de candidature{% endblock %}

{% block content %}
<style>
    .mc-show-card { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 32px; max-width: 900px; margin: 0 auto; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .mc-detail-row { display: flex; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .mc-detail-row:last-child { border-bottom: none; }
    .mc-detail-label { width: 200px; flex-shrink: 0; font-size: 0.85rem; font-weight: 600; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; }
    .mc-detail-value { flex: 1; font-size: 0.95rem; color: #fff; line-height: 1.5; }
    
    .status-badge { font-size: 0.75rem; font-weight: 700; padding: 5px 12px; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px; display: inline-block; }
    .status-badge.recu { background: rgba(32,178,170,0.15); color: #20b2aa; }
    .status-badge.entretien { background: rgba(156,39,176,0.15); color: #ce93d8; }
    .status-badge.offre { background: rgba(76,175,80,0.15); color: #81c784; }
    .status-badge.rejete { background: rgba(244,67,54,0.15); color: #e57373; }
    
    .score-high { color: #81c784; font-weight: bold; font-size: 1.2rem; }
    .score-med { color: var(--cyan); font-weight: bold; font-size: 1.2rem; }
    .score-low { color: #e57373; font-weight: bold; font-size: 1.2rem; }
</style>

<div class="mc-header">
    <div>
        <div class="mc-header-title"><i class="fas fa-file-contract" style="color:var(--cyan); margin-right: 12px;"></i> Examen de dossier</div>
        <div class="mc-header-sub">Candidature #{{ candidature.id_candidature }} pour {{ candidature.offreEmploi.titrePoste|default('spontanée') }}</div>
    </div>
    <div class="mc-header-actions" style="display:flex; align-items:center; gap: 12px;">
        <a href="{{ path('app_candidature_index') }}" style="color:rgba(255,255,255,0.6); text-decoration:none; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_candidature_edit', {'id_candidature': candidature.id_candidature}) }}" style="background: linear-gradient(135deg, #20b2aa, #0288d1); color: #fff; border: none; padding: 8px 16px; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fas fa-edit"></i> Évaluer
        </a>
        <div style="background:rgba(239,83,80,.1); border-radius:10px; padding: 4px 10px; display: flex; align-items:center;">
            {{ include('candidature/_delete_form.html.twig') }}
        </div>
    </div>
</div>

<div class="mc-show-card">
    <div style="display: flex; gap: 40px; flex-wrap: wrap;">
        
        <!-- Left Column: Data -->
        <div style="flex: 1; min-width: 350px;">
            <div class="mc-detail-row">
        <div class="mc-detail-label">Candidat</div>
        <div class="mc-detail-value" style="font-size: 1.2rem; font-weight: 700; color: #fff;">
            <i class="fas fa-user-circle" style="color:rgba(255,255,255,0.3); margin-right: 6px;"></i> 
            {{ candidature.candidat.nomComplet|default('Profil non défini') }}
        </div>
    </div>
    <div class="mc-detail-row">
        <div class="mc-detail-label">Offre Associée</div>
        <div class="mc-detail-value" style="color: var(--cyan);">{{ candidature.offreEmploi.titrePoste|default('Aucune (Candidature spontanée)') }}</div>
    </div>
    <div class="mc-detail-row">
        <div class="mc-detail-label">État du Pipeline</div>
        <div class="mc-detail-value">
            {% if candidature.etat_avancement == 'RECU' %}
                <span class="status-badge recu">Reçu</span>
            {% elseif candidature.etat_avancement == 'EN_ENTRETIEN' %}
                <span class="status-badge entretien">En Entretien</span>
            {% elseif candidature.etat_avancement == 'OFFRE_FAITE' %}
                <span class="status-badge offre">Offre Faite</span>
            {% else %}
                <span class="status-badge rejete">Rejeté</span>
            {% endif %}
        </div>
    </div>
    <div class="mc-detail-row">
        <div class="mc-detail-label">Score IA (Matching)</div>
        <div class="mc-detail-value">
            {% set score = candidature.score_matching|default(0) %}
            {% if score >= 80 %}
                <span class="score-high">{{ score }}%</span>
            {% elseif score >= 50 %}
                <span class="score-med">{{ score }}%</span>
            {% elseif score > 0 %}
                <span class="score-low">{{ score }}%</span>
            {% else %}
                <span style="color:rgba(255,255,255,0.3); font-style:italic;">Non calculé</span>
            {% endif %}
        </div>
    </div>
    <div class="mc-detail-row">
        <div class="mc-detail-label">Date de Réception</div>
        <div class="mc-detail-value"><i class="fas fa-clock" style="color:rgba(255,255,255,0.4); margin-right:6px;"></i> {{ candidature.date_postulation ? candidature.date_postulation|date('d/m/Y H:i') : '-' }}</div>
    </div>
    <div class="mc-detail-row">
        <div class="mc-detail-label">Notes des recruteurs</div>
        <div class="mc-detail-value" style="white-space: pre-wrap; padding: 16px; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px solid rgba(255,255,255,0.03);">{{ candidature.notes|default('Aucune note enregistrée.') }}</div>
    </div>
            </div>
        </div>
        
        <!-- Right Column: Radar Chart -->
        <div style="width: 380px; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(15,23,42,0.5); border-radius: 16px; padding: 25px; border: 1px solid rgba(6,182,212,0.15);">
            <h4 style="color: rgba(255,255,255,0.8); font-size: 0.85rem; margin-top: 0; margin-bottom: 20px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;"><i class="fas fa-radar" style="color: #06b6d4; margin-right: 6px;"></i> Mapping IA Nexus</h4>
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="scoreSpiderChart"></canvas>
            </div>
        </div>
        
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('scoreSpiderChart');
    if (ctx) {
        new Chart(ctx, {
            type: 'radar',
            data: {
                labels: ['Technique', 'Expérience', 'Formation', 'Langues', 'Soft Skills'],
                datasets: [{
                    label: 'Profil du Candidat',
                    data: [
                        {{ candidature.candidat.score_technique|default(0) }},
                        {{ candidature.candidat.score_experience|default(0) }},
                        {{ candidature.candidat.score_formation|default(0) }},
                        {{ candidature.candidat.score_langues|default(0) }},
                        {{ candidature.candidat.score_soft_skills|default(0) }}
                    ],
                    backgroundColor: 'rgba(6, 182, 212, 0.25)',
                    borderColor: 'rgba(6, 182, 212, 1)',
                    pointBackgroundColor: '#fff',
                    pointBorderColor: 'rgba(6, 182, 212, 1)',
                    pointHoverBackgroundColor: 'rgba(6, 182, 212, 1)',
                    pointHoverBorderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        angleLines: { color: 'rgba(255, 255, 255, 0.1)' },
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        pointLabels: { color: 'rgba(255,255,255,0.6)', font: { size: 11, family: 'sans-serif' } },
                        ticks: { display: false, min: 0, max: 100 }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }
});
</script>
{% endblock %}
