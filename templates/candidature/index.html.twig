{% extends 'base.html.twig' %}

{% block title %}Liste des Candidatures{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Liste des Candidatures</h1>
        <div class="top-actions">
            <a href="{{ path('app_candidature_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Créer Nouveau
            </a>
        </div>
    </div>

    <form method="GET" action="{{ path('app_candidature_index') }}" class="filters-bar" style="margin-bottom: 2rem; display: flex; align-items: flex-end; gap: 1rem;">
        <div>
            <label for="etat">État:</label>
            <select name="etat" id="etat" onchange="this.form.submit()" style="border-radius:2rem; padding: 0.5rem 1rem;">
                <option value="">Tous les états</option>
                <option value="RECU" {% if app.request.query.get('etat') == 'RECU' %}selected{% endif %}>Reçu</option>
                <option value="EN_ENTRETIEN" {% if app.request.query.get('etat') == 'EN_ENTRETIEN' %}selected{% endif %}>En entretien</option>
                <option value="OFFRE_FAITE" {% if app.request.query.get('etat') == 'OFFRE_FAITE' %}selected{% endif %}>Offre faite</option>
                <option value="REJETE" {% if app.request.query.get('etat') == 'REJETE' %}selected{% endif %}>Rejeté</option>
            </select>
        </div>

        {% if app.request.query.get('etat') %}
            <a href="{{ path('app_candidature_index') }}" class="btn" style="padding: 0.55rem 1rem; border-radius:2rem;">Réinitialiser</a>
        {% endif %}
    </form>

    <div class="stat-card" style="overflow-x: auto;">
        <table class="table table-dark table-hover mb-0" style="background: transparent;">
            <thead>
                <tr style="border-bottom: 2px solid var(--border-color);">
                    <th>Candidat</th>
                    <th>Offre associée</th>
                    <th>Etat avancement</th>
                    <th>Score matching</th>
                    <th>Date postulation</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for candidature in candidatures %}
                <tr style="vertical-align: middle;">
                    <td style="font-weight: 600;">{{ candidature.candidat.nomComplet|default('Candidat #' ~ candidature.id_candidature) }}</td>
                    <td style="color: var(--text-muted);">{{ candidature.offreEmploi.titrePoste|default('Offre #' ~ candidature.offreEmploi.id_offre) }}</td>
                    <td>
                        {% if candidature.etat_avancement == 'RECU' %}
                            <span class="badge theme-blue">Reçu</span>
                        {% elseif candidature.etat_avancement == 'EN_ENTRETIEN' %}
                            <span class="badge theme-purple">En Entretien</span>
                        {% elseif candidature.etat_avancement == 'OFFRE_FAITE' %}
                            <span class="badge" style="background: var(--success-color); color: #fff;">Offre Faite</span>
                        {% else %}
                            <span class="badge" style="background: var(--error-color); color: #fff;">Rejeté</span>
                        {% endif %}
                    </td>
                    <td>
                        <span style="color: var(--neon-blue); font-weight: bold;">
                            {{ candidature.score_matching|default('N/A') }}{% if candidature.score_matching %}%{% endif %}
                        </span>
                    </td>
                    <td class="text-muted"><i class="fas fa-calendar-alt"></i> {{ candidature.date_postulation ? candidature.date_postulation|date('d/m/Y') : '' }}</td>

                    <td class="talent-actions" style="border-top: none;">
                        <a href="{{ path('app_candidature_show', {'id_candidature': candidature.id_candidature}) }}" class="btn-icon" title="Voir"><i class="fas fa-eye"></i></a>
                        <a href="{{ path('app_candidature_edit', {'id_candidature': candidature.id_candidature}) }}" class="btn-icon" title="Évaluer"><i class="fas fa-edit"></i></a>
                        {{ include('candidature/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted" style="padding: 2rem;">Aucune candidature trouvée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
