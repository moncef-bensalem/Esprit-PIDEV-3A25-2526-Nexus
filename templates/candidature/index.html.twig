{% extends 'base.html.twig' %}

{% block title %}Liste des Candidatures{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="top-bar">
        <h1>Liste des Candidatures</h1>
        <div class="top-actions">
            <a href="{{ path('app_candidature_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Créer Nouveau
            </a>
        </div>
    </div>

    <div class="stat-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Id candidature</th>
                    <th>Etat avancement</th>
                    <th>Score matching</th>
                    <th>Date postulation</th>
                    <th>Notes</th>

                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for candidature in candidatures %}
                <tr>
                    <td>{{ candidature.id_candidature }}</td>
                    <td>{{ candidature.etat_avancement }}</td>
                    <td>{{ candidature.score_matching }}</td>
                    <td>{{ candidature.date_postulation ? candidature.date_postulation|date('Y-m-d') : '' }}</td>
                    <td>{{ candidature.notes }}</td>

                    <td class="talent-actions">
                        <a href="{{ path('app_candidature_show', {'id_candidature': candidature.id_candidature}) }}" class="btn-icon"><i class="fas fa-eye"></i></a>
                        <a href="{{ path('app_candidature_edit', {'id_candidature': candidature.id_candidature}) }}" class="btn-icon"><i class="fas fa-edit"></i></a>
                        {{ include('candidature/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}