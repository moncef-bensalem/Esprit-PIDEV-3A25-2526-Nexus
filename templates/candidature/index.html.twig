{% extends 'base.html.twig' %}

{% block page_title %}Gestion des Candidatures{% endblock %}

{% block content %}
<style>
    .mc-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
    .mc-header-title { font-size: 1.4rem; font-weight: 700; color: #fff; margin-bottom: 4px; display: flex; align-items: center; }
    .mc-header-sub { font-size: .85rem; color: rgba(255,255,255,.4); }
    .mc-header-actions { display: flex; gap: 12px; }
    .btn-create { background: linear-gradient(135deg, #20b2aa, #0288d1); color: #fff; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; transition: transform 0.2s; }
    .btn-create:hover { transform: translateY(-2px); color:#fff; }
    
    .filters-bar { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); padding: 16px 24px; border-radius: 16px; margin-bottom: 24px; display: flex; align-items: flex-end; gap: 16px; }
    .filter-label { font-size: 0.8rem; color: rgba(255,255,255,0.5); font-weight: 600; display: block; margin-bottom: 6px; }
    .filter-input, .filter-select { background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 10px 16px; border-radius: 10px; font-size: 0.85rem; outline: none; }
    
    .glass-table-wrapper { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .glass-table { width: 100%; border-collapse: collapse; text-align: left; }
    .glass-table th { background: rgba(0,0,0,0.2); padding: 16px 20px; font-weight: 600; font-size: 0.8rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .glass-table td { padding: 16px 20px; font-size: 0.9rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.03); vertical-align: middle; }
    .glass-table tr:hover td { background: rgba(32,178,170,0.03); }
    .glass-table tr:last-child td { border-bottom: none; }
    
    .status-badge { font-size: 0.7rem; font-weight: 700; padding: 5px 12px; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px; display: inline-block; }
    .status-badge.recu { background: rgba(32,178,170,0.15); color: #20b2aa; }
    .status-badge.entretien { background: rgba(156,39,176,0.15); color: #ce93d8; }
    .status-badge.offre { background: rgba(76,175,80,0.15); color: #81c784; }
    .status-badge.rejete { background: rgba(244,67,54,0.15); color: #e57373; }
    
    .score-high { color: #81c784; font-weight: bold; }
    .score-med { color: var(--cyan); font-weight: bold; }
    .score-low { color: #e57373; font-weight: bold; }
    
    .mc-btn-icon { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.05); transition: all 0.2s; text-decoration: none; border: none; cursor: pointer; margin-right: 4px; }
    .mc-btn-icon:hover { background: rgba(32,178,170,0.2); color: #fff; }
</style>

<div class="mc-header">
    <div>
        <div class="mc-header-title"><i class="fas fa-file-invoice" style="color:var(--cyan); margin-right: 12px;"></i> Table des Candidatures</div>
        <div class="mc-header-sub">Supervisez et gérez le flux de candidats à travers le pipeline.</div>
    </div>
    <div class="mc-header-actions">
        <a href="{{ path('app_candidature_new') }}" class="btn-create">
            <i class="fas fa-plus"></i> Nouvelle Candidature
        </a>
    </div>
</div>

    <form method="GET" action="{{ path('app_candidature_index') }}" class="filters-bar">
        <div>
            <label for="etat" class="filter-label">Filtrer par l'état actuel</label>
            <select name="etat" id="etat" onchange="this.form.submit()" class="filter-select" style="min-width: 200px;">
                <option value="">Toutes les candidatures</option>
                <option value="RECU" {% if app.request.query.get('etat') == 'RECU' %}selected{% endif %}>Reçu</option>
                <option value="EN_ENTRETIEN" {% if app.request.query.get('etat') == 'EN_ENTRETIEN' %}selected{% endif %}>En entretien</option>
                <option value="OFFRE_FAITE" {% if app.request.query.get('etat') == 'OFFRE_FAITE' %}selected{% endif %}>Offre faite</option>
                <option value="REJETE" {% if app.request.query.get('etat') == 'REJETE' %}selected{% endif %}>Rejeté</option>
            </select>
        </div>

        {% if app.request.query.get('etat') %}
            <a href="{{ path('app_candidature_index') }}" style="color:rgba(255,255,255,0.4); font-size:0.85rem; text-decoration:none; margin-bottom: 12px; margin-left: 8px;">Réinitialiser filter</a>
        {% endif %}
    </form>

    <div class="glass-table-wrapper">
        <div style="overflow-x: auto;">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th>Candidat</th>
                        <th>Poste Ciblé</th>
                        <th>État Pipeline</th>
                        <th>Score (IA)</th>
                        <th>Date de réception</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for candidature in candidatures %}
                    <tr>
                        <td style="font-weight: 600;">
                            <div>{{ candidature.candidat.nomComplet|default('Non assigné') }}</div>
                            <div style="font-size: 0.75rem; color: rgba(255,255,255,0.4); font-weight: normal; margin-top: 2px;">#{{ candidature.id_candidature }}</div>
                        </td>
                        <td style="color: rgba(255,255,255,0.7); font-size: 0.85rem;">
                            {{ candidature.offreEmploi.titrePoste|default('Candidature spontanée') }}
                        </td>
                        <td>
                            {% if candidature.etat_avancement == 'RECU' %}
                                <span class="status-badge recu">Reçu</span>
                            {% elseif candidature.etat_avancement == 'EN_ENTRETIEN' %}
                                <span class="status-badge entretien">En Entretien</span>
                            {% elseif candidature.etat_avancement == 'OFFRE_FAITE' %}
                                <span class="status-badge offre">Offre Faite</span>
                            {% else %}
                                <span class="status-badge rejete">Rejeté</span>
                            {% endif %}
                        </td>
                        <td>
                            {% set score = candidature.score_matching|default(0) %}
                            {% if score >= 80 %}
                                <span class="score-high">{{ score }}%</span>
                            {% elseif score >= 50 %}
                                <span class="score-med">{{ score }}%</span>
                            {% elseif score > 0 %}
                                <span class="score-low">{{ score }}%</span>
                            {% else %}
                                <span style="color:rgba(255,255,255,0.3);">N/A</span>
                            {% endif %}
                        </td>
                        <td style="color: rgba(255,255,255,0.5);"><i class="fas fa-clock" style="margin-right: 6px;"></i> {{ candidature.date_postulation ? candidature.date_postulation|date('d/m/Y') : '-' }}</td>

                        <td style="text-align: right; white-space: nowrap;">
                            <a href="{{ path('app_candidature_show', {'id_candidature': candidature.id_candidature}) }}" class="mc-btn-icon" title="Examiner"><i class="fas fa-eye"></i></a>
                            <a href="{{ path('app_candidature_edit', {'id_candidature': candidature.id_candidature}) }}" class="mc-btn-icon" title="Évaluer / Modifier"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('app_candidature_delete', {'id_candidature': candidature.id_candidature}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette candidature ?');" style="display:inline-block; margin:0; vertical-align: top;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ candidature.id_candidature) }}">
                                <button class="mc-btn-icon" style="color: #ef5350;"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 60px 20px; color: rgba(255,255,255,0.4);">
                            <i class="fas fa-folder-open" style="font-size: 2.5rem; margin-bottom: 16px; opacity: 0.3; display: block;"></i>
                            Le pipeline est actuellement vide pour ces filtres.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
