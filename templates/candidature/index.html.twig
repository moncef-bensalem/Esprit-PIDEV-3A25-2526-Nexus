{% extends 'base.html.twig' %}
{% block page_title %}Gestion des Candidatures{% endblock %}

{% block content %}
<style>
    .btn-create { background: linear-gradient(135deg, #20b2aa, #0288d1); color: #fff; border: none; padding: 11px 22px; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; transition: all 0.2s; box-shadow: 0 4px 16px rgba(32,178,170,0.25); }
    .btn-create:hover { transform: translateY(-2px); color:#fff; box-shadow: 0 8px 24px rgba(32,178,170,0.35); }

    /* KPI */
    .kpi-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-bottom: 22px; }
    .kpi-card { background: rgba(13,25,42,0.7); border: 1px solid rgba(255,255,255,0.06); border-radius: 13px; padding: 16px 18px; display: flex; align-items: center; gap: 13px; transition: all 0.2s; }
    .kpi-card:hover { border-color: rgba(32,178,170,0.25); transform: translateY(-2px); }
    .kpi-icon { width: 42px; height: 42px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; flex-shrink: 0; }
    .kpi-label { font-size: 0.68rem; color: rgba(255,255,255,0.4); font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 3px; }
    .kpi-value { font-size: 1.6rem; font-weight: 800; color: #fff; line-height: 1; }

    /* Pipeline funnel */
    .pipeline-panel { background: rgba(13,25,42,0.7); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 22px; margin-bottom: 22px; }
    .pipeline-title { font-size: 0.72rem; font-weight: 700; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 18px; display: flex; align-items: center; gap: 6px; }
    .pipeline-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.04); border-radius: 10px; overflow: hidden; }
    .pipeline-step { padding: 16px; text-align: center; position: relative; transition: background 0.2s; }
    .pipeline-step:hover { background: rgba(255,255,255,0.02); }
    .pipeline-step-icon { font-size: 1.2rem; margin-bottom: 8px; }
    .pipeline-step-label { font-size: 0.72rem; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 6px; }
    .pipeline-step-count { font-size: 2rem; font-weight: 800; line-height: 1; }
    .pipeline-step-pct { font-size: 0.68rem; color: rgba(255,255,255,0.3); margin-top: 4px; }
    .pipeline-arrow { position: absolute; right: -1px; top: 50%; transform: translateY(-50%); color: rgba(255,255,255,0.1); font-size: 0.8rem; z-index: 1; }

    /* Filters */
    .filters-bar { background: rgba(13,25,42,0.6); border: 1px solid rgba(255,255,255,0.05); padding: 13px 18px; border-radius: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .filter-label { font-size: 0.72rem; color: rgba(255,255,255,0.45); font-weight: 600; display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.4px; }
    .filter-select { background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 8px 13px; border-radius: 9px; font-size: 0.82rem; outline: none; transition: border-color 0.2s; }
    .filter-select:focus { border-color: rgba(32,178,170,0.5); }
    .filter-select option { background: #0d1a2a; }

    /* Pill filters */
    .pill-filters { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .pill { padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-decoration: none; border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); transition: all 0.2s; }
    .pill:hover, .pill.active { background: rgba(32,178,170,0.15); border-color: rgba(32,178,170,0.3); color: #20b2aa; }
    .pill.pill-recu.active     { background: rgba(32,178,170,0.15); border-color: rgba(32,178,170,0.3); color: #20b2aa; }
    .pill.pill-entretien.active { background: rgba(156,39,176,0.15); border-color: rgba(156,39,176,0.3); color: #ce93d8; }
    .pill.pill-offre.active    { background: rgba(76,175,80,0.15);  border-color: rgba(76,175,80,0.3);  color: #81c784; }
    .pill.pill-rejete.active   { background: rgba(244,67,54,0.15);  border-color: rgba(244,67,54,0.3);  color: #e57373; }

    /* Table */
    .glass-table-wrapper { background: rgba(13,25,42,0.65); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; overflow: hidden; }
    .glass-table { width: 100%; border-collapse: collapse; text-align: left; }
    .glass-table th { background: rgba(0,0,0,0.25); padding: 13px 18px; font-weight: 700; font-size: 0.7rem; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.8px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .glass-table td { padding: 14px 18px; font-size: 0.86rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.03); vertical-align: middle; }
    .glass-table tr:hover td { background: rgba(32,178,170,0.025); }
    .glass-table tr:last-child td { border-bottom: none; }

    /* Avatar */
    .candidate-avatar { width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #20b2aa, #0288d1); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; color: #fff; flex-shrink: 0; }

    /* Status badges */
    .status-badge { font-size: 0.65rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.6px; display: inline-block; }
    .status-badge.recu       { background: rgba(32,178,170,0.12); color: #20b2aa; border: 1px solid rgba(32,178,170,0.25); }
    .status-badge.entretien  { background: rgba(156,39,176,0.12); color: #ce93d8; border: 1px solid rgba(156,39,176,0.25); }
    .status-badge.offre      { background: rgba(76,175,80,0.12);  color: #81c784; border: 1px solid rgba(76,175,80,0.25); }
    .status-badge.rejete     { background: rgba(244,67,54,0.12);  color: #e57373; border: 1px solid rgba(244,67,54,0.25); }

    /* Score bar */
    .score-bar-wrap { display: flex; align-items: center; gap: 8px; min-width: 100px; }
    .score-bar-track { flex: 1; height: 5px; border-radius: 10px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .score-bar-fill { height: 100%; border-radius: 10px; }
    .score-text { font-size: 0.8rem; font-weight: 700; min-width: 34px; text-align: right; }

    .mc-btn-icon { width: 29px; height: 29px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.05); transition: all 0.2s; text-decoration: none; border: none; cursor: pointer; font-size: 0.78rem; }
    .mc-btn-icon:hover { background: rgba(32,178,170,0.18); color: #fff; }
</style>

{# ── Header ── #}
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:26px;">
    <div>
        <div style="font-size:1.3rem; font-weight:800; color:#fff; display:flex; align-items:center; gap:10px;">
            <i class="fas fa-users-cog" style="color:#20b2aa;"></i> Pipeline des Candidatures
        </div>
        <div style="font-size:0.8rem; color:rgba(255,255,255,0.35); margin-top:4px;">Suivez l'avancement de chaque candidat à travers le pipeline de recrutement.</div>
    </div>
    <a href="{{ path('app_candidature_new') }}" class="btn-create">
        <i class="fas fa-plus"></i> Nouvelle Candidature
    </a>
</div>

{# ── KPI Row ── #}
<div class="kpi-row">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(32,178,170,0.12); color:#20b2aa;"><i class="fas fa-inbox"></i></div>
        <div><div class="kpi-label">Total</div><div class="kpi-value">{{ stats.total }}</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(32,178,170,0.12); color:#20b2aa;"><i class="fas fa-envelope-open"></i></div>
        <div><div class="kpi-label">Reçues</div><div class="kpi-value" style="color:#20b2aa;">{{ stats.recu }}</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(156,39,176,0.12); color:#ce93d8;"><i class="fas fa-comments"></i></div>
        <div><div class="kpi-label">Entretiens</div><div class="kpi-value" style="color:#ce93d8;">{{ stats.entretien }}</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(76,175,80,0.12); color:#81c784;"><i class="fas fa-handshake"></i></div>
        <div><div class="kpi-label">Offres faites</div><div class="kpi-value" style="color:#81c784;">{{ stats.offre }}</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(2,136,209,0.12); color:#0288d1;"><i class="fas fa-robot"></i></div>
        <div><div class="kpi-label">Score IA moy.</div><div class="kpi-value" style="color:#0288d1;">{{ stats.avg_score ?: '—' }}{% if stats.avg_score %}<span style="font-size:0.9rem;">%</span>{% endif %}</div></div>
    </div>
</div>

{# ── Pipeline Funnel ── #}
<div class="pipeline-panel">
    <div class="pipeline-title"><i class="fas fa-filter" style="color:#20b2aa;"></i> Visualisation du pipeline</div>
    <div class="pipeline-steps">
        {% set total = stats.total > 0 ? stats.total : 1 %}
        <div class="pipeline-step" style="background:rgba(32,178,170,0.05);">
            <div class="pipeline-step-icon">📥</div>
            <div class="pipeline-step-label">Reçu</div>
            <div class="pipeline-step-count" style="color:#20b2aa;">{{ stats.recu }}</div>
            <div class="pipeline-step-pct">{{ ((stats.recu / total) * 100)|round }}%</div>
            <div class="pipeline-arrow"><i class="fas fa-chevron-right"></i></div>
        </div>
        <div class="pipeline-step" style="background:rgba(156,39,176,0.05);">
            <div class="pipeline-step-icon">💬</div>
            <div class="pipeline-step-label">Entretien</div>
            <div class="pipeline-step-count" style="color:#ce93d8;">{{ stats.entretien }}</div>
            <div class="pipeline-step-pct">{{ ((stats.entretien / total) * 100)|round }}%</div>
            <div class="pipeline-arrow"><i class="fas fa-chevron-right"></i></div>
        </div>
        <div class="pipeline-step" style="background:rgba(76,175,80,0.05);">
            <div class="pipeline-step-icon">🤝</div>
            <div class="pipeline-step-label">Offre faite</div>
            <div class="pipeline-step-count" style="color:#81c784;">{{ stats.offre }}</div>
            <div class="pipeline-step-pct">{{ ((stats.offre / total) * 100)|round }}%</div>
            <div class="pipeline-arrow"><i class="fas fa-chevron-right"></i></div>
        </div>
        <div class="pipeline-step" style="background:rgba(244,67,54,0.04);">
            <div class="pipeline-step-icon">❌</div>
            <div class="pipeline-step-label">Rejeté</div>
            <div class="pipeline-step-count" style="color:#e57373;">{{ stats.rejete }}</div>
            <div class="pipeline-step-pct">{{ ((stats.rejete / total) * 100)|round }}%</div>
        </div>
    </div>
</div>

{# ── Pill Filters ── #}
<div class="filters-bar">
    <div style="font-size:0.72rem; color:rgba(255,255,255,0.4); font-weight:600; text-transform:uppercase; letter-spacing:0.4px;">Filtrer :</div>
    <div class="pill-filters">
        <a href="{{ path('app_candidature_index') }}" class="pill {{ not app.request.query.get('etat') ? 'active' : '' }}">Tous ({{ stats.total }})</a>
        <a href="{{ path('app_candidature_index', {'etat': 'RECU'}) }}" class="pill pill-recu {{ app.request.query.get('etat') == 'RECU' ? 'active' : '' }}">📥 Reçu ({{ stats.recu }})</a>
        <a href="{{ path('app_candidature_index', {'etat': 'EN_ENTRETIEN'}) }}" class="pill pill-entretien {{ app.request.query.get('etat') == 'EN_ENTRETIEN' ? 'active' : '' }}">💬 Entretien ({{ stats.entretien }})</a>
        <a href="{{ path('app_candidature_index', {'etat': 'OFFRE_FAITE'}) }}"  class="pill pill-offre {{ app.request.query.get('etat') == 'OFFRE_FAITE' ? 'active' : '' }}">🤝 Offre faite ({{ stats.offre }})</a>
        <a href="{{ path('app_candidature_index', {'etat': 'REJETE'}) }}"       class="pill pill-rejete {{ app.request.query.get('etat') == 'REJETE' ? 'active' : '' }}">❌ Rejeté ({{ stats.rejete }})</a>
    </div>
    <span style="margin-left:auto; font-size:0.75rem; color:rgba(255,255,255,0.25);">{{ candidatures|length }} résultat{{ candidatures|length != 1 ? 's' : '' }}</span>
</div>

{# ── Table ── #}
<div class="glass-table-wrapper">
    <div style="overflow-x:auto;">
        <table class="glass-table">
            <thead>
                <tr>
                    <th>Candidat</th>
                    <th>Poste ciblé</th>
                    <th>État pipeline</th>
                    <th>Score IA</th>
                    <th>Reçue le</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for candidature in candidatures %}
                {% set score = candidature.score_matching|default(0) %}
                {% set scoreColor = score >= 80 ? '#4caf50' : (score >= 50 ? '#20b2aa' : (score > 0 ? '#ef5350' : 'rgba(255,255,255,0.2)')) %}
                <tr>
                    <td>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div class="candidate-avatar">
                                {{ candidature.candidat.nomComplet|default('?')|first|upper }}
                            </div>
                            <div>
                                <div style="font-weight:700; font-size:0.88rem;">{{ candidature.candidat.nomComplet|default('Non assigné') }}</div>
                                <div style="font-size:0.7rem; color:rgba(255,255,255,0.3); margin-top:1px;">#{{ candidature.id_candidature }}</div>
                            </div>
                        </div>
                    </td>
                    <td style="color:rgba(255,255,255,0.65); font-size:0.83rem; max-width:220px;">
                        <div style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            {{ candidature.offreEmploi.titrePoste|default('Candidature spontanée') }}
                        </div>
                    </td>
                    <td>
                        {% if candidature.etat_avancement == 'RECU' %}
                            <span class="status-badge recu">Reçu</span>
                        {% elseif candidature.etat_avancement == 'EN_ENTRETIEN' %}
                            <span class="status-badge entretien">Entretien</span>
                        {% elseif candidature.etat_avancement == 'OFFRE_FAITE' %}
                            <span class="status-badge offre">Offre faite</span>
                        {% else %}
                            <span class="status-badge rejete">Rejeté</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if score > 0 %}
                            <div class="score-bar-wrap">
                                <div class="score-bar-track">
                                    <div class="score-bar-fill" style="width:{{ score }}%; background:{{ scoreColor }};"></div>
                                </div>
                                <span class="score-text" style="color:{{ scoreColor }};">{{ score }}%</span>
                            </div>
                        {% else %}
                            <span style="color:rgba(255,255,255,0.2); font-size:0.78rem;">N/A</span>
                        {% endif %}
                    </td>
                    <td style="color:rgba(255,255,255,0.4); font-size:0.8rem; white-space:nowrap;">
                        <i class="fas fa-calendar-alt" style="margin-right:5px; color:rgba(255,255,255,0.2);"></i>
                        {{ candidature.date_postulation ? candidature.date_postulation|date('d/m/Y') : '-' }}
                    </td>
                    <td style="text-align:right; white-space:nowrap;">
                        <a href="{{ path('app_candidature_show', {'id_candidature': candidature.id_candidature}) }}" class="mc-btn-icon" title="Consulter"><i class="fas fa-eye"></i></a>
                        <a href="{{ path('app_candidature_edit', {'id_candidature': candidature.id_candidature}) }}" class="mc-btn-icon" title="Modifier" style="margin:0 4px;"><i class="fas fa-edit"></i></a>
                        <form method="post" action="{{ path('app_candidature_delete', {'id_candidature': candidature.id_candidature}) }}" onsubmit="return confirm('Supprimer cette candidature ?');" style="display:inline-block; margin:0; vertical-align:top;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ candidature.id_candidature) }}">
                            <button class="mc-btn-icon" style="color:#ef5350;"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align:center; padding:70px 20px; color:rgba(255,255,255,0.25);">
                        <i class="fas fa-folder-open" style="font-size:2.5rem; opacity:0.2; display:block; margin-bottom:14px;"></i>
                        Aucune candidature pour ces critères.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
