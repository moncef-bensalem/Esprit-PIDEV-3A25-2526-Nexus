<form method="post" action="{{ path('app_candidature_delete', {'id_candidature': candidature.id_candidature}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');" style="display:inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ candidature.id_candidature) }}">
    <button class="btn-icon btn-delete" title="Supprimer"><i class="fas fa-trash"></i></button>
</form>
