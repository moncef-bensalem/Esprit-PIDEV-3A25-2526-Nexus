{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="mb-3">
        {{ form_label(form.nomCritere, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.nomCritere) }}
        <div class="text-danger small">{{ form_errors(form.nomCritere) }}</div>
    </div>

    <div class="mb-3">
        {{ form_label(form.noteAttribuee, null, {'label_attr': {'class': 'form-label'}}) }}

        {# Champ caché qui contient la valeur réelle (0, 5, 10, 15, 20) #}
        {{ form_widget(form.noteAttribuee, {'attr': {'class': 'd-none js-note-attribuee-input'}}) }}

        {# Sélecteur d'emojis #}
        <div class="d-flex gap-2 emoji-score-group">
            <button type="button" class="btn btn-outline-light emoji-score" data-value="0" title="0">
                😡
            </button>
            <button type="button" class="btn btn-outline-light emoji-score" data-value="5" title="5">
                😕
            </button>
            <button type="button" class="btn btn-outline-light emoji-score" data-value="10" title="10">
                😐
            </button>
            <button type="button" class="btn btn-outline-light emoji-score" data-value="15" title="15">
                🙂
            </button>
            <button type="button" class="btn btn-outline-light emoji-score" data-value="20" title="20">
                😄
            </button>
        </div>

        <div class="text-danger small">{{ form_errors(form.noteAttribuee) }}</div>
    </div>

    <div class="mb-3">
        {{ form_label(form.appreciationSpecifique, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.appreciationSpecifique) }}
        <div class="text-danger small">{{ form_errors(form.appreciationSpecifique) }}</div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path('evaluation_show', {idEvaluation: evaluation.idEvaluation}) }}" class="btn btn-outline-light">Annuler</a>
    </div>

    {# Script pour gérer la sélection de l'emoji #}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.querySelector('.js-note-attribuee-input');
            const buttons = document.querySelectorAll('.emoji-score');

            if (!input || buttons.length === 0) {
                return;
            }

            // Initialisation : si une valeur est déjà présente, activer le bouton correspondant
            const currentValue = input.value;
            if (currentValue !== '') {
                buttons.forEach(function (b) {
                    b.classList.remove('active', 'btn-primary');
                    b.classList.add('btn-outline-light');
                });

                buttons.forEach(function (btn) {
                    if (btn.dataset.value === currentValue) {
                        btn.classList.add('btn-primary', 'active');
                        btn.classList.remove('btn-outline-light');
                    }
                });
            }

            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const value = this.dataset.value;

                    // Met à jour le champ caché
                    input.value = value;

                    // Met à jour le style actif
                    buttons.forEach(function (b) {
                        b.classList.remove('active', 'btn-primary');
                        b.classList.add('btn-outline-light');
                    });

                    this.classList.remove('btn-outline-light');
                    this.classList.add('btn-primary', 'active');
                });
            });
        });
    </script>
{{ form_end(form) }}
