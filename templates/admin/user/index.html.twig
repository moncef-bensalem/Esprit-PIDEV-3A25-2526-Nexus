{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}
{% block page_title %}Gestion des Utilisateurs{% endblock %}

{% block stylesheets %}
<style>
    /* ── Page lead ── */
    .page-lead { font-size: .85rem; color: rgba(255,255,255,.35); margin-top: 2px; }

    /* ── Utilities ── */
    .nx-panel {
        background: rgba(13,25,42,.7);
        border: 1px solid rgba(32,178,170,.15);
        border-radius: 18px; padding: 24px;
        backdrop-filter: blur(8px);
        margin-bottom: 24px;
    }

    /* ── Actions bar ── */
    .nx-actions-bar {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 24px; gap: 16px; flex-wrap: wrap;
    }
    .btn-create {
        background: linear-gradient(135deg, #20b2aa, #0288d1);
        border: none; border-radius: 12px;
        color: #fff; font-size: .88rem; font-weight: 600;
        padding: 10px 20px; display: inline-flex; align-items: center; gap: 8px;
        transition: all .25s; text-decoration: none;
    }
    .btn-create:hover {
        transform: translateY(-2px); box-shadow: 0 8px 20px rgba(2,136,209,.4); color: #fff;
    }

    /* ── Filters ── */
    .nx-filter-form { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
    .nx-filter-group { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 200px; }
    .nx-filter-label { font-size: .78rem; font-weight: 500; color: rgba(255,255,255,.45); text-transform: uppercase; letter-spacing: .5px; }
    .nx-filter-input, .nx-filter-select {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(32,178,170,.2);
        border-radius: 10px; padding: 10px 14px;
        color: #fff; font-size: .88rem; transition: all .2s; outline: none;
    }
    .nx-filter-input::placeholder { color: rgba(255,255,255,.2); }
    .nx-filter-input:focus, .nx-filter-select:focus {
        border-color: rgba(32,178,170,.6); background: rgba(32,178,170,.06);
    }
    .nx-filter-select option { background: #0d1b2a; color: #fff; }
    
    .btn-search {
        background: rgba(32,178,170,.15);
        border: 1px solid rgba(32,178,170,.3);
        border-radius: 10px; color: #20b2aa;
        padding: 10px 18px; font-weight: 600; font-size: .88rem;
        transition: all .2s; cursor: pointer;
    }
    .btn-search:hover { background: rgba(32,178,170,.25); color: #fff; }
    
    .btn-clear {
        background: transparent; border: 1px solid rgba(255,255,255,.1);
        border-radius: 10px; color: rgba(255,255,255,.5);
        padding: 10px 18px; font-size: .88rem; text-decoration: none;
        transition: all .2s; display: inline-flex; align-items: center; justify-content: center;
    }
    .btn-clear:hover { background: rgba(255,255,255,.05); color: #fff; }

    /* ── Table ── */
    .table-container { overflow-x: auto; }
    .nx-table { width: 100%; border-collapse: separate; border-spacing: 0 8px; }
    
    .nx-table th {
        font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .8px;
        color: rgba(255,255,255,.4); padding: 12px 18px; border-bottom: 1px solid rgba(32,178,170,.1);
    }
    
    .nx-table tbody tr {
        background: rgba(255,255,255,.02);
        transition: transform .2s, background .2s;
    }
    .nx-table tbody tr:hover { background: rgba(32,178,170,.05); transform: translateY(-1px); }
    
    .nx-table td {
        padding: 16px 18px; font-size: .88rem; color: rgba(255,255,255,.8);
        border-top: 1px solid rgba(32,178,170,.1); border-bottom: 1px solid rgba(32,178,170,.1);
        vertical-align: middle;
    }
    .nx-table td:first-child { border-left: 1px solid rgba(32,178,170,.1); border-radius: 12px 0 0 12px; }
    .nx-table td:last-child { border-right: 1px solid rgba(32,178,170,.1); border-radius: 0 12px 12px 0; text-align: right; }

    /* ── Badges & Status ── */
    .nx-badge {
        font-size: .7rem; font-weight: 600; padding: 4px 10px; border-radius: 20px;
        background: rgba(32,178,170,.1); color: #20b2aa; border: 1px solid rgba(32,178,170,.2);
        display: inline-block; margin-right: 4px;
    }
    .nx-badge.admin { background: rgba(171,71,188,.1); color: #ab47bc; border-color: rgba(171,71,188,.2); }
    
    .nx-status { font-size: .78rem; display: inline-flex; align-items: center; gap: 6px; }
    .nx-status::before { content:''; width: 8px; height: 8px; border-radius: 50%; }
    .nx-status.active { color: #4caf50; }
    .nx-status.active::before { background: #4caf50; box-shadow: 0 0 8px #4caf50; }
    .nx-status.inactive { color: #ef5350; }
    .nx-status.inactive::before { background: #ef5350; box-shadow: 0 0 8px #ef5350; }

    /* ── Row Actions ── */
    .nx-row-actions { display: flex; gap: 8px; justify-content: flex-end; align-items: center; }
    .nx-btn-icon {
        width: 32px; height: 32px; border-radius: 8px;
        background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
        display: inline-flex; align-items: center; justify-content: center;
        color: rgba(255,255,255,.6); font-size: .85rem; cursor: pointer; transition: all .2s; outline: none; text-decoration: none;
    }
    .nx-btn-icon:hover { background: rgba(255,255,255,.1); color: #fff; }
    
    .nx-btn-icon.toggle-on { color: #4caf50; background: rgba(76,175,80,.1); border-color: rgba(76,175,80,.2); }
    .nx-btn-icon.toggle-on:hover { background: #4caf50; color: #fff; }
    
    .nx-btn-icon.toggle-off { color: #ef5350; background: rgba(239,83,80,.1); border-color: rgba(239,83,80,.2); }
    .nx-btn-icon.toggle-off:hover { background: #ef5350; color: #fff; }
    
    .nx-btn-icon.edit { color: #29b6f6; background: rgba(41,182,246,.1); border-color: rgba(41,182,246,.2); }
    .nx-btn-icon.edit:hover { background: #29b6f6; color: #fff; }

    /* ── Empty State ── */
    .nx-empty {
        text-align: center; padding: 40px 20px; color: rgba(255,255,255,.4);
    }
    .nx-empty i { font-size: 2.5rem; margin-bottom: 16px; color: rgba(32,178,170,.3); }

    /* ── Flash message ── */
    .nx-alert {
        background: rgba(76,175,80,.1); border: 1px solid rgba(76,175,80,.3);
        border-radius: 12px; padding: 14px 20px; color: #4caf50; font-size: .88rem;
        display: flex; align-items: center; gap: 10px; margin-bottom: 24px;
    }
</style>
{% endblock %}

{% block content %}

{# ── Header ── #}
<div class="nx-actions-bar">
    <div>
        <h1 style="font-size: 1.4rem; font-weight: 700; color: #fff; margin: 0;">Gestion des Utilisateurs</h1>
        <p class="page-lead">Consultez, modifiez et gérez les comptes de la plateforme.</p>
    </div>
    <a href="{{ path('admin_user_new') }}" class="btn-create">
        <i class="fa fa-plus"></i> Nouvel utilisateur
    </a>
</div>

{# Flash #}
{% for message in app.flashes('success') %}
    <div class="nx-alert">
        <i class="fa fa-check-circle"></i> {{ message }}
    </div>
{% endfor %}

{# ── Filters ── #}
<div class="nx-panel" style="padding: 20px 24px;">
    <form method="get" class="nx-filter-form" id="user-filter-form" data-search-url="{{ path('admin_user_search') }}">
        <div class="nx-filter-group">
            <label class="nx-filter-label">Rechercher</label>
            <input type="text" name="q" value="{{ currentQuery|default('') }}" class="nx-filter-input" placeholder="Nom, Email..." id="user-search-input" autocomplete="off">
        </div>
        <div class="nx-filter-group" style="flex: 0 1 200px;">
            <label class="nx-filter-label">Rôle</label>
            <select name="role" class="nx-filter-select" id="user-role-select">
                <option value="">Tous les rôles</option>
                <option value="ROLE_ADMIN" {% if currentRole == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur</option>
                <option value="ROLE_CANDIDATE" {% if currentRole == 'ROLE_CANDIDATE' %}selected{% endif %}>Candidat</option>
            </select>
        </div>
        <div style="display: flex; gap: 8px;">
            <button type="submit" class="btn-search">
                <i class="fa fa-search"></i> Filtrer
            </button>
            {% if currentQuery or currentRole %}
                <a href="{{ path('admin_user_index') }}" class="btn-clear" title="Effacer les filtres">
                    <i class="fa fa-times"></i>
                </a>
            {% endif %}
        </div>
    </form>
</div>

{# ── Table ── #}
<div class="table-container">
    <table class="nx-table">
        <thead>
            <tr>
                <th width="60">ID</th>
                <th>Utilisateur</th>
                <th>Contact</th>
                <th>Rôles</th>
                <th>Statut</th>
                <th style="text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody id="users-tbody">
            {% include 'admin/user/_rows.html.twig' with { users: users } %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block javascripts %}
<script>
(() => {
    const form = document.getElementById('user-filter-form');
    if (!form) return;

    const input = document.getElementById('user-search-input');
    const roleSelect = document.getElementById('user-role-select');
    const tbody = document.getElementById('users-tbody');
    const searchUrl = form.dataset.searchUrl;

    let debounceTimer = null;
    let activeController = null;

    function buildUrl() {
        const url = new URL(searchUrl, window.location.origin);
        url.searchParams.set('q', (input?.value ?? '').trim());
        url.searchParams.set('role', roleSelect?.value ?? '');
        return url.toString();
    }

    async function runSearch() {
        if (activeController) activeController.abort();
        activeController = new AbortController();

        const res = await fetch(buildUrl(), {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'text/html'
            },
            signal: activeController.signal
        });

        if (!res.ok) return;
        const html = await res.text();
        tbody.innerHTML = html;

        // Met à jour l’URL sans recharger (utile pour le prof)
        const current = new URL(window.location.href);
        current.searchParams.set('q', (input?.value ?? '').trim());
        current.searchParams.set('role', roleSelect?.value ?? '');
        window.history.replaceState({}, '', current.toString());
    }

    function scheduleSearch() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => runSearch().catch(() => {}), 350);
    }

    // Empêche le submit (page reload) → on veut AJAX
    form.addEventListener('submit', (e) => {
        e.preventDefault();
        runSearch().catch(() => {});
    });

    input?.addEventListener('input', scheduleSearch);
    roleSelect?.addEventListener('change', () => runSearch().catch(() => {}));
})();
</script>
{% endblock %}
