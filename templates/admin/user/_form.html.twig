<div class="card card-glass mb-4">
    <div class="card-body p-4">
        {{ form_start(form) }}
        <div class="row">
            <div class="col-md-6 mb-4">
                {{ form_label(form.firstName, 'Prénom') }}
                {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
            </div>
            <div class="col-md-6 mb-4">
                {{ form_label(form.lastName, 'Nom') }}
                {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
            </div>
        </div>
        <div class="mb-4">
            {{ form_label(form.email, 'Email') }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
        </div>
        <div class="mb-4">
            {{ form_label(form.roles, 'Rôles') }}
            {{ form_widget(form.roles, {'attr': {'class': 'form-select form-control'}}) }}
        </div>
        <div class="mb-4">
            {{ form_label(form.plainPassword, 'Mot de passe') }}
            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Nouveau mot de passe'}}) }}
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="{{ path('admin_user_index') }}" class="btn btn-outline-light px-4">Annuler</a>
            <button class="btn btn-glass-primary px-5">{{ button_label|default('Enregistrer') }}</button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
