{% extends 'base.html.twig' %}

{% block title %}Candidate Dashboard{% endblock %}

{% block stylesheets %}
<style>
    body { background-color: #0d1b2a; color: #fff; font-family: 'Segoe UI', sans-serif; }
    
    /* Retire la limitation de largeur du main container */
    main.container { max-width: 100%; padding-top: 0 !important; }

    .dashboard-header {
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 1rem;
    }

    .stats-card {
        border-radius: 14px;
        padding: 24px;
        min-width: 160px;
        border: 2px solid transparent;
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative;
        overflow: hidden;
    }
    .stats-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); cursor: pointer; }

    .stats-card::after {
        content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        opacity: 0; transition: opacity 0.3s;
    }
    .stats-card:hover::after { opacity: 1; }

    .stats-card.cyan  { border-color: #00bcd4; background: rgba(0,188,212,0.08); }
    .stats-card.purple { border-color: #ab47bc; background: rgba(171,71,188,0.08); }

    .stats-icon {
        font-size: 3rem;
        position: absolute;
        right: -10px;
        bottom: -15px;
        opacity: 0.15;
        transition: transform 0.3s;
    }
    .stats-card:hover .stats-icon { transform: scale(1.1); }

    .stats-number { font-size: 2.8rem; font-weight: 800; margin-top: 5px; line-height: 1; }
    .stats-label  { font-size: 0.85rem; color: #9ab; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }

    .quick-actions-card {
        background: #15273b;
        border-radius: 14px;
        padding: 24px;
        border: 1px solid #1a2f45;
        height: 100%;
    }

    .btn-glass {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        backdrop-filter: blur(10px);
        transition: all 0.2s;
        text-decoration: none;
        flex: 1;
        min-width: 150px;
    }
    .btn-glass:hover { background: rgba(255,255,255,0.15); color: #fff; border-color: rgba(255,255,255,0.3); }

</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4" style="margin-left: 70px; max-width: calc(100% - 70px);">
        
        <div class="dashboard-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-2 text-white fw-bold">Espace Candidat</h1>
                <p class="text-muted mb-0">Retrouvez le suivi de vos candidatures et de votre agenda.</p>
            </div>
            <div>
                <span class="badge bg-info text-dark px-3 py-2 fs-6 rounded-pill shadow-sm">Candidat</span>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <a href="{{ path('app_public_suivi', {'email': app.user.userIdentifier}) }}" style="text-decoration:none; color:inherit;">
                    <div class="stats-card cyan shadow-sm">
                        <span class="stats-icon">📄</span>
                        <div class="stats-label">Mes Candidatures</div>
                        <div class="stats-number">{{ myApplications }}</div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <div class="stats-card purple shadow-sm">
                    <span class="stats-icon">🎯</span>
                    <div class="stats-label">Mes Entretiens</div>
                    <div class="stats-number">{{ myInterviews }}</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-12">
                <div class="quick-actions-card shadow">
                    <h5 class="mb-4 text-white fw-semibold border-bottom border-secondary pb-3">Actions Rapides</h5>
                    <div class="d-flex gap-3 flex-wrap mt-3">
                        <a href="{{ path('app_public_offres') }}" class="btn btn-glass px-4 py-4 rounded-4 d-flex flex-column align-items-center justify-content-center gap-2">
                            <span style="font-size: 1.5rem;">💼</span>
                            <span class="fw-medium">Explorer les Offres</span>
                        </a>
                        <a href="{{ path('planification_index') }}" class="btn btn-glass px-4 py-4 rounded-4 d-flex flex-column align-items-center justify-content-center gap-2">
                            <span style="font-size: 1.5rem;">📆</span>
                            <span class="fw-medium">Mon Planning</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
