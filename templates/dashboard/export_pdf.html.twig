<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport d'activité Nexus</title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #1a1a1a; margin: 0; padding: 40px; }
        .header { border-bottom: 2px solid #20b2aa; padding-bottom: 20px; margin-bottom: 30px; text-align: center; }
        .logo-text { font-size: 28px; font-weight: bold; color: #0d192a; letter-spacing: 2px; }
        .report-title { font-size: 20px; color: #20b2aa; margin-top: 10px; text-transform: uppercase; }
        .meta { font-size: 12px; color: #666; margin-top: 10px; }
        
        .section-title { font-size: 18px; border-left: 4px solid #20b2aa; padding-left: 10px; margin: 30px 0 20px; color: #0d192a; }
        
        .stat-grid { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .stat-card { background: #f8fbfb; border: 1px solid #e0eeee; padding: 20px; text-align: center; width: 30%; }
        .stat-value { font-size: 24px; font-weight: bold; color: #0d192a; }
        .stat-label { font-size: 12px; color: #666; text-transform: uppercase; margin-top: 5px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th { background-color: #f2f2f2; color: #333; font-weight: bold; padding: 12px; border: 1px solid #ddd; text-align: left; font-size: 13px; }
        td { padding: 10px; border: 1px solid #ddd; font-size: 13px; }
        tr:nth-child(even) { background-color: #fafafa; }
        
        .footer { position: fixed; bottom: 0; left: 0; right: 0; font-size: 10px; color: #999; text-align: center; border-top: 1px solid #eee; padding-top: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo-text">NEXUS</div>
        <div class="report-title">Rapport de Synthèse Platforme</div>
        <div class="meta">Généré le {{ "now"|date("d/m/Y H:i") }}</div>
    </div>

    <div class="section-title">Indicateurs Clés</div>
    <table class="stat-grid">
        <tr>
            <td class="stat-card">
                <div class="stat-value">{{ totalUsers }}</div>
                <div class="stat-label">Utilisateurs</div>
            </td>
            <td style="width: 5%"></td>
            <td class="stat-card">
                <div class="stat-value">{{ totalCandidates }}</div>
                <div class="stat-label">Candidats</div>
            </td>
            <td style="width: 5%"></td>
            <td class="stat-card">
                <div class="stat-value">{{ totalInterviews }}</div>
                <div class="stat-label">Entretiens</div>
            </td>
        </tr>
    </table>

    <div class="section-title">Répartition des Rôles</div>
    <table>
        <thead>
            <tr>
                <th>Rôle</th>
                <th>Nombre d'utilisateurs</th>
                <th>Pourcentage</th>
            </tr>
        </thead>
        <tbody>
            {% for role, count in roleDistribution %}
            <tr>
                <td>{{ role }}</td>
                <td>{{ count }}</td>
                <td>{{ ((count / totalUsers) * 100)|number_format(1) }}%</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Nexus - Plateforme d'Intelligence de Talents &copy; {{ "now"|date("Y") }} - Document Confidentiel
    </div>
</body>
</html>
