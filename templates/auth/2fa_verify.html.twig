{% extends 'base.html.twig' %}

{% block title %}Validation 2FA — Nexus{% endblock %}

{% block stylesheets %}
<style>
  body { background:#070e17; }
  .wrap { min-height: 100vh; display:flex; align-items:center; justify-content:center; padding:24px; }
  .card {
    width:100%; max-width:460px;
    background: rgba(13,25,42,0.82); border: 1px solid rgba(32,178,170,.2);
    border-radius:24px; padding:34px; box-shadow: 0 25px 60px rgba(0,0,0,.5);
    backdrop-filter: blur(18px);
  }
  .title { color:#fff; font-size:1.2rem; font-weight:700; margin:0 0 6px; }
  .sub { color: rgba(255,255,255,.5); font-size:.88rem; margin:0 0 18px; }
  .field { display:flex; flex-direction:column; gap:8px; margin: 18px 0 14px; }
  .label { font-size:.78rem; font-weight:600; letter-spacing:.6px; text-transform:uppercase; color: rgba(32,178,170,.85); }
  .input {
    border-radius:12px; padding:14px 16px; font-size:1rem; letter-spacing: .35em;
    background: rgba(255,255,255,.04); border:1px solid rgba(32,178,170,.2); color:#fff; outline:none;
  }
  .input:focus { border-color: rgba(32,178,170,.6); background: rgba(32,178,170,.06); }
  .row { display:flex; gap:10px; align-items:center; justify-content:space-between; }
  .btn {
    width:100%; padding:13px 16px; border-radius:12px; border:none;
    background: linear-gradient(135deg, #20b2aa 0%, #0288d1 100%);
    color:#fff; font-weight:700; cursor:pointer;
  }
  .link { color: rgba(32,178,170,.8); text-decoration:none; font-weight:600; }
  .alert {
    background: rgba(239,83,80,.1); border:1px solid rgba(239,83,80,.3);
    border-radius:12px; padding:12px 14px; color:#ff8a80; font-size:.88rem;
  }
</style>
{% endblock %}

{% block body %}
<div class="wrap">
  <div class="card">
    <h1 class="title">Validation 2FA</h1>
    <p class="sub">
      Un code de <strong>8 chiffres</strong> a été envoyé à <strong>{{ email }}</strong>.
    </p>

    {% if error %}
      <div class="alert">{{ error }}</div>
    {% endif %}

    <form method="post" autocomplete="off">
      <div class="field">
        <label class="label" for="code">Code</label>
        <input class="input" id="code" name="code" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" placeholder="12345678" required>
      </div>

      <button class="btn" type="submit">Valider</button>
    </form>

    <div class="row" style="margin-top:16px;">
      <a class="link" href="{{ path('app_2fa_start', { resend: 1 }) }}">Renvoyer le code</a>
      <a class="link" href="{{ path('app_logout') }}">Se déconnecter</a>
    </div>
  </div>
</div>
{% endblock %}

