{% extends 'base.html.twig' %}

{% block title %}Créer un compte — Nexus{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Inter', sans-serif;
        background: #070e17;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-x: hidden;
        padding: 24px 16px;
    }

    /* ── Background ── */
    .bg-scene {
        position: fixed; inset: 0; z-index: 0; overflow: hidden;
    }
    .bg-scene::before {
        content: '';
        position: absolute;
        width: 700px; height: 700px; border-radius: 50%;
        background: radial-gradient(circle, rgba(32,178,170,.15) 0%, transparent 70%);
        top: -200px; left: -200px;
        animation: pulse1 9s ease-in-out infinite;
    }
    .bg-scene::after {
        content: '';
        position: absolute;
        width: 600px; height: 600px; border-radius: 50%;
        background: radial-gradient(circle, rgba(2,100,180,.13) 0%, transparent 70%);
        bottom: -150px; right: -100px;
        animation: pulse2 11s ease-in-out infinite;
    }
    @keyframes pulse1 { 0%,100%{transform:scale(1) translate(0,0)} 50%{transform:scale(1.15) translate(30px,20px)} }
    @keyframes pulse2 { 0%,100%{transform:scale(1) translate(0,0)} 50%{transform:scale(1.2) translate(-20px,-30px)} }

    .grid-bg {
        position: fixed; inset: 0; z-index: 0;
        background-image:
            linear-gradient(rgba(32,178,170,.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(32,178,170,.04) 1px, transparent 1px);
        background-size: 50px 50px;
    }
    .particles { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .particle {
        position: absolute; width: 3px; height: 3px; border-radius: 50%;
        background: rgba(32,178,170,.6);
        animation: float linear infinite;
    }
    @keyframes float {
        0%  { transform: translateY(100vh); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100%{ transform: translateY(-100px) translateX(60px); opacity: 0; }
    }

    /* ── Card wrapper ── */
    .register-wrapper {
        position: relative; z-index: 10;
        width: 100%; max-width: 560px;
        animation: slideUp .6s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes slideUp { from{opacity:0;transform:translateY(40px)} to{opacity:1;transform:translateY(0)} }

    .register-card {
        background: rgba(13,25,42,.85);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(32,178,170,.2);
        border-radius: 24px;
        padding: 40px 40px 32px;
        box-shadow: 0 0 0 1px rgba(32,178,170,.08), 0 25px 60px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.05);
    }

    /* ── Logo ── */
    .logo-wrapper { text-align: center; margin-bottom: 24px; }
    .logo-ring {
        display: inline-flex; align-items: center; justify-content: center;
        width: 80px; height: 80px; border-radius: 50%;
        border: 1.5px solid rgba(32,178,170,.35);
        box-shadow: 0 0 24px rgba(32,178,170,.18), inset 0 0 20px rgba(32,178,170,.06);
        margin-bottom: 12px;
        animation: glow 3s ease-in-out infinite;
        overflow: hidden;
    }
    .logo-ring img { width: 64px; height: 64px; object-fit: contain; border-radius: 50%; }
    @keyframes glow {
        0%,100%{box-shadow:0 0 20px rgba(32,178,170,.2),inset 0 0 20px rgba(32,178,170,.05)}
        50%{box-shadow:0 0 40px rgba(32,178,170,.35),inset 0 0 30px rgba(32,178,170,.1)}
    }
    .logo-title { font-size: 1.35rem; font-weight: 700; color: #fff; }
    .logo-subtitle { font-size: .78rem; color: rgba(32,178,170,.75); margin-top: 3px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 500; }
    .page-heading { text-align: center; margin-bottom: 26px; }
    .page-heading h1 { font-size: 1.15rem; font-weight: 600; color: rgba(255,255,255,.9); margin-bottom: 4px; }
    .page-heading p { font-size: .82rem; color: rgba(255,255,255,.35); }

    /* ── 2-col grid ── */
    .fields-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .field-full { grid-column: 1 / -1; }
    @media(max-width:500px){ .fields-grid { grid-template-columns: 1fr; } }

    /* ── Fields ── */
    .field-group { margin-bottom: 0; }
    .field-group.mb { margin-bottom: 16px; }
    .field-label {
        display: block; font-size: .77rem; font-weight: 500;
        color: rgba(32,178,170,.9); margin-bottom: 7px;
        letter-spacing: .4px; text-transform: uppercase;
    }
    .field-input-wrap { position: relative; }
    .field-icon {
        position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
        color: rgba(32,178,170,.45); font-size: .9rem; pointer-events: none; transition: color .2s;
    }
    .field-input {
        width: 100%;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(32,178,170,.2);
        border-radius: 12px;
        padding: 12px 13px 12px 40px;
        color: #fff; font-size: .9rem; font-family: 'Inter', sans-serif;
        transition: all .25s; outline: none;
    }
    .field-input::placeholder { color: rgba(255,255,255,.22); }
    .field-input:focus {
        border-color: rgba(32,178,170,.6);
        background: rgba(32,178,170,.06);
        box-shadow: 0 0 0 3px rgba(32,178,170,.1);
    }
    .field-input:focus ~ .field-icon,
    .field-input-wrap:focus-within .field-icon { color: rgba(32,178,170,.9); }
    .field-input.is-invalid { border-color: rgba(239,83,80,.6); background: rgba(239,83,80,.04); }
    .eye-btn {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        background: none; border: none; color: rgba(255,255,255,.3);
        cursor: pointer; padding: 2px; transition: color .2s; font-size: .9rem;
    }
    .eye-btn:hover { color: rgba(32,178,170,.9); }
    .invalid-msg { display: block; margin-top: 5px; font-size: .76rem; color: #ff8a80; padding-left: 3px; }
    .invalid-msg i { margin-right: 3px; }

    /* Password strength */
    .strength-bar { height: 3px; border-radius: 2px; margin-top: 7px; background: rgba(255,255,255,.08); overflow: hidden; }
    .strength-fill { height: 100%; border-radius: 2px; width: 0; transition: width .4s, background .4s; }
    .strength-label { font-size: .73rem; color: rgba(255,255,255,.35); margin-top: 4px; }

    /* ── Separator ── */
    .section-sep {
        border: none; border-top: 1px solid rgba(32,178,170,.1); margin: 22px 0;
    }

    /* ── Submit ── */
    .btn-submit {
        width: 100%; padding: 14px;
        background: linear-gradient(135deg, #20b2aa 0%, #0288d1 100%);
        border: none; border-radius: 12px; color: #fff;
        font-size: .95rem; font-weight: 600; font-family: 'Inter', sans-serif;
        letter-spacing: .4px; cursor: pointer; transition: all .25s;
        position: relative; overflow: hidden; margin-top: 22px;
    }
    .btn-submit::before {
        content: ''; position: absolute; top: -50%; left: -60%;
        width: 40%; height: 200%; background: rgba(255,255,255,.2);
        transform: skewX(-20deg); transition: left .5s;
    }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(2,136,209,.4); }
    .btn-submit:hover::before { left: 120%; }
    .btn-submit .spinner { display:none; width:18px; height:18px; border:2px solid rgba(255,255,255,.4); border-top-color:#fff; border-radius:50%; animation:spin .7s linear infinite; margin:0 auto; }
    @keyframes spin { to{transform:rotate(360deg)} }
    .btn-submit.loading .btn-label { display:none; }
    .btn-submit.loading .spinner { display:block; }

    /* ── Footer ── */
    .login-link { margin-top: 18px; text-align: center; font-size: .84rem; color: rgba(255,255,255,.35); }
    .login-link a { color: rgba(32,178,170,.9); font-weight: 600; text-decoration: none; transition: color .2s; }
    .login-link a:hover { color: #20b2aa; }

    /* ── Steps indicator ── */
    .steps { display: flex; gap: 6px; justify-content: center; margin-bottom: 24px; }
    .step-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: rgba(32,178,170,.2); border: 1px solid rgba(32,178,170,.3);
        transition: all .3s;
    }
    .step-dot.active { background: #20b2aa; box-shadow: 0 0 8px rgba(32,178,170,.5); width: 24px; border-radius: 4px; }

    /* Flash success */
    .alert-success-box {
        background: rgba(32,178,170,.1); border: 1px solid rgba(32,178,170,.3);
        border-radius: 12px; padding: 14px 16px; margin-bottom: 18px;
        display: flex; align-items: center; gap: 10px;
        font-size: .88rem; color: rgba(32,178,170,.9);
    }

    @media(max-width:500px){
        .register-card { padding: 28px 18px 24px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="bg-scene"></div>
<div class="grid-bg"></div>
<div class="particles" id="particles"></div>

<main class="register-wrapper">
    <div class="register-card">

        {# Logo #}
        <div class="logo-wrapper">
            <div class="logo-ring">
                <img src="{{ asset('nexus.jpg') }}" alt="Logo Nexus">
            </div>
            <div class="logo-title">Nexus</div>
            <div class="logo-subtitle">Talent Intelligence Platform</div>
        </div>

        <div class="page-heading">
            <h1>Créer votre compte</h1>
            <p>Rejoignez la plateforme et démarrez votre parcours</p>
        </div>

        {# Success flash #}
        {% for msg in app.flashes('success') %}
            <div class="alert-success-box"><i class="fa fa-check-circle"></i> {{ msg }}</div>
        {% endfor %}

        {# Registration form #}
        {{ form_start(registrationForm, {'attr': {'id': 'register-form', 'novalidate': 'novalidate'}}) }}

        <div class="fields-grid">

            {# Prénom #}
            <div class="field-group">
                <label class="field-label" for="{{ registrationForm.firstName.vars.id }}">
                    Prénom
                </label>
                <div class="field-input-wrap">
                    <i class="fa fa-user field-icon"></i>
                    {{ form_widget(registrationForm.firstName, {
                        'attr': {
                            'class': 'field-input' ~ (registrationForm.firstName.vars.errors|length > 0 ? ' is-invalid' : ''),
                            'placeholder': 'Votre prénom'
                        }
                    }) }}
                </div>
                {% for error in registrationForm.firstName.vars.errors %}
                    <span class="invalid-msg"><i class="fa fa-times-circle"></i>{{ error.message }}</span>
                {% endfor %}
            </div>

            {# Nom #}
            <div class="field-group">
                <label class="field-label" for="{{ registrationForm.lastName.vars.id }}">
                    Nom
                </label>
                <div class="field-input-wrap">
                    <i class="fa fa-user field-icon"></i>
                    {{ form_widget(registrationForm.lastName, {
                        'attr': {
                            'class': 'field-input' ~ (registrationForm.lastName.vars.errors|length > 0 ? ' is-invalid' : ''),
                            'placeholder': 'Votre nom'
                        }
                    }) }}
                </div>
                {% for error in registrationForm.lastName.vars.errors %}
                    <span class="invalid-msg"><i class="fa fa-times-circle"></i>{{ error.message }}</span>
                {% endfor %}
            </div>

            {# Email #}
            <div class="field-group field-full">
                <label class="field-label" for="{{ registrationForm.email.vars.id }}">
                    Adresse email
                </label>
                <div class="field-input-wrap">
                    <i class="fa fa-envelope field-icon"></i>
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'field-input' ~ (registrationForm.email.vars.errors|length > 0 ? ' is-invalid' : ''),
                            'placeholder': 'vous@exemple.com'
                        }
                    }) }}
                </div>
                {% for error in registrationForm.email.vars.errors %}
                    <span class="invalid-msg"><i class="fa fa-times-circle"></i>{{ error.message }}</span>
                {% endfor %}
            </div>

            {# Mot de passe #}
            <div class="field-group field-full">
                <label class="field-label" for="{{ registrationForm.plainPassword.first.vars.id }}">
                    Mot de passe
                </label>
                <div class="field-input-wrap">
                    <i class="fa fa-lock field-icon"></i>
                    {{ form_widget(registrationForm.plainPassword.first, {
                        'attr': {
                            'class': 'field-input' ~ (registrationForm.plainPassword.vars.errors|length > 0 ? ' is-invalid' : ''),
                            'placeholder': '••••••••',
                            'id': 'pwd1'
                        }
                    }) }}
                    <button type="button" class="eye-btn" data-target="pwd1" aria-label="Voir le mot de passe">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
                <div class="strength-bar"><div class="strength-fill" id="strength-fill"></div></div>
                <div class="strength-label" id="strength-label"></div>
            </div>

            {# Confirmer mot de passe #}
            <div class="field-group field-full">
                <label class="field-label" for="{{ registrationForm.plainPassword.second.vars.id }}">
                    Confirmer le mot de passe
                </label>
                <div class="field-input-wrap">
                    <i class="fa fa-lock field-icon"></i>
                    {{ form_widget(registrationForm.plainPassword.second, {
                        'attr': {
                            'class': 'field-input' ~ (registrationForm.plainPassword.vars.errors|length > 0 ? ' is-invalid' : ''),
                            'placeholder': '••••••••',
                            'id': 'pwd2'
                        }
                    }) }}
                    <button type="button" class="eye-btn" data-target="pwd2" aria-label="Voir le mot de passe">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>
                {% for error in registrationForm.plainPassword.vars.errors %}
                    <span class="invalid-msg"><i class="fa fa-times-circle"></i>{{ error.message }}</span>
                {% endfor %}
            </div>

        </div>{# /fields-grid #}

        <button type="submit" class="btn-submit" id="submit-btn">
            <span class="btn-label">Créer mon compte &nbsp;<i class="fa fa-user-plus"></i></span>
            <span class="spinner"></span>
        </button>

        {{ form_end(registrationForm) }}

        <div class="login-link">
            Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
        </div>

    </div>
</main>

<script>
/* Particles */
(function(){
    const c = document.getElementById('particles');
    for(let i=0;i<16;i++){
        const p=document.createElement('div'); p.className='particle';
        p.style.cssText=`left:${Math.random()*100}%;width:${Math.random()*3+1}px;height:${Math.random()*3+1}px;opacity:${Math.random()*.5+.2};animation-duration:${Math.random()*12+8}s;animation-delay:${Math.random()*10}s`;
        c.appendChild(p);
    }
})();

/* Eye toggles */
document.querySelectorAll('.eye-btn').forEach(btn => {
    btn.addEventListener('click', function(){
        const target = document.getElementById(this.dataset.target);
        const icon = this.querySelector('i');
        if(target.type==='password'){ target.type='text'; icon.className='fa fa-eye-slash'; }
        else { target.type='password'; icon.className='fa fa-eye'; }
    });
});

/* Password strength */
const pwd1 = document.getElementById('pwd1');
const fill = document.getElementById('strength-fill');
const label = document.getElementById('strength-label');
if(pwd1 && fill){
    pwd1.addEventListener('input', function(){
        const v = this.value;
        let score = 0;
        if(v.length >= 8) score++;
        if(/[A-Z]/.test(v)) score++;
        if(/[0-9]/.test(v)) score++;
        if(/[^A-Za-z0-9]/.test(v)) score++;
        const levels = [
            {w:'0%', c:'transparent', t:''},
            {w:'25%', c:'#ef5350', t:'Faible'},
            {w:'50%', c:'#ff9800', t:'Moyen'},
            {w:'75%', c:'#29b6f6', t:'Bien'},
            {w:'100%', c:'#20b2aa', t:'Très sécurisé'},
        ];
        const l = levels[score] || levels[0];
        fill.style.width = l.w;
        fill.style.background = l.c;
        label.textContent = l.t;
        label.style.color = l.c;
    });
}

/* Submit loader */
document.getElementById('register-form').addEventListener('submit', function(){
    const btn = document.getElementById('submit-btn');
    btn.classList.add('loading'); btn.disabled = true;
    setTimeout(()=>{ btn.classList.remove('loading'); btn.disabled=false; }, 10000);
});
</script>
{% endblock %}
