{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
<style>
    body { background-color: #0d1b2a; color: #fff; font-family: 'Segoe UI', sans-serif; }
    .card-glass {
        background: #15273b;
        border-radius: 14px;
        border: 1px solid #1a2f45;
        color: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .card-header-glass {
        background: rgba(255,255,255,0.02);
        border-bottom: 1px solid #1a2f45;
        font-weight: 700;
        font-size: 1.25rem;
        padding: 20px;
        color: #fff;
        border-radius: 14px 14px 0 0;
    }
    .form-control {
        background: #0d1b2a;
        border: 1px solid #1a2f45;
        color: #fff !important;
        border-radius: 8px;
        padding: 12px 15px;
    }
    .form-control:focus {
        background: #0d1b2a;
        border-color: #4fc3f7;
        box-shadow: 0 0 0 0.25rem rgba(79, 195, 247, 0.25);
    }
    .form-label { color: #9ab; font-weight: 500; font-size: 0.9rem; margin-bottom: 8px; }
    .btn-glass-primary {
        background: linear-gradient(135deg, #4fc3f7, #0288d1);
        border: none;
        color: #fff;
        border-radius: 8px;
        font-weight: 600;
        padding: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-glass-primary:hover {
        background: linear-gradient(135deg, #29b6f6, #0277bd);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(2, 136, 209, 0.3);
    }
    a.glass-link { color: #4fc3f7; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
    a.glass-link:hover { color: #81d4fa; text-decoration: underline; }
</style>
{% endblock %}

{% block body %}
    <div class="row justify-content-center align-items-center mt-5">
        <div class="col-md-5">
            <div class="card card-glass">
                <div class="card-header-glass text-center">Connexion à Nexus</div>
                <div class="card-body p-4">
                    {% if error %}
                        {% if 'suspendu' in error.messageKey %}
                            <div class="text-center py-4 px-3 mb-4" style="background: rgba(244, 67, 54, 0.08); border: 1px solid rgba(244, 67, 54, 0.3); border-radius: 12px;">
                                <div style="font-size: 2.5rem; margin-bottom: 10px;">🛑</div>
                                <h5 class="fw-bold" style="color: #ef5350;">Compte Suspendu</h5>
                                <p class="mb-0" style="color: #9ab; font-size: 0.9rem;">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                            </div>
                        {% else %}
                            <div class="alert alert-danger" style="background: rgba(220, 53, 69, 0.1); border-color: rgba(220, 53, 69, 0.3); color: #ff6b6b;">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}
                    {% endif %}
                    <form method="post">
                        <div class="mb-4">
                            <label class="form-label" for="username">Adresse email</label>
                            <input type="email" id="username" name="_username" value="{{ last_username }}" required class="form-control" autocomplete="email" placeholder="Entrez votre email">
                        </div>
                        <div class="mb-4">
                            <label class="form-label" for="password">Mot de passe</label>
                            <input type="password" id="password" name="_password" required class="form-control" autocomplete="current-password" placeholder="Mot de passe">
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <button class="btn btn-glass-primary w-100 mt-2" type="submit">Se connecter</button>
                    </form>
                    <div class="mt-4 d-flex justify-content-between">
                        <a href="{{ path('app_register') }}" class="glass-link">Créer un compte</a>
                        <a href="{{ path('app_forgot_password_request') }}" class="glass-link">Mot de passe oublié ?</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
