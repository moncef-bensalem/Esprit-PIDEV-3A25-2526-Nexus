{% extends 'base.html.twig' %}

{% block title %}Connexion — Nexus{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: #070e17; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
    .bg-scene { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
    .bg-scene::before { content: ''; position: absolute; width: 700px; height: 700px; border-radius: 50%; background: radial-gradient(circle, rgba(32,178,170,.18) 0%, transparent 70%); top: -200px; left: -200px; animation: pulse1 8s ease-in-out infinite; }
    .bg-scene::after { content: ''; position: absolute; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(2,100,180,.15) 0%, transparent 70%); bottom: -150px; right: -150px; animation: pulse2 10s ease-in-out infinite; }
    @keyframes pulse1 { 0%, 100% { transform: scale(1) translate(0,0); } 50% { transform: scale(1.15) translate(30px, 20px); } }
    @keyframes pulse2 { 0%, 100% { transform: scale(1) translate(0,0); } 50% { transform: scale(1.2) translate(-20px, -30px); } }
    .grid-bg { position: fixed; inset: 0; background-image: linear-gradient(rgba(32,178,170,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(32,178,170,.04) 1px, transparent 1px); background-size: 50px 50px; z-index: 0; }
    .particles { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .particle { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: rgba(32,178,170,.6); animation: float linear infinite; }
    @keyframes float { 0% { transform: translateY(100vh) translateX(0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translateY(-100px) translateX(80px); opacity: 0; } }
    .login-wrapper { position: relative; z-index: 10; width: 100%; max-width: 460px; padding: 20px; animation: slideUp .6s cubic-bezier(.16,1,.3,1) both; }
    @keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
    .login-card { background: rgba(13, 25, 42, 0.82); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(32,178,170,.2); border-radius: 24px; padding: 40px; box-shadow: 0 0 0 1px rgba(32,178,170,.08), 0 25px 60px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.05); }
    .logo-wrapper { text-align: center; margin-bottom: 24px; }
    .logo-ring { display: inline-flex; align-items: center; justify-content: center; width: 88px; height: 88px; border-radius: 50%; border: 1.5px solid rgba(32,178,170,.35); box-shadow: 0 0 24px rgba(32,178,170,.18), inset 0 0 24px rgba(32,178,170,.06); margin-bottom: 12px; animation: glow 3s ease-in-out infinite; overflow: hidden; }
    .logo-ring img { width: 68px; height: 68px; object-fit: contain; border-radius: 50%; }
    @keyframes glow { 0%, 100% { box-shadow: 0 0 20px rgba(32,178,170,.2), inset 0 0 20px rgba(32,178,170,.05); } 50% { box-shadow: 0 0 40px rgba(32,178,170,.35), inset 0 0 30px rgba(32,178,170,.1); } }
    .logo-title { font-size: 1.5rem; font-weight: 700; color: #fff; }
    .logo-subtitle { font-size: .8rem; color: rgba(32,178,170,.75); margin-top: 2px; text-transform: uppercase; letter-spacing: 1px; font-weight: 500; }
    
    .divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; color: rgba(255,255,255,.2); font-size: .75rem; text-transform: uppercase; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.1); }
    
    .btn-google { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: #fff; font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.2s; text-decoration: none; }
    .btn-google:hover { background: rgba(255,255,255,0.1); border-color: rgba(32,178,170,0.4); }
    .btn-google img { width: 20px; height: 20px; object-fit: contain; }
    
    .field-group { margin-bottom: 18px; }
    .field-label { display: block; font-size: .8rem; font-weight: 500; color: rgba(32,178,170,.9); margin-bottom: 8px; text-transform: uppercase; }
    .field-input-wrap { position: relative; }
    .field-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: rgba(32,178,170,0.4); font-size: .9rem; pointer-events: none; }
    .field-input { width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(32,178,170,0.2); border-radius: 12px; padding: 12px 14px 12px 42px; color: #fff; outline: none; transition: all 0.25s; }
    .field-input:focus { border-color: rgba(32,178,170,0.6); background: rgba(32,178,170,0.06); }
    .eye-btn { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: rgba(255,255,255,0.3); cursor: pointer; }
    
    .remember-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; font-size: 0.8rem; }
    .remember-label { display: flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.5); cursor: pointer; }
    .forgot-link { color: rgba(32,178,170,0.7); text-decoration: none; }
    
    .btn-submit { width: 100%; padding: 14px; background: linear-gradient(135deg, #20b2aa 0%, #0288d1 100%); border: none; border-radius: 12px; color: #fff; font-weight: 600; cursor: pointer; transition: 0.3s; }
    .btn-submit.loading .btn-label { display: none; }
    .btn-submit .spinner { display: none; width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn-submit.loading .spinner { display: block; }
    
    .register-teaser { text-align: center; margin-top: 20px; font-size: 0.85rem; color: rgba(255,255,255,0.4); }
    .register-teaser a { color: #20b2aa; font-weight: 600; text-decoration: none; }
    
    .alert-error { background: rgba(239,83,80,0.1); border: 1px solid rgba(239,83,80,0.3); border-radius: 12px; padding: 12px; margin-bottom: 20px; color: #ff8a80; font-size: 0.85rem; display: flex; gap: 10px; }
</style>
{% endblock %}

{% block body %}
<div class="bg-scene"></div>
<div class="grid-bg"></div>
<div class="particles" id="particles"></div>

<main class="login-wrapper">
    <div class="login-card">
        <div class="logo-wrapper">
            <div class="logo-ring"><img src="{{ asset('nexus.jpg') }}" alt="Logo Nexus"></div>
            <div class="logo-title">Nexus</div>
            <div class="logo-subtitle">Authentification</div>
        </div>

        {% if error %}
            <div class="alert-error">
                <i class="fa fa-exclamation-circle"></i>
                <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            </div>
        {% endif %}

        <div style="display: flex; gap: 12px;">
            <a href="{{ path('connect_google_start') }}" class="btn-google" style="flex:1" data-turbo="false">
                <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google"> Google
            </a>
            <button type="button" id="btn-face-login" class="btn-google" style="flex:1">
                <i class="fa fa-user-shield" style="color:#20b2aa"></i> Face ID
            </button>
        </div>

        <div class="divider"><span>ou email</span></div>

        <form method="post" id="login-form">
            <div class="field-group">
                <label class="field-label">Email</label>
                <div class="field-input-wrap">
                    <i class="fa fa-envelope field-icon"></i>
                    <input type="text" name="_username" value="{{ last_username }}" class="field-input" placeholder="nom@exemple.com">
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">Mot de passe</label>
                <div class="field-input-wrap">
                    <i class="fa fa-lock field-icon"></i>
                    <input type="password" name="_password" id="password" class="field-input" placeholder="••••••••">
                    <button type="button" class="eye-btn" id="toggle-pwd"><i class="fa fa-eye" id="eye-icon"></i></button>
                </div>
            </div>

            <div class="remember-row">
                <label class="remember-label"><input type="checkbox" name="_remember_me"> Rester connecté</label>
                <a href="{{ path('app_forgot_password_request') }}" class="forgot-link">Oublié ?</a>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-submit" id="submit-btn">
                <span class="btn-label">Se connecter</span>
                <span class="spinner"></span>
            </button>
        </form>

        <div class="register-teaser">
            Nouveau ici ? <a href="{{ path('app_register') }}">Créer un compte</a>
        </div>
    </div>
</main>

<div id="face-modal" style="display:none; position:fixed; inset:0; background:rgba(7,14,23,0.95); z-index:1000; align-items:center; justify-content:center; backdrop-filter:blur(10px);">
    <div style="background:rgba(13,25,42,0.9); border:1px solid rgba(32,178,170,0.3); border-radius:24px; padding:30px; width:90%; max-width:450px; text-align:center;">
        <h3 style="color:#fff; margin-bottom:20px;">Scan Facial Nexus</h3>
        <div style="position:relative; width:100%; height:300px; background:#000; border-radius:15px; overflow:hidden; margin-bottom:20px;">
            <video id="face-video" autoplay muted style="width:100%; height:100%; object-fit:cover; transform:scaleX(-1);"></video>
            <div id="face-status" style="position:absolute; bottom:10px; left:0; right:0; color:#20b2aa; font-size:0.8rem; background:rgba(0,0,0,0.5); padding:5px;">Initialisation...</div>
        </div>
        <button type="button" id="btn-close-face" class="btn-google">Annuler</button>
    </div>
</div>

<script src="{{ asset('face-api.min.js') }}"></script>
<script>
    /* Particles */
    (function(){
        const c = document.getElementById('particles');
        for(let i=0;i<20;i++){
            const p = document.createElement('div'); p.className = 'particle';
            p.style.cssText = `left:${Math.random()*100}%;width:${Math.random()*3+1}px;height:${Math.random()*3+1}px;opacity:${Math.random()*.5+.2};animation-duration:${Math.random()*12+8}s;animation-delay:${Math.random()*10}s`;
            c.appendChild(p);
        }
    })();

    /* Toggle Password */
    const pwd = document.getElementById('password');
    const eyeIcon = document.getElementById('eye-icon');
    document.getElementById('toggle-pwd').addEventListener('click', () => {
        if(pwd.type === 'password'){
            pwd.type = 'text'; eyeIcon.className = 'fa fa-eye-slash';
        } else {
            pwd.type = 'password'; eyeIcon.className = 'fa fa-eye';
        }
    });

    /* Submit Loader */
    document.getElementById('login-form').addEventListener('submit', () => {
        document.getElementById('submit-btn').classList.add('loading');
    });

    /* Face Recognition Logic */
    const faceModal = document.getElementById('face-modal');
    const faceVideo = document.getElementById('face-video');
    const faceStatus = document.getElementById('face-status');
    let modelsLoaded = false;

    document.getElementById('btn-face-login').addEventListener('click', async () => {
        faceModal.style.display = 'flex';
        if(!modelsLoaded){
            faceStatus.textContent = "Chargement de l'IA...";
            await Promise.all([
                faceapi.nets.ssdMobilenetv1.loadFromUri('/models/face_api'),
                faceapi.nets.faceLandmark68Net.loadFromUri('/models/face_api'),
                faceapi.nets.faceRecognitionNet.loadFromUri('/models/face_api')
            ]);
            modelsLoaded = true;
        }
        navigator.mediaDevices.getUserMedia({ video: {} }).then(stream => {
            faceVideo.srcObject = stream;
            startDetection();
        }).catch(() => alert("Caméra non disponible"));
    });

    async function startDetection(){
        faceStatus.textContent = "Positionnez votre visage...";
        const interval = setInterval(async () => {
            const detection = await faceapi.detectSingleFace(faceVideo).withFaceLandmarks().withFaceDescriptor();
            if(detection){
                faceStatus.textContent = "Visage détecté !";
                clearInterval(interval);
                const res = await fetch("{{ path('app_login_face_check') }}", {
                    method: 'POST', body: JSON.stringify({ descriptor: Array.from(detection.descriptor) })
                });
                const data = await res.json();
                if(data.success) window.location.href = data.target;
                else { faceStatus.textContent = data.message; setTimeout(startDetection, 2000); }
            }
        }, 1000);
    }

    document.getElementById('btn-close-face').addEventListener('click', () => {
        if(faceVideo.srcObject) faceVideo.srcObject.getTracks().forEach(t => t.stop());
        faceModal.style.display = 'none';
    });
</script>
{% endblock %}
