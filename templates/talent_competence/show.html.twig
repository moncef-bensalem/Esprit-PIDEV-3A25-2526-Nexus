{% extends 'base.html.twig' %}

{% block title %}Détail Compétence - NEXUS{% endblock %}
{% block page_title %}Compétence du Talent{% endblock %}

{% block content %}
<div class="dashboard-container" style="max-width:800px;">
    <div class="top-bar">
        <h1><i class="fa-solid fa-trophy"></i> Détail Compétence #{{ talent_competence.id }}</h1>
        <div class="top-actions">
            <a href="{{ path('app_talent_competence_index') }}" class="btn"><i class="fa-solid fa-arrow-left"></i> Retour</a>
            <a href="{{ path('app_talent_competence_edit', {'id': talent_competence.id}) }}" class="btn btn-primary"><i class="fa-solid fa-pen"></i> Éditer</a>
        </div>
    </div>

    <div class="detail-card">
        <div class="detail-row">
            <span class="detail-label">Niveau de maîtrise</span>
            <span class="detail-value">{{ talent_competence.niveauMaitrise|capitalize }}</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Années de pratique</span>
            <span class="detail-value">{{ talent_competence.anneesPratique }} ans</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Date d'acquisition</span>
            <span class="detail-value">{{ talent_competence.dateAcquisition ? talent_competence.dateAcquisition|date('d/m/Y') : '—' }}</span>
        </div>
    </div>

    <div style="margin-top:20px;">
        {{ include('talent_competence/_delete_form.html.twig') }}
    </div>
</div>

<style>
.top-bar { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; }
.top-bar h1 { font-size:1.4rem; font-weight:700; color:#fff; display:flex; align-items:center; gap:10px; margin:0; }
.top-actions { display:flex; gap:10px; }
.btn { display:inline-flex; align-items:center; gap:7px; padding:8px 16px; border-radius:9px; font-size:.84rem; font-weight:600; cursor:pointer; text-decoration:none; border:1px solid rgba(32,178,170,.3); background:rgba(32,178,170,.08); color:rgba(32,178,170,.9); transition:all .18s; }
.btn:hover { background:rgba(32,178,170,.18); color:#fff; }
.btn-primary { background:linear-gradient(135deg,#20b2aa,#0288d1); border-color:transparent; color:#fff; }
.btn-primary:hover { opacity:.88; color:#fff; }
.detail-card { background:rgba(13,25,42,.85); border:1px solid rgba(32,178,170,.15); border-radius:16px; overflow:hidden; }
.detail-row { display:flex; justify-content:space-between; align-items:center; padding:16px 20px; border-bottom:1px solid rgba(255,255,255,.05); }
.detail-row:last-child { border-bottom:none; }
.detail-label { font-size:.8rem; text-transform:uppercase; letter-spacing:.8px; color:rgba(32,178,170,.7); font-weight:600; }
.detail-value { color:#fff; font-weight:500; }
</style>
{% endblock %}
