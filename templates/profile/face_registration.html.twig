{% extends 'base.html.twig' %}

{% block title %}Enregistrement Facial — Nexus{% endblock %}

{% block stylesheets %}
<style>
    .face-wrapper {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: radial-gradient(circle at center, #0d192a 0%, #070e17 100%);
        padding: 40px 20px;
    }
    .face-card {
        background: rgba(13,25,42,0.8); backdrop-filter: blur(20px);
        border: 1px solid rgba(32,178,170,0.2); border-radius: 24px;
        width: 100%; max-width: 600px; padding: 40px; text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }
    .video-container {
        position: relative; width: 400px; height: 300px; margin: 0 auto 30px;
        border-radius: 20px; overflow: hidden; border: 2px solid rgba(32,178,170,0.3);
        background: #000;
    }
    #video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    #overlay { position: absolute; top: 0; left: 0; pointer-events: none; transform: scaleX(-1); }

    .status-badge {
        display: inline-block; padding: 8px 16px; border-radius: 30px;
        background: rgba(32,178,170,0.1); border: 1px solid rgba(32,178,170,0.3);
        color: #20b2aa; font-size: 0.85rem; margin-bottom: 20px;
    }
    
    .btn-scan {
        background: linear-gradient(135deg, #20b2aa 0%, #0288d1 100%);
        border: none; border-radius: 12px; color: #fff; padding: 16px 32px;
        font-weight: 600; cursor: pointer; transition: all 0.3s;
        box-shadow: 0 10px 20px rgba(2,136,209,0.3);
    }
    .btn-scan:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-scan:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 15px 30px rgba(2,136,209,0.4); }

    #loading-overlay {
        position: fixed; inset: 0; background: #070e17; z-index: 1000;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .loader {
        width: 48px; height: 48px; border: 5px solid #fff; border-bottom-color: #20b2aa;
        border-radius: 50%; animation: rotation 1s linear infinite; margin-bottom: 20px;
    }
    @keyframes rotation { 0% { transform: rotate(0deg) } 100% { transform: rotate(360deg) } }
</style>
{% endblock %}

{% block body %}
<div id="loading-overlay">
    <div class="loader"></div>
    <div style="color: #fff; font-size: 1.1rem;">Initialisation de l'IA Nexus...</div>
</div>

<div class="face-wrapper">
    <div class="face-card">
        <div class="status-badge" id="status">Chargement des modèles...</div>
        
        <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 10px;">Enregistrement Biométrique</h1>
        <p style="color: rgba(255,255,255,0.5); font-size: 0.9rem; margin-bottom: 30px;">
            Positionnez-vous face à la caméra pour capturer votre empreinte faciale.
        </p>

        <div class="video-container">
            <video id="video" autoplay muted></video>
            <canvas id="overlay"></canvas>
        </div>

        <button id="btn-capture" class="btn-scan" disabled>
            <i class="fa fa-camera"></i> &nbsp;Scanner mon visage
        </button>
        
        <div id="result-msg" style="margin-top: 20px; font-weight: 500;"></div>
        
        <div style="margin-top: 30px;">
            <a href="{{ path('app_home') }}" style="color: rgba(255,255,255,0.3); text-decoration: none; font-size: 0.85rem;">
                <i class="fa fa-arrow-left"></i> Retour au tableau de bord
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('face-api.min.js') }}"></script>
<script>
    const video = document.getElementById('video');
    const status = document.getElementById('status');
    const btnCapture = document.getElementById('btn-capture');
    const loadingOverlay = document.getElementById('loading-overlay');
    const resultMsg = document.getElementById('result-msg');

    // Charger les modèles
    async function init() {
        try {
            await Promise.all([
                faceapi.nets.ssdMobilenetv1.loadFromUri('/models/face_api'),
                faceapi.nets.faceLandmark68Net.loadFromUri('/models/face_api'),
                faceapi.nets.faceRecognitionNet.loadFromUri('/models/face_api')
            ]);
            status.textContent = 'IA Prête - Caméra en cours...';
            startVideo();
        } catch (err) {
            console.error(err);
            status.textContent = 'Erreur lors du chargement de l\'IA';
        }
    }

    function startVideo() {
        navigator.mediaDevices.getUserMedia({ video: {} })
            .then(stream => {
                video.srcObject = stream;
                status.textContent = 'Caméra active';
                btnCapture.disabled = false;
                loadingOverlay.style.display = 'none';
            })
            .catch(err => {
                console.error(err);
                status.textContent = 'Accès caméra refusé';
                loadingOverlay.innerHTML = '<div style="color:red">Erreur : Accès caméra impossible.</div>';
            });
    }

    btnCapture.addEventListener('click', async () => {
        btnCapture.disabled = true;
        btnCapture.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Analyse en cours...';
        
        const detection = await faceapi.detectSingleFace(video)
            .withFaceLandmarks()
            .withFaceDescriptor();

        if (!detection) {
            resultMsg.style.color = '#ff8a80';
            resultMsg.textContent = 'Aucun visage détecté. Veuillez bien vous mettre face au capteur.';
            btnCapture.disabled = false;
            btnCapture.innerHTML = '<i class="fa fa-camera"></i> Scanner mon visage';
            return;
        }

        // Envoyer le descripteur au serveur
        const descriptor = Array.from(detection.descriptor);
        
        fetch("{{ path('app_face_registration_save') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ descriptor: descriptor })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                resultMsg.style.color = '#20b2aa';
                resultMsg.textContent = '✓ Empreinte faciale enregistrée avec succès !';
                status.textContent = 'Configuration terminée';
                setTimeout(() => window.location.href = "{{ path('app_home') }}", 2000);
            } else {
                throw new Error(data.message);
            }
        })
        .catch(err => {
            console.error(err);
            resultMsg.style.color = '#ff8a80';
            resultMsg.textContent = 'Erreur lors de la sauvegarde : ' + err.message;
            btnCapture.disabled = false;
        });
    });

    init();
</script>
{% endblock %}
