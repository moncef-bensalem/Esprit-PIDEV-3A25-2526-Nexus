<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Nexus{% endblock %} — Nexus Platform</title>
        <link rel="icon" href="{{ asset('nexus.jpg') }}">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">

        <style>
            :root {
                --sidebar-w: 260px;
                --navbar-h: 64px;
                --bg-deep:  #070e17;
                --bg-card:  rgba(13,25,42,.85);
                --border:   rgba(32,178,170,.2);
                --cyan:     #20b2aa;
                --cyan-dim: rgba(32,178,170,.6);
                --text-muted-custom: rgba(255,255,255,.4);
            }
            *, *::before, *::after { box-sizing: border-box; }
            html, body { min-height: 100%; margin: 0; overflow-x: hidden; }
            body {
                font-family: 'Inter', sans-serif;
                background: var(--bg-deep) !important;
                background-image: none !important;
                color: #fff;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* ── Sidebar ── */
            .nx-sidebar {
                position: fixed;
                top: 0; left: 0;
                width: var(--sidebar-w);
                height: 100vh;
                background: rgba(7,14,23,.95);
                backdrop-filter: blur(20px);
                border-right: 1px solid var(--border);
                display: flex;
                flex-direction: column;
                z-index: 1100;
                overflow-y: auto;
                overflow-x: hidden;
                scrollbar-width: none;
                transition: transform .3s;
            }
            .nx-sidebar::-webkit-scrollbar { display: none; }

            .nx-sidebar-brand {
                display: flex; align-items: center; justify-content: space-between;
                padding: 20px 20px 16px;
                border-bottom: 1px solid var(--border);
                text-decoration: none;
                flex-shrink: 0;
            }
            .nx-sidebar-brand-inner { display: flex; align-items: center; gap: 12px; }
            .nx-sidebar-close {
                display: none; background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer;
            }
            .nx-sidebar-brand img {
                width: 38px; height: 38px; border-radius: 10px;
                border: 1px solid var(--border);
                box-shadow: 0 0 14px rgba(32,178,170,.25);
            }
            .nx-sidebar-brand-text { line-height: 1.2; text-align: left; }
            .nx-sidebar-brand-name { font-size: .95rem; font-weight: 700; color: #fff; }
            .nx-sidebar-brand-sub  { font-size: .68rem; color: var(--cyan); letter-spacing: 1px; text-transform: uppercase; }

            /* Section label */
            .nx-nav-section {
                font-size: .67rem; font-weight: 600; letter-spacing: 1.5px;
                color: rgba(255,255,255,.25); text-transform: uppercase;
                padding: 18px 20px 6px;
            }

            /* Nav item */
            .nx-nav-item {
                display: flex; align-items: center; gap: 11px;
                padding: 10px 16px;
                margin: 1px 8px;
                color: rgba(255,255,255,.45);
                text-decoration: none;
                border-radius: 10px;
                font-size: .84rem; font-weight: 500;
                transition: all .18s ease;
                white-space: nowrap;
                position: relative;
            }
            .nx-nav-item:hover {
                background: rgba(32,178,170,.08);
                color: rgba(255,255,255,.85);
            }
            .nx-nav-item.active {
                background: rgba(32,178,170,.14);
                color: var(--cyan);
                font-weight: 600;
            }
            .nx-nav-item.active::before {
                content: '';
                position: absolute; left: 0; top: 20%; bottom: 20%;
                width: 3px; border-radius: 0 3px 3px 0;
                background: var(--cyan);
                box-shadow: 0 0 8px var(--cyan);
            }
            .nx-nav-item i {
                width: 18px; text-align: center; font-size: .9rem; flex-shrink: 0;
                transition: color .18s;
            }
            .nx-nav-item:hover i, .nx-nav-item.active i { color: var(--cyan); }

            /* Divider */
            .nx-nav-divider {
                height: 1px; background: var(--border);
                margin: 10px 16px;
            }

            /* Sidebar footer (logout) */
            .nx-sidebar-footer {
                margin-top: auto;
                padding: 12px 8px;
                border-top: 1px solid var(--border);
                flex-shrink: 0;
            }

            /* ── Navbar ── */
            .nx-navbar {
                position: fixed;
                top: 0;
                left: var(--sidebar-w);
                right: 0;
                height: var(--navbar-h);
                background: rgba(7,14,23,.9);
                backdrop-filter: blur(16px);
                border-bottom: 1px solid var(--border);
                display: flex; align-items: center; justify-content: space-between;
                padding: 0 28px;
                z-index: 1050;
                transition: left .3s;
            }

            .nx-navbar-left { display: flex; align-items: center; gap: 16px; }
            .nx-sidebar-toggle {
                display: none; background: none; border: none; color: #fff; font-size: 1.25rem;
                cursor: pointer; padding: 4px;
            }
            .nx-breadcrumb { font-size: .83rem; color: rgba(255,255,255,.4); }
            .nx-breadcrumb strong { color: rgba(255,255,255,.85); font-weight: 600; }

            /* Live badge */
            .nx-live-badge {
                display: flex; align-items: center; gap: 6px;
                font-size: .73rem; color: var(--cyan);
                background: rgba(32,178,170,.1); border: 1px solid rgba(32,178,170,.25);
                padding: 3px 10px; border-radius: 20px;
            }
            .nx-live-dot {
                width: 6px; height: 6px; border-radius: 50%;
                background: var(--cyan);
                animation: blink 1.5s ease-in-out infinite;
            }
            @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

            /* Profile dropdown */
            .nx-profile-wrap { position: relative; }
            .nx-profile-btn {
                display: flex; align-items: center; gap: 10px;
                background: rgba(255,255,255,.05);
                border: 1px solid rgba(255,255,255,.1);
                border-radius: 40px;
                padding: 5px 14px 5px 5px;
                cursor: pointer; transition: all .2s; outline: none;
                color: #fff;
            }
            .nx-profile-btn:hover {
                background: rgba(32,178,170,.1);
                border-color: rgba(32,178,170,.3);
            }
            .nx-avatar {
                width: 34px; height: 34px; border-radius: 50%;
                background: linear-gradient(135deg, #20b2aa, #0288d1);
                display: flex; align-items: center; justify-content: center;
                font-weight: 700; font-size: .85rem; color: #fff;
                flex-shrink: 0;
                box-shadow: 0 0 10px rgba(32,178,170,.3);
            }
            .nx-profile-name { font-size: .84rem; font-weight: 600; max-width: 120px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
            .nx-profile-role { font-size: .7rem; color: var(--cyan); text-align: left; }
            .nx-profile-text { display: flex; flex-direction: column; align-items: flex-start; }
            @media (max-width: 480px) { .nx-profile-text { display: none; } }
            .nx-profile-caret { font-size: .7rem; color: rgba(255,255,255,.4); margin-left: 2px; transition: transform .2s; }
            .nx-profile-wrap.open .nx-profile-caret { transform: rotate(180deg); }

            /* Dropdown menu */
            .nx-dropdown {
                position: absolute; top: calc(100% + 10px); right: 0;
                min-width: 200px;
                background: rgba(13,25,42,.98);
                backdrop-filter: blur(20px);
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 8px;
                box-shadow: 0 20px 50px rgba(0,0,0,.5);
                opacity: 0; transform: translateY(-8px) scale(.97);
                pointer-events: none;
                transition: all .2s ease;
                z-index: 2000;
            }
            .nx-profile-wrap.open .nx-dropdown {
                opacity: 1; transform: translateY(0) scale(1);
                pointer-events: all;
            }
            .nx-dropdown-header {
                padding: 10px 12px 8px;
                border-bottom: 1px solid rgba(32,178,170,.15);
                margin-bottom: 6px;
            }
            .nx-dropdown-name { font-size: .88rem; font-weight: 600; color: #fff; }
            .nx-dropdown-email { font-size: .75rem; color: rgba(255,255,255,.35); }
            .nx-dropdown-item {
                display: flex; align-items: center; gap: 10px;
                padding: 9px 12px;
                border-radius: 9px;
                color: rgba(255,255,255,.7);
                text-decoration: none;
                font-size: .84rem;
                transition: all .15s;
            }
            .nx-dropdown-item:hover { background: rgba(32,178,170,.1); color: #fff; }
            .nx-dropdown-item i { width: 16px; text-align: center; color: rgba(32,178,170,.7); }
            .nx-dropdown-item.danger { color: rgba(239,83,80,.8); }
            .nx-dropdown-item.danger i { color: rgba(239,83,80,.7); }
            .nx-dropdown-item.danger:hover { background: rgba(239,83,80,.1); color: #ef5350; }
            .nx-dropdown-divider { height: 1px; background: rgba(32,178,170,.1); margin: 6px 0; }

            /* ── Main layout ── */
            .nx-main {
                margin-left: var(--sidebar-w);
                margin-top: var(--navbar-h);
                padding: 28px 32px;
                flex: 1;
                width: calc(100% - var(--sidebar-w));
                max-width: 100%;
                min-height: calc(100vh - var(--navbar-h));
                transition: margin-left .3s;
            }

            /* ── Footer ── */
            .nx-footer {
                margin-left: var(--sidebar-w);
                background: rgba(7,14,23,.8);
                border-top: 1px solid var(--border);
                padding: 14px 32px;
                display: flex; align-items: center; justify-content: space-between;
                font-size: .78rem; color: rgba(255,255,255,.25);
                flex-shrink: 0;
                transition: margin-left .3s;
            }
            .nx-footer a { color: var(--cyan); text-decoration: none; opacity: .7; }
            .nx-footer a:hover { opacity: 1; }

            /* ── Responsive ── */
            @media (max-width: 900px) {
                :root { --sidebar-w: 0px; }
                .nx-sidebar-toggle { display: block; }
                .nx-sidebar { transform: translateX(-260px); }
                .nx-sidebar.open { transform: translateX(0); --sidebar-w: 260px; box-shadow: 0 0 50px rgba(0,0,0,0.5); }
                .nx-sidebar.open .nx-sidebar-close { display: block; }
                .nx-navbar { left: 0; padding: 0 16px; }
                .nx-main { margin-left: 0; padding: 20px 16px; }
                .nx-footer { margin-left: 0; flex-direction: column; gap: 8px; text-align: center; }
            }
        </style>

        {% block stylesheets %}
            {# child pages add their own styles here #}
        {% endblock %}

        <script>
            window.__ONESIGNAL_APP_ID__ = '{{ app_onesignal_id ?? '' }}';
        </script>
        <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
    </head>
    <body>

        {% block body %}
            {% if app.user %}

                {# ── AUTHENTICATED: full sidebar + navbar layout ── #}
                {% include '_sidebar.html.twig' %}

                <header class="nx-navbar">
                    <div class="nx-navbar-left">
                        <button class="nx-sidebar-toggle" id="mobileMenuBtn"><i class="fa fa-bars"></i></button>
                        <span class="nx-breadcrumb">
                            <strong>{% block page_title %}Dashboard{% endblock %}</strong>
                        </span>
                        <div class="nx-live-badge">
                            <div class="nx-live-dot"></div> Live
                        </div>
                        <button id="nx-notif-btn" style="display:inline-flex;align-items:center;gap:6px;background:rgba(32,178,170,.12);border:1px solid rgba(32,178,170,.25);color:var(--cyan);border-radius:20px;padding:4px 12px;font-size:.75rem;cursor:pointer;">
                            🔔 Activer les notifications
                        </button>
                    </div>

                    {# ── Translate widget ── #}
                    <div id="nx-translate-widget" style="display:inline-flex;align-items:center;gap:6px;margin-right:8px;">
                        <select id="nx-translate-lang" style="background:rgba(13,25,42,.9);border:1px solid rgba(32,178,170,.3);color:rgba(255,255,255,.7);border-radius:8px;padding:3px 6px;font-size:.72rem;cursor:pointer;outline:none;">
                            <option value="en">🇬🇧 EN</option>
                            <option value="ar">🇹🇳 AR</option>
                            <option value="de">🇩🇪 DE</option>
                            <option value="es">🇪🇸 ES</option>
                            <option value="it">🇮🇹 IT</option>
                            <option value="fr">🇫🇷 FR</option>
                        </select>
                        <button id="nx-translate-btn" title="Traduire la page"
                            style="display:inline-flex;align-items:center;gap:5px;background:rgba(32,178,170,.12);border:1px solid rgba(32,178,170,.25);color:var(--cyan);border-radius:20px;padding:4px 11px;font-size:.73rem;cursor:pointer;transition:all .2s;">
                            <i class="fas fa-language"></i> <span id="nx-translate-label">Traduire</span>
                        </button>
                    </div>

                    <div class="nx-profile-wrap" id="profileWrap">
                        <button class="nx-profile-btn" id="profileBtn" aria-expanded="false">
                            <div class="nx-avatar" id="avatarCircle">
                                {{ app.user.firstName is defined and app.user.firstName ? app.user.firstName|slice(0,1)|upper : app.user.userIdentifier|slice(0,1)|upper }}
                            </div>
                            <div>
                                <div class="nx-profile-name">
                                    {% if app.user.firstName is defined and app.user.firstName %}
                                        {{ app.user.firstName }} {{ app.user.lastName ?? '' }}
                                    {% else %}
                                        {{ app.user.userIdentifier }}
                                    {% endif %}
                                </div>
                                <div class="nx-profile-role">
                                    {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Candidat{% endif %}
                                </div>
                            </div>
                            <i class="fa fa-chevron-down nx-profile-caret"></i>
                        </button>

                        <div class="nx-dropdown" id="profileDropdown">
                            <div class="nx-dropdown-header">
                                <div class="nx-dropdown-name">
                                    {% if app.user.firstName is defined and app.user.firstName %}
                                        {{ app.user.firstName }} {{ app.user.lastName ?? '' }}
                                    {% else %}
                                        {{ app.user.userIdentifier }}
                                    {% endif %}
                                </div>
                                <div class="nx-dropdown-email">{{ app.user.userIdentifier }}</div>
                            </div>

                            {% if is_granted('ROLE_CANDIDATE') %}
                            <a href="{{ path('candidate_profile') }}" class="nx-dropdown-item">
                                <i class="fa fa-user"></i> Mon Profil
                            </a>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin_dashboard') }}" class="nx-dropdown-item">
                                <i class="fa fa-tachometer-alt"></i> Dashboard Admin
                            </a>
                            {% endif %}
                            <div class="nx-dropdown-divider"></div>
                            <a href="{{ path('app_logout') }}" class="nx-dropdown-item danger">
                                <i class="fa fa-sign-out-alt"></i> Se déconnecter
                            </a>
                        </div>
                    </div>
                </header>

                <div class="nx-main">
                    {# ── Flash Messages ── #}
                    {% for msg in app.flashes('success') %}
                        <div style="display:flex;align-items:center;gap:10px;padding:13px 18px;border-radius:12px;margin-bottom:18px;background:rgba(76,175,80,.1);border:1px solid rgba(76,175,80,.25);color:#a5d6a7;font-size:.84rem;animation:fadeIn .3s ease;">
                            <i class="fas fa-check-circle" style="color:#4caf50;font-size:1rem;flex-shrink:0;"></i> {{ msg }}
                        </div>
                    {% endfor %}
                    {% for msg in app.flashes('warning') %}
                        <div style="display:flex;align-items:center;gap:10px;padding:13px 18px;border-radius:12px;margin-bottom:18px;background:rgba(251,192,45,.08);border:1px solid rgba(251,192,45,.25);color:#ffe082;font-size:.84rem;">
                            <i class="fas fa-exclamation-triangle" style="color:#fbc02d;font-size:1rem;flex-shrink:0;"></i> {{ msg }}
                        </div>
                    {% endfor %}
                    {% for msg in app.flashes('error') %}
                        <div style="display:flex;align-items:center;gap:10px;padding:13px 18px;border-radius:12px;margin-bottom:18px;background:rgba(239,83,80,.1);border:1px solid rgba(239,83,80,.25);color:#ef9a9a;font-size:.84rem;">
                            <i class="fas fa-times-circle" style="color:#ef5350;font-size:1rem;flex-shrink:0;"></i> {{ msg }}
                        </div>
                    {% endfor %}
                    {% for msg in app.flashes('info') %}
                        <div style="display:flex;align-items:center;gap:10px;padding:13px 18px;border-radius:12px;margin-bottom:18px;background:rgba(2,136,209,.08);border:1px solid rgba(2,136,209,.25);color:#90caf9;font-size:.84rem;">
                            <i class="fas fa-info-circle" style="color:#0288d1;font-size:1rem;flex-shrink:0;"></i> {{ msg }}
                        </div>
                    {% endfor %}
                    <style>@keyframes fadeIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}</style>

                    {% block content %}{% endblock %}
                </div>

                <footer class="nx-footer">
                    <span>&copy; {{ "now"|date("Y") }} Nexus Platform &mdash; Tous droits réservés</span>
                    <span>
                        Symfony 6.4 &nbsp;&bull;&nbsp;
                        <a href="#">Documentation</a> &nbsp;&bull;&nbsp;
                        <a href="#">Support</a>
                    </span>
                </footer>

            {% else %}

                {# ── GUEST: no sidebar, minimal header ── #}
                <style>
                    .guest-topbar {
                        position: sticky; top: 0; z-index: 100;
                        background: rgba(7,14,23,.95);
                        backdrop-filter: blur(18px);
                        border-bottom: 1px solid rgba(32,178,170,.14);
                        padding: 0 2.5rem;
                        height: 62px;
                        display: flex; align-items: center; justify-content: space-between;
                    }
                    .guest-brand {
                        display: flex; align-items: center; gap: 10px;
                        text-decoration: none; color: #fff;
                        font-weight: 700; font-size: 1rem;
                    }
                    .guest-brand img { width: 30px; height: 30px; border-radius: 8px; }
                    .guest-brand-sub { font-size: .62rem; color: #20b2aa; letter-spacing: 1.2px; text-transform: uppercase; display: block; line-height: 1; }
                    .guest-nav { display: flex; align-items: center; gap: 4px; }
                    .guest-nav-link {
                        display: flex; align-items: center; gap: 6px;
                        padding: 6px 14px; border-radius: 8px;
                        font-size: .83rem; font-weight: 600; color: rgba(255,255,255,.5);
                        text-decoration: none; transition: color .15s, background .15s;
                    }
                    .guest-nav-link:hover { color: #fff; background: rgba(255,255,255,.06); }
                    .guest-nav-link.g-active { color: #20b2aa; background: rgba(32,178,170,.1); }
                    .guest-login-btn {
                        display: flex; align-items: center; gap: 7px;
                        padding: 7px 18px; border-radius: 9px;
                        background: linear-gradient(135deg, #20b2aa, #0288d1);
                        color: #fff; font-size: .82rem; font-weight: 700;
                        text-decoration: none; transition: opacity .15s;
                    }
                    .guest-login-btn:hover { opacity: .88; color: #fff; }
                    .guest-body { padding: 40px 3rem 64px; max-width: 1280px; margin: 0 auto; }
                    .guest-footer {
                        border-top: 1px solid rgba(32,178,170,.1);
                        text-align: center; padding: 20px;
                        font-size: .76rem; color: rgba(255,255,255,.2);
                    }
                </style>

                <nav class="guest-topbar">
                    <a href="{{ path('app_public_offres') }}" class="guest-brand">
                        <img src="{{ asset('nexus.jpg') }}" alt="Nexus">
                        <div>Nexus <span class="guest-brand-sub">Carrières</span></div>
                    </a>
                    <div class="guest-nav">
                        <a href="{{ path('app_public_offres') }}" class="guest-nav-link {{ app.request.attributes.get('_route') == 'app_public_offres' ? 'g-active' : '' }}">
                            <i class="fa fa-briefcase"></i> Offres d'emploi
                        </a>
                        <a href="{{ path('app_public_suivi') }}" class="guest-nav-link {{ app.request.attributes.get('_route') == 'app_public_suivi' ? 'g-active' : '' }}">
                            <i class="fa fa-search"></i> Suivi candidature
                        </a>
                    </div>
                    <a href="{{ path('app_login') }}" class="guest-login-btn">
                        <i class="fa fa-sign-in-alt"></i> Connexion
                    </a>
                </nav>

                <div class="guest-body">
                    {% for msg in app.flashes('error') %}
                        <div style="padding:12px 18px;border-radius:10px;margin-bottom:18px;background:rgba(239,83,80,.1);border:1px solid rgba(239,83,80,.25);color:#ef9a9a;font-size:.84rem;display:flex;align-items:center;gap:8px;">
                            <i class="fa fa-exclamation-circle"></i> {{ msg }}
                        </div>
                    {% endfor %}
                    {% for msg in app.flashes('success') %}
                        <div style="padding:12px 18px;border-radius:10px;margin-bottom:18px;background:rgba(76,175,80,.1);border:1px solid rgba(76,175,80,.25);color:#a5d6a7;font-size:.84rem;display:flex;align-items:center;gap:8px;">
                            <i class="fa fa-check-circle"></i> {{ msg }}
                        </div>
                    {% endfor %}
                    {{ block('content') }}
                </div>

                <footer class="guest-footer">
                    &copy; {{ "now"|date("Y") }} Nexus Platform &mdash; Tous droits réservés
                </footer>

            {% endif %}
        {% endblock %}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        {# Profile dropdown toggle #}
        <script>
        (function(){
            const wrap = document.getElementById('profileWrap');
            const btn  = document.getElementById('profileBtn');
            if(!wrap || !btn) return;
            btn.addEventListener('click', function(e){
                e.stopPropagation();
                const open = wrap.classList.toggle('open');
                btn.setAttribute('aria-expanded', open);
            });
            document.addEventListener('click', function(){ wrap.classList.remove('open'); });
        })();
        (function(){
            const sb = document.getElementById('nxSidebar');
            const btn = document.getElementById('mobileMenuBtn');
            const closeBtn = document.getElementById('mobileMenuClose');
            if(btn && sb) {
                btn.addEventListener('click', () => sb.classList.add('open'));
            }
            if(closeBtn && sb) {
                closeBtn.addEventListener('click', () => sb.classList.remove('open'));
            }
        })();
        </script>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# ── In-page translation widget ── #}
        <script>
        (function () {
            const btn      = document.getElementById('nx-translate-btn');
            const langSel  = document.getElementById('nx-translate-lang');
            const label    = document.getElementById('nx-translate-label');
            if (!btn || !langSel) return;

            const BATCH_URL  = '{{ path('translation_batch') }}';
            const SELECTORS  = 'h1,h2,h3,h4,h5,p,td,th,li,label,.card-title,.badge,.fw-bold,.fw-semibold';
            const SKIP_IDS   = new Set(['nx-translate-btn','nx-translate-label','nx-translate-lang','nx-notif-btn']);

            let translated = false;
            let originals  = [];   // [{node, text}]

            btn.addEventListener('click', async () => {
                if (translated) {
                    restore();
                    return;
                }
                const targetLang = langSel.value;
                if (targetLang === 'fr') return;  // already in French
                await translatePage(targetLang);
            });

            async function translatePage(targetLang) {
                btn.disabled = true;
                label.textContent = '…';

                const main = document.querySelector('.nx-main') || document.body;
                const nodes = collectTextNodes(main);

                if (!nodes.length) { btn.disabled = false; label.textContent = 'Traduire'; return; }

                const texts = nodes.map(n => n.textContent.trim());

                try {
                    const res = await fetch(BATCH_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ texts, target_lang: targetLang, source_lang: 'fr' }),
                    });
                    const data = await res.json();
                    const results = data.translated || [];

                    originals = [];
                    nodes.forEach((node, i) => {
                        if (results[i] && results[i] !== texts[i]) {
                            originals.push({ node, text: node.textContent });
                            node.textContent = results[i];
                        }
                    });

                    translated = true;
                    label.textContent = '↩ Restaurer';
                    btn.style.background = 'rgba(239,83,80,.15)';
                    btn.style.borderColor = 'rgba(239,83,80,.4)';
                    btn.style.color = '#ef9a9a';
                } catch (e) {
                    label.textContent = 'Erreur';
                } finally {
                    btn.disabled = false;
                }
            }

            function restore() {
                originals.forEach(({ node, text }) => { node.textContent = text; });
                originals = [];
                translated = false;
                label.textContent = 'Traduire';
                btn.style.background = '';
                btn.style.borderColor = '';
                btn.style.color = '';
            }

            function collectTextNodes(root) {
                const result = [];
                const elements = root.querySelectorAll(SELECTORS);
                elements.forEach(el => {
                    if (SKIP_IDS.has(el.id)) return;
                    if (el.closest('#nx-translate-widget')) return;
                    if (el.closest('.nx-sidebar')) return;
                    if (el.closest('.nx-navbar')) return;
                    // Only leaf-level: skip elements that contain other block elements
                    const hasBlockChild = [...el.children].some(c =>
                        ['H1','H2','H3','H4','H5','P','UL','OL','TABLE','DIV'].includes(c.tagName)
                    );
                    if (hasBlockChild) return;
                    const text = el.textContent.trim();
                    if (text.length < 3) return;
                    result.push(el);
                });
                return result;
            }
        })();
        </script>

        <script src="{{ asset('onesignal-init.js') }}"></script>
    </body>
</html>
